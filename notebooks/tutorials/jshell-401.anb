    {
      "id": "jshell-401-records",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: records-java-16\n//@ description: Records (Java 16)\n// --- Records (Java 16) ---\n// One line of declaration gives you: private final fields, a canonical constructor,\n// an accessor per component, and equals/hashCode/toString. A record is implicitly\n// final and its fields cannot be reassigned - it is a data carrier, not a bean.\n\nrecord Point(double x, double y) {\n    // Records can hold ordinary methods. They just cannot add mutable state.\n    double distanceTo(Point other) {\n        double dx = this.x - other.x;\n        double dy = this.y - other.y;\n        return Math.sqrt(dx * dx + dy * dy);      // Pythagoras\n    }\n\n    // A COMPACT constructor: no parameter list, no assignments. It runs before the\n    // generated constructor stores the fields, which makes it the place for\n    // validation (or for normalising a parameter by reassigning it).\n    //\n    // The `public` matters HERE specifically: JShell compiles each snippet into a\n    // wrapper class where the record is public, and Java forbids a constructor from\n    // being less accessible than its record. In a normal .java file you could leave\n    // it off.\n    public Point {\n        if (Double.isNaN(x) || Double.isNaN(y))\n            throw new IllegalArgumentException(\"Coordinates cannot be NaN\");\n    }\n}\n\nrecord Person(String name, int age, String email) {}   // no body needed at all\n\nPoint p1 = new Point(0, 0);\nPoint p2 = new Point(3, 4);\n\nSystem.out.println(\"p1 = \" + p1);      // generated toString: Point[x=0.0, y=0.0]\nSystem.out.println(\"p2 = \" + p2);\n// The accessor is named after the component - x(), not getX().\nSystem.out.println(\"x of p2 = \" + p2.x());\nSystem.out.printf(\"distance p1 to p2 = %.2f%n\", p1.distanceTo(p2));  // 5.0\n\nPerson alice  = new Person(\"Alice\", 30, \"alice@example.com\");\nPerson alice2 = new Person(\"Alice\", 30, \"alice@example.com\");\nSystem.out.println(\"alice = \" + alice);\n// Two separate objects, but equals() compares COMPONENTS, so this is true. With a\n// plain class you would get false unless you wrote equals() yourself.\nSystem.out.println(\"alice.equals(alice2) = \" + alice.equals(alice2));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
