    {
      "id": "jshell-401-textblocks",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: text-blocks-java-15\n//@ description: Text Blocks (Java 15)\n// --- Text Blocks (Java 15) ---\n// A text block opens with three quotes followed by a line break, and closes with\n// three more. Real line breaks replace \\n, and quotes need no escaping.\n\n// The old way: every newline and every quote escaped by hand.\nString jsonOld = \"{\\n  \\\"name\\\": \\\"Alice\\\",\\n  \\\"age\\\": 30\\n}\";\n\n// The same value as a text block. The compiler works out the common indentation -\n// measured against the closing \"\"\" - and strips it, so the leading spaces here are\n// layout in the source, not part of the string.\nString jsonNew = \"\"\"\n        {\n          \"name\": \"Alice\",\n          \"age\": 30\n        }\n        \"\"\";\n\nSystem.out.println(\"JSON (old):\");\nSystem.out.println(jsonOld);\nSystem.out.println(\"JSON (new):\");\nSystem.out.println(jsonNew);\n\n// This is where text blocks earn their keep: embedded languages stay readable and\n// diff cleanly, because the source looks exactly like the output.\nString sql = \"\"\"\n        SELECT u.name, u.email, COUNT(o.id) AS order_count\n        FROM users u\n        LEFT JOIN orders o ON o.user_id = u.id\n        WHERE u.active = TRUE\n        GROUP BY u.id\n        ORDER BY order_count DESC\n        LIMIT 10\n        \"\"\";\nSystem.out.println(\"SQL query:\");\nSystem.out.println(sql);\n\n// A text block IS a String, so every String method applies. formatted() is\n// String.format() called on the template itself - %s and %d are filled in below.\nString greeting = \"\"\"\n        Hello, %s!\n        You have %d new messages.\n        \"\"\".formatted(\"Arima\", 5);\nSystem.out.print(greeting);   // print, not println: the block already ends in a newline",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "text-blocks-java-15",
