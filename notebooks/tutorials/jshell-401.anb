    {
      "id": "jshell-401-switch",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: switch-expressions-java-14\n//@ description: Switch Expressions (Java 14)\n// --- Switch Expressions (Java 14) ---\n// The arrow form fixes the two classic problems with switch: it produces a VALUE,\n// and each branch stands alone - no break, and no accidental fall-through.\n\nenum Season { SPRING, SUMMER, AUTUMN, WINTER }\n\nSeason season = Season.AUTUMN;\n\n// Note the semicolon at the end: this is one expression assigned to a variable.\nString description = switch (season) {\n    case SPRING -> \"Warm and rainy\";\n    case SUMMER -> \"Hot and sunny\";\n    case AUTUMN -> \"Cool and windy\";\n    case WINTER -> \"Cold and snowy\";\n};\n// No default is needed because every enum constant is covered. Add a fifth constant\n// to Season later and this switch stops compiling - which is exactly what you want.\nSystem.out.println(season + \" : \" + description);\n\nint numLetters = switch (season) {\n    case SPRING, SUMMER -> 6;      // several labels share one branch\n    case AUTUMN -> {\n        // A branch that needs statements uses a block, and `yield` supplies its value.\n        // (`return` would try to leave the enclosing method instead.)\n        System.out.println(\"  (computing autumn letters...)\");\n        yield 6;\n    }\n    case WINTER -> 6;\n};\nSystem.out.println(\"Letters in '\" + season + \"': \" + numLetters);\n\n// Switching on a String works too. Here `default` IS required, since the compiler\n// cannot enumerate every possible String.\nString command = \"start\";\nString result = switch (command.toLowerCase()) {\n    case \"start\", \"run\", \"go\" -> \"Executing...\";\n    case \"stop\", \"halt\"       -> \"Stopping...\";\n    case \"help\"               -> \"Showing help\";\n    default                   -> \"Unknown command: \" + command;\n};\nSystem.out.println(\"Command '\" + command + \"' -> \" + result);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "switch-expressions-java-14",
      "dependsOn": [],
