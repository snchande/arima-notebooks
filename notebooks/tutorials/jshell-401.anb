    {
      "id": "jshell-401-local-types",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: var-local-records-and-local-interfaces\n//@ description: var, local records, and local interfaces\n// --- var, local records, and local interfaces ---\n// `var` is compile-time inference, not dynamic typing: the variable has a real\n// static type, you simply did not have to spell it out. It works only where the\n// compiler can see the type - on a local variable with an initialiser.\n\n// The payoff grows with the type: this would otherwise be written twice, in full.\nvar map = new java.util.HashMap<String, java.util.List<Integer>>();\nmap.put(\"evens\", java.util.List.of(2, 4, 6, 8, 10));\nmap.put(\"odds\",  java.util.List.of(1, 3, 5, 7, 9));\n\nfor (var entry : map.entrySet()) {          // inferred: Map.Entry<String, List<Integer>>\n    var key  = entry.getKey();              // inferred: String\n    var vals = entry.getValue();            // inferred: List<Integer>\n    // i -> i is an identity lambda that also unboxes each Integer to an int.\n    System.out.printf(\"%-6s: sum = %d%n\", key, vals.stream().mapToInt(i->i).sum());\n}\n\n// A record declared right where it is used - the tidy answer to \"this method needs\n// to return three values\" that does not require a class file of its own.\nrecord Stat(double min, double max, double avg) {}\n\nStat computeStats(java.util.List<Double> data) {\n    // summaryStatistics() walks the data ONCE and collects count, sum, min, max and\n    // average together - cheaper than four separate passes.\n    var stats = data.stream()\n        .mapToDouble(Double::doubleValue)\n        .summaryStatistics();\n    return new Stat(stats.getMin(), stats.getMax(), stats.getAverage());\n}\n\nvar data = java.util.List.of(14.5, 88.1, 3.0, 55.7, 42.2, 99.9, 27.6);\nvar s = computeStats(data);\nSystem.out.printf(\"%nData stats: min=%.1f  max=%.1f  avg=%.2f%n\", s.min(), s.max(), s.avg());",
      "output": "",
      "returnValue": null,
