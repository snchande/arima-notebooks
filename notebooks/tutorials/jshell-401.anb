    {
      "id": "jshell-401-instanceof",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: pattern-matching-instanceof-java-16\n//@ description: Pattern Matching instanceof (Java 16)\n// --- Pattern Matching instanceof (Java 16) ---\n// Testing a type and then casting to it said the same thing twice, and the cast\n// could drift out of step with the test. The pattern form does both at once.\n\n// Four values typed as Object - the situation you land in when parsing JSON,\n// reading a heterogeneous collection, or crossing an untyped API boundary.\nObject obj1 = \"Hello, pattern matching!\";\nObject obj2 = 42;                          // autoboxed to Integer\nObject obj3 = 3.14;                        // autoboxed to Double\nObject obj4 = java.util.List.of(1, 2, 3);\n\nvoid describeObject(Object obj) {\n    // The old shape, for comparison:\n    //   if (obj instanceof String) { String s = (String) obj; ... }\n\n    // `obj instanceof String s` tests AND declares. `s` exists only where the test\n    // is known to have passed - inside this branch - so it can never be the wrong type.\n    if (obj instanceof String s) {\n        System.out.println(\"String of length \" + s.length() + \": \" + s.toUpperCase());\n    } else if (obj instanceof Integer i) {\n        System.out.println(\"Integer, doubled: \" + (i * 2));    // i unboxes to int here\n    } else if (obj instanceof Double d) {\n        System.out.printf(\"Double, formatted: %.4f%n\", d);\n    } else if (obj instanceof java.util.List<?> list) {\n        // <?> means \"a List of something unknown\" - all that is needed to call size().\n        System.out.println(\"List with \" + list.size() + \" elements: \" + list);\n    } else {\n        System.out.println(\"Unknown type: \" + obj.getClass().getSimpleName());\n    }\n}\n\ndescribeObject(obj1);\ndescribeObject(obj2);\ndescribeObject(obj3);\ndescribeObject(obj4);\n\n// The binding is usable immediately, in the rest of the same condition: && only\n// evaluates its right side when the left side was true, so s is guaranteed to exist.\nObject maybeString = \"Arima\";\nif (maybeString instanceof String s && s.length() > 3) {\n    System.out.println(\"Long string: \" + s);\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "pattern-matching-instanceof-java-16",
