    {
      "id": "jshell-401-sealed",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: sealed-classes-java-17\n//@ description: Sealed Classes (Java 17)\n// --- Sealed Classes (Java 17) ---\n// `sealed` names the complete list of permitted subtypes. That closed set is what\n// lets the compiler verify a switch has covered everything.\n\n// A note on the names: Arima pre-imports org.knowm.xchart.style.markers.* into every\n// JShell session, and that package already owns the names Circle and Rectangle. A\n// permits clause is resolved BEFORE these records are declared, so writing\n// `permits Circle, Rectangle` would name XChart's marker classes and fail with\n// \"cannot extend a sealed class in a different package\". Hence Disc and Box.\n// It is a useful reflex: in a REPL with libraries pre-imported, your type names\n// share a namespace with theirs.\n\nsealed interface Shape permits Disc, Box, Triangle {}\n\n// Records make ideal implementations: immutable, and their components read cleanly\n// in the patterns below.\nrecord Disc(double radius)             implements Shape {}   // a circle\nrecord Box(double w, double h)         implements Shape {}   // a rectangle\nrecord Triangle(double base, double h) implements Shape {}\n\ndouble area(Shape shape) {\n    // No `default` branch. The compiler knows Shape has exactly three subtypes and\n    // that all three appear here. Add a fourth to the permits clause and every such\n    // switch becomes a compile error - the bug is found at build time, not in production.\n    return switch (shape) {\n        case Disc d     -> Math.PI * d.radius() * d.radius();\n        case Box b      -> b.w() * b.h();\n        case Triangle t -> 0.5 * t.base() * t.h();\n    };\n}\n\nString describe(Shape shape) {\n    return switch (shape) {\n        // formatted() is String.format() written the other way round, which keeps the\n        // template and its arguments next to each other.\n        case Disc d     -> \"Disc with radius %.2f\".formatted(d.radius());\n        case Box b      -> \"Box %.1f x %.1f\".formatted(b.w(), b.h());\n        case Triangle t -> \"Triangle base %.1f, height %.1f\".formatted(t.base(), t.h());\n    };\n}\n\n// The explicit <Shape> type argument is what makes this a List<Shape> rather than a\n// List of some common supertype the compiler would otherwise infer.\nvar shapes = java.util.List.<Shape>of(\n    new Disc(5),\n    new Box(4, 7),\n    new Triangle(6, 3)\n);\n\nSystem.out.println(\"=== Shape Report ===\");\nfor (Shape s : shapes) {\n    System.out.printf(\"%-35s  area = %.2f%n\", describe(s), area(s));\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "sealed-classes-java-17",
