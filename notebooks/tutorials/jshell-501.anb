    {
      "id": "jshell-501-parallel",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: parallel-streams\n//@ description: Parallel Streams\nimport java.util.stream.*;\nimport java.util.List;\nimport java.util.concurrent.atomic.AtomicInteger;\n\n// --- Parallel Streams ---\n// .parallel() splits the stream across the common ForkJoinPool, so the work runs on\n// several cores. The pipeline you write does not change at all - which is precisely\n// why it is easy to reach for it when it will not help.\n//\n// Worth it when:\n//   - the data set is large (tens of thousands of elements and up)\n//   - per-element work is CPU-bound\n//   - each element is independent, with no shared mutable state\n// Not worth it when:\n//   - the collection is small - splitting and merging costs more than it saves\n//   - the work is I/O-bound (a thread pool sized to your cores is the wrong tool)\n//   - the operation has side effects, or encounter order matters\n\nlong n = 1_000_000L;\n\n// Sequential baseline. rangeClosed includes the endpoint; asDoubleStream converts\n// so that Math::sqrt applies.\nlong t0 = System.currentTimeMillis();\ndouble seqSum = LongStream.rangeClosed(1, n)\n    .asDoubleStream()\n    .map(Math::sqrt)\n    .sum();\nlong seqMs = System.currentTimeMillis() - t0;\n\nlong t1 = System.currentTimeMillis();\ndouble parSum = LongStream.rangeClosed(1, n)\n    .parallel()              // the only difference between the two pipelines\n    .asDoubleStream()\n    .map(Math::sqrt)\n    .sum();\nlong parMs = System.currentTimeMillis() - t1;\n\nSystem.out.printf(\"Sequential sum: %.2f  in %d ms%n\", seqSum, seqMs);\nSystem.out.printf(\"Parallel   sum: %.2f  in %d ms%n\", parSum, parMs);\n// The totals are compared with a tolerance rather than ==: parallel execution adds\n// the values in a different order, and floating-point addition is not associative.\nSystem.out.printf(\"Results match: %b%n\", Math.abs(seqSum - parSum) < 0.001);\n\n// The trap: forEach on a parallel stream runs on many threads at once. A plain int++\n// would lose updates. AtomicInteger makes the increment safe, but the real fix is\n// not to accumulate into shared state at all - use count()/reduce()/collect(), which\n// give each thread its own partial result and merge them.\nAtomicInteger safeCount = new AtomicInteger(0);\nList.of(1,2,3,4,5,6,7,8).parallelStream()\n    .filter(i -> i % 2 == 0)\n    .forEach(i -> safeCount.incrementAndGet());\nSystem.out.println(\"Even count (AtomicInteger): \" + safeCount.get());",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "parallel-streams",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Parallel Streams"
    },
    {
      "id": "jshell-501-pipeline-setup",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: building-the-data-model-and-sample-data\n//@ description: Building the data model and sample data\nimport java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\n// --- Building the data model and sample data ---\n// Scenario: an online retailer's daily sales log. The next two cells build a full\n// analysis on top of this one, so the model comes first.\n\nrecord SaleRecord(\n    String region,\n    String product,\n    int    quantity,\n    double unitPrice,\n    String date\n) {\n    // A DERIVED value, computed on demand rather than stored. Keeping it as a method\n    // means revenue can never drift out of step with quantity and unitPrice.\n    double revenue() { return quantity * unitPrice; }\n}\n\n// Stand-in for parsed CSV rows: 12 records over 3 days, 4 regions, 3 products.\nList<SaleRecord> salesLog = List.of(\n    new SaleRecord(\"North\", \"Widget A\",  50, 9.99,  \"2026-03-01\"),\n    new SaleRecord(\"South\", \"Gadget B\",  30, 24.99, \"2026-03-01\"),\n    new SaleRecord(\"East\",  \"Widget A\",  80, 9.99,  \"2026-03-01\"),\n    new SaleRecord(\"West\",  \"Doohickey\", 10, 4.50,  \"2026-03-01\"),\n    new SaleRecord(\"North\", \"Gadget B\",  20, 24.99, \"2026-03-02\"),\n    new SaleRecord(\"South\", \"Widget A\",  65, 9.99,  \"2026-03-02\"),\n    new SaleRecord(\"East\",  \"Gadget B\",  45, 24.99, \"2026-03-02\"),\n    new SaleRecord(\"West\",  \"Widget A\", 110, 9.99,  \"2026-03-02\"),\n    new SaleRecord(\"North\", \"Doohickey\", 200, 4.50, \"2026-03-03\"),\n    new SaleRecord(\"South\", \"Gadget B\",  15, 24.99, \"2026-03-03\"),\n    new SaleRecord(\"East\",  \"Widget A\",  90, 9.99,  \"2026-03-03\"),\n    new SaleRecord(\"West\",  \"Gadget B\",  55, 24.99, \"2026-03-03\")\n);\n\nSystem.out.println(\"Loaded \" + salesLog.size() + \" sale records.\");\n// mapToDouble drops to a DoubleStream, where sum() exists. %,.2f groups thousands.\nSystem.out.printf(\"Gross revenue (all records): $%,.2f%n\",\n    salesLog.stream().mapToDouble(SaleRecord::revenue).sum());\n// distinct() then sorted() turns 12 rows into the 3 distinct days, in order.\nSystem.out.println(\"Dates: \" + salesLog.stream().map(SaleRecord::date).distinct().sorted().collect(Collectors.toList()));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "building-the-data-model-and-sample-data",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Building the data model and sample data"
    },
    {
      "id": "jshell-501-pipeline-run",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: pipeline-filter-transform-aggregate\n//@ description: Pipeline: filter -> transform -> aggregate\nimport java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\n// --- Pipeline: filter -> transform -> aggregate ---\n// The rules are declared once, as values, then combined at the point of use.\n\nPredicate<SaleRecord> highValue   = r -> r.revenue() >= 500.0;\nPredicate<SaleRecord> isWidget    = r -> r.product().startsWith(\"Widget\");\nPredicate<SaleRecord> northOrEast = r -> r.region().equals(\"North\") || r.region().equals(\"East\");\n\n// 1. Revenue by region. groupingBy with summingDouble aggregates each group as it\n// goes, so the result is Map<String, Double> - never a map of lists to sum later.\nSystem.out.println(\"=== Revenue by Region ===\");\nsalesLog.stream()\n    .collect(Collectors.groupingBy(SaleRecord::region,\n             Collectors.summingDouble(SaleRecord::revenue)))\n    .entrySet().stream()                    // stream the finished map to order it\n    .sorted(Map.Entry.<String,Double>comparingByValue().reversed())   // biggest first\n    .forEach(e -> System.out.printf(\"  %-6s  $%,8.2f%n\", e.getKey(), e.getValue()));\n\n// 2. Same shape, different key and different aggregate: units instead of money.\nSystem.out.println(\"\\n=== Products by Units Sold ===\");\nsalesLog.stream()\n    .collect(Collectors.groupingBy(SaleRecord::product,\n             Collectors.summingInt(SaleRecord::quantity)))\n    .entrySet().stream()\n    .sorted(Map.Entry.<String,Integer>comparingByValue().reversed())\n    .forEach(e -> System.out.printf(\"  %-12s  %d units%n\", e.getKey(), e.getValue()));\n\n// 3. Here the three predicates pay off: the query reads as its own description, and\n// each rule remains independently testable.\nSystem.out.println(\"\\n=== High-Value Widget Sales (North/East) ===\");\nsalesLog.stream()\n    .filter(highValue.and(isWidget).and(northOrEast))\n    // comparingDouble builds a Comparator from a key extractor; reversed() sorts\n    // descending without writing (a, b) -> Double.compare(b, a) by hand.\n    .sorted(Comparator.comparingDouble(SaleRecord::revenue).reversed())\n    .forEach(r -> System.out.printf(\"  %-6s %-10s qty=%3d  rev=$%6.2f%n\",\n             r.region(), r.product(), r.quantity(), r.revenue()));\n\n// 4. Grouping by date and sorting by KEY gives a chronological series, which is all\n// a trend line needs.\nSystem.out.println(\"\\n=== Daily Revenue Trend ===\");\nsalesLog.stream()\n    .collect(Collectors.groupingBy(SaleRecord::date,\n             Collectors.summingDouble(SaleRecord::revenue)))\n    .entrySet().stream()\n    .sorted(Map.Entry.comparingByKey())\n    .forEach(e -> {\n        // One block per $100 - a bar chart in plain text, no library involved.\n        int bars = (int)(e.getValue() / 100);\n        System.out.printf(\"  %s  $%,7.2f  %s%n\", e.getKey(), e.getValue(), \"#\".repeat(bars));\n    });",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "pipeline-filter-transform-aggregate",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Pipeline: filter → transform → aggregate"
    },
    {
      "id": "jshell-501-pipeline-report",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: final-composable-report-generator\n//@ description: Final: composable report generator\nimport java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\n// --- Final: composable report generator ---\n// The pattern that ties the notebook together: a section is DATA - a title plus a\n// piece of behaviour - so sections can be stored in a list, reordered, filtered, or\n// added to without touching the code that renders them.\n\n// Runnable is simply \"a function with no arguments and no result\", which is exactly\n// what a report section body is.\nrecord ReportSection(String title, Runnable body) {\n    void print() {\n        System.out.println();\n        // repeat() pads the rule to a fixed width; Math.max guards against a title so\n        // long that the count would go negative and throw.\n        System.out.println(\"== \" + title + \" \" + \"=\".repeat(Math.max(0, 50 - title.length())));\n        body.run();                       // the lambda supplied below runs here\n        System.out.println(\"=\".repeat(54));\n    }\n}\n\nvar sections = List.of(\n    // Each () -> { ... } is a Runnable, capturing salesLog from the enclosing scope.\n    // Nothing inside runs at construction time - only when print() calls body.run().\n    new ReportSection(\"Executive Summary\", () -> {\n        double total   = salesLog.stream().mapToDouble(SaleRecord::revenue).sum();\n        long   records = salesLog.size();\n        double avgRev  = total / records;\n        System.out.printf(\"  Total revenue : $%,.2f%n\", total);\n        System.out.printf(\"  Transactions  : %d%n\", records);\n        System.out.printf(\"  Avg per txn   : $%,.2f%n\", avgRev);\n    }),\n    new ReportSection(\"Best Performing Region\", () -> {\n        salesLog.stream()\n            .collect(Collectors.groupingBy(SaleRecord::region,\n                     Collectors.summingDouble(SaleRecord::revenue)))\n            .entrySet().stream()\n            // max() returns Optional, and ifPresent runs the lambda only when there\n            // is a value - so an empty sales log prints nothing instead of throwing.\n            .max(Map.Entry.comparingByValue())\n            .ifPresent(e -> System.out.printf(\"  %s with $%,.2f%n\", e.getKey(), e.getValue()));\n    }),\n    new ReportSection(\"Best Selling Product\", () -> {\n        salesLog.stream()\n            .collect(Collectors.groupingBy(SaleRecord::product,\n                     Collectors.summingInt(SaleRecord::quantity)))\n            .entrySet().stream()\n            .max(Map.Entry.comparingByValue())\n            .ifPresent(e -> System.out.printf(\"  %s with %d units%n\", e.getKey(), e.getValue()));\n    })\n);\n\nSystem.out.println(\"ARIMA ANALYTICS - SALES REPORT\");\n// ReportSection::print is a method reference of the \"arbitrary instance\" kind:\n// each section in the list becomes the receiver in turn.\nsections.forEach(ReportSection::print);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "final-composable-report-generator",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Final: composable report generator"
    }
