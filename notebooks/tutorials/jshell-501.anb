    {
      "id": "jshell-501-functional-interfaces",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: custom-functional-interface\n//@ description: Custom @FunctionalInterface\nimport java.util.function.*;\n\n// --- Custom @FunctionalInterface ---\n// Any interface with exactly ONE abstract method can be implemented by a lambda.\n// The annotation does not create that ability - it asks the compiler to ENFORCE it,\n// so adding a second abstract method later fails at the interface, not at every\n// lambda that used it.\n\n@FunctionalInterface\ninterface Transformer<A, B> {\n    B transform(A input);                       // the single abstract method\n\n    // Default methods do not count against the one-abstract-method rule, which is how\n    // a functional interface can ship combinators like this one.\n    default Transformer<A, B> withLogging(String label) {\n        // Returns a NEW Transformer wrapping this one - the decorator pattern, in a\n        // single expression. `this` refers to the transformer being decorated.\n        return input -> {\n            B result = this.transform(input);\n            System.out.printf(\"  [%s] %s -> %s%n\", label, input, result);\n            return result;\n        };\n    }\n}\n\n@FunctionalInterface\ninterface Validator<T> {\n    boolean validate(T value);\n\n    // Combining two validators into one. && short-circuits, so `other` is only\n    // consulted when this validator already passed.\n    default Validator<T> and(Validator<T> other) {\n        return v -> this.validate(v) && other.validate(v);\n    }\n}\n\n// Each of these lambdas (or method references) IS an implementation of the interface -\n// no class declaration anywhere.\nTransformer<String, Integer> wordLength = String::length;\nTransformer<String, String> shout = s -> s.toUpperCase() + \"!\";\nValidator<String> notEmpty = s -> !s.isBlank();\nValidator<String> shortEnough = s -> s.length() <= 10;\n\n// Call them through the interface's own method name.\nSystem.out.println(\"wordLength('hello') = \" + wordLength.transform(\"hello\"));\nSystem.out.println(\"shout('hello')       = \" + shout.transform(\"hello\"));\n\n// and() builds a third validator without either original knowing about the other.\nValidator<String> nameValid = notEmpty.and(shortEnough);\nSystem.out.println(\"'Alice' valid   : \" + nameValid.validate(\"Alice\"));\nSystem.out.println(\"'' valid        : \" + nameValid.validate(\"\"));\nSystem.out.println(\"'VeryLongName!!' valid: \" + nameValid.validate(\"VeryLongName!!\"));\n\n// The decorator adds behaviour around the original, which is untouched.\nTransformer<String, Integer> logged = wordLength.withLogging(\"length\");\nlogged.transform(\"Arima\");",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
