{
  "id": "ts-201",
  "name": "TypeScript Intermediate — Generics, Classes, Unions",
  "description": "Generics, classes, modules, union & intersection types — the daily-driver TypeScript toolbox",
  "cells": [
    {
      "id": "ts-201-md-1",
      "type": "MARKDOWN",
      "source": "# TypeScript 201 — The Daily-Driver Toolbox\n\nThis notebook covers the features you reach for every day:\n\n1. **Generics** — write functions and classes that work for many types without losing type safety\n2. **Classes** — including access modifiers and parameter properties\n3. **Union & intersection types** — `A | B` and `A & B`\n4. **Discriminated unions** + exhaustiveness checking\n5. **Type narrowing** with `typeof`, `instanceof`, and `in`\n6. **Utility types** — `Partial`, `Pick`, `Omit`, `ReturnType`",
      "output": "",
      "executed": false
    },
    {
      "id": "ts-201-1",
      "type": "CODE",
      "mode": "typescript",
      "source": "//@ anchor: generic-functions\n//@ description: Generic functions — type-safe identity and pair\n\n// <T> declares a TYPE PARAMETER: a placeholder filled in at each call site.\n// Without it the only honest signature would be (value: any) => any, which\n// throws away the caller's type. A generic keeps the link between input and\n// output, so identity(\"x\") is known to return a string.\nfunction identity<T>(value: T): T { return value; }\n\n// Two independent parameters. The return type [A, B] is a tuple, so the pair\n// keeps each element's own type instead of collapsing to (A | B)[].\nfunction pair<A, B>(a: A, b: B): [A, B] { return [a, b]; }\n\n// The return type `T | null` forces the caller to handle the empty case - the\n// compiler will not let them use the result as a T without checking first.\nfunction firstOrNull<T>(arr: T[]): T | null {\n  return arr.length === 0 ? null : arr[0];\n}\n\nconsole.log(identity<string>(\"barista\"));   // T supplied explicitly\nconsole.log(identity(99));            // T inferred to number\n// Inference works across several parameters at once: A is string, B is number.\nconsole.log(pair(\"answer\", 42));\nconsole.log(firstOrNull<number>([10, 20, 30]));\n// An empty literal gives TypeScript nothing to infer from, so T lands on\n// `never` - a reminder that inference needs evidence.\nconsole.log(firstOrNull([]));",
      "output": "",
      "executed": false,
      "anchor": "generic-functions",
      "description": "Generic functions — type-safe identity and pair"
    },
    {
      "id": "ts-201-2",
      "type": "CODE",
      "mode": "typescript",
      "source": "//@ anchor: generic-classes\n//@ description: A typed Stack<T> with constraints\n\n// A generic class: T is chosen when the stack is constructed, and every method\n// below is typed in terms of it. One implementation, any element type, with no\n// loss of safety at the boundaries.\nclass Stack<T> {\n  // `private` is enforced by the compiler only - at runtime this is an ordinary\n  // property. Use `#items` instead if you want runtime privacy.\n  private items: T[] = [];\n  // `void` says the return value is not meaningful and should not be used.\n  push(item: T): void { this.items.push(item); }\n  // `T | undefined` is the honest signature: popping an empty stack yields\n  // undefined, and the type makes the caller acknowledge that.\n  pop(): T | undefined { return this.items.pop(); }\n  // .at(-1) indexes from the end - cleaner than items[items.length - 1].\n  peek(): T | undefined { return this.items.at(-1); }\n  // A getter, so callers write `stack.size` rather than `stack.size()`.\n  get size(): number { return this.items.length; }\n  // Returning a copy behind `readonly T[]` protects the internal array twice\n  // over: the spread prevents aliasing, and the type prevents mutation.\n  toArray(): readonly T[] { return [...this.items]; }\n}\n\n// Binding T to number here means push(\"x\") would be a compile error.\nconst nums = new Stack<number>();\nnums.push(1); nums.push(2); nums.push(3);\nconsole.log(\"size:\", nums.size, \"peek:\", nums.peek());\nconsole.log(\"popped:\", nums.pop());\nconsole.log(\"after pop:\", nums.toArray().join(\", \"));\n\n// The same class again with T = string; the two instances share no types.\nconst names = new Stack<string>();\nnames.push(\"Alice\");\nnames.push(\"Bob\");\nconsole.log(\"names:\", names.toArray().join(\", \"));",
      "output": "",
      "executed": false,
      "anchor": "generic-classes",
      "description": "A typed Stack<T> with constraints"
    },
    {
      "id": "ts-201-md-2",
      "type": "MARKDOWN",
      "source": "## Union and intersection types\n\n- A **union** `A | B` is *either* type — narrow with `typeof`/`instanceof`/`in`\n- An **intersection** `A & B` is *both* types at once — merges shapes",
      "output": "",
      "executed": false
    },
    {
      "id": "ts-201-3",
      "type": "CODE",
      "mode": "typescript",
      "source": "//@ anchor: unions-intersections\n//@ description: Union narrowing & intersection merging\n\n// The two branches look identical, and that is the lesson: on a union you may\n// only use members that exist on EVERY member of the union. Both string and\n// string[] have .length, so this would compile even without the typeof check -\n// but the check is what would let each branch do something type-specific.\nfunction len(x: string | string[]): number {\n  return typeof x === \"string\" ? x.length : x.length;\n}\n\ninterface Timestamped { createdAt: Date; }\ninterface Tagged      { tags: string[]; }\n\n// An INTERSECTION requires all the parts at once, so a Post must carry title,\n// body, createdAt and tags together. Read `&` as \"and\", `|` as \"or\" - which is\n// the reverse of the set intuition many people bring to it, because a value\n// satisfying more constraints belongs to a SMALLER set of values.\ntype Post = { title: string; body: string } & Timestamped & Tagged;\n\nconst post: Post = {\n  title: \"Hello TS\",\n  body:  \"Intersections merge fields from all parts.\",\n  // Omitting any one of these four fields is a compile error.\n  createdAt: new Date(\"2026-05-10T00:00:00Z\"),\n  tags: [\"typescript\", \"barista\"],\n};\n\nconsole.log(\"len('barista') =\", len(\"barista\"));\nconsole.log(\"len(array) =\", len([\"a\",\"b\",\"c\"]));\nconsole.log(\"post:\", post.title, \"— tags:\", post.tags.join(\", \"));",
      "output": "",
      "executed": false,
      "anchor": "unions-intersections",
      "description": "Union narrowing & intersection merging"
    },
    {
      "id": "ts-201-md-3",
      "type": "MARKDOWN",
      "source": "## Discriminated unions + exhaustiveness\n\nGive every variant in a union a unique tag field, then `switch` on it. TypeScript will refuse to compile if a new variant is added but not handled.",
      "output": "",
      "executed": false
    },
    {
      "id": "ts-201-4",
      "type": "CODE",
      "mode": "typescript",
      "source": "//@ anchor: discriminated-unions\n//@ description: Tagged unions with exhaustiveness check\n\n// Every variant carries a `kind` field with a distinct literal type. That shared\n// tag is the discriminant: once you test it, TypeScript knows precisely which\n// variant you are holding and unlocks that variant's own fields.\ntype Shape =\n  | { kind: \"circle\";    radius: number }\n  | { kind: \"square\";    side:   number }\n  | { kind: \"rectangle\"; width:  number; height: number };\n\nfunction area(s: Shape): number {\n  switch (s.kind) {\n    // Inside this case, `s` is narrowed to the circle variant, so s.radius is\n    // available - and s.side would be an error.\n    case \"circle\":    return Math.PI * s.radius * s.radius;\n    case \"square\":    return s.side * s.side;\n    case \"rectangle\": return s.width * s.height;\n    default: {\n      // With all three cases handled, `s` here has type `never` - the type with\n      // no possible values. Assigning it to a `never` variable therefore\n      // compiles. Add a fourth variant to Shape without a matching case and `s`\n      // becomes that variant, the assignment fails, and the compiler points at\n      // this line. It is a compile-time TODO you cannot forget to do.\n      const _exhaustive: never = s; // forces a compile error if a kind is forgotten\n      throw new Error(\"Unhandled shape: \" + JSON.stringify(_exhaustive));\n    }\n  }\n}\n\nconst shapes: Shape[] = [\n  { kind: \"circle\",    radius: 3 },\n  { kind: \"square\",    side:   4 },\n  { kind: \"rectangle\", width:  5, height: 6 },\n];\n\n// padEnd aligns the output; toFixed(3) rounds to three decimals.\nshapes.forEach(s => console.log(s.kind.padEnd(10), \"area =\", area(s).toFixed(3)));",
      "output": "",
      "executed": false,
      "anchor": "discriminated-unions",
      "description": "Tagged unions with exhaustiveness check"
    },
    {
      "id": "ts-201-md-4",
      "type": "MARKDOWN",
      "source": "## Utility types\n\nTypeScript ships with a small library of *type transformers*: `Partial<T>`, `Required<T>`, `Pick<T,K>`, `Omit<T,K>`, `ReturnType<F>`, etc.",
      "output": "",
      "executed": false
    },
    {
      "id": "ts-201-5",
      "type": "CODE",
      "mode": "typescript",
      "source": "//@ anchor: utility-types\n//@ description: Partial, Pick, Omit, ReturnType\n\ninterface User {\n  id: number;\n  name: string;\n  email: string;\n  passwordHash: string;\n}\n\n// Public-facing User - never expose passwordHash\n// Omit<T, K> rebuilds T without the named keys. Deriving the type instead of\n// hand-writing a second interface means adding a field to User automatically\n// includes it here - the two can never drift apart.\ntype PublicUser = Omit<User, \"passwordHash\">;\n// Pick<T, K> is the mirror image: keep only the named keys.\n\n// PATCH payload - every field optional\n// Partial<T> makes every property optional, which is exactly the shape of a\n// partial update. It is shallow: nested objects are not made optional too.\ntype UserPatch = Partial<User>;\n\n// No return annotation, so TypeScript infers { id: number; label: string }.\nfunction summarize(u: User) {\n  return { id: u.id, label: `${u.name} <${u.email}>` };\n}\n// `typeof summarize` moves from the VALUE world to the TYPE world, yielding the\n// function's type; ReturnType then extracts what it returns. Change the function\n// body and Summary follows along with no edit here.\ntype Summary = ReturnType<typeof summarize>;\n\nconst user: User = {\n  id: 1, name: \"Alice\", email: \"a@example.com\", passwordHash: \"x\"\n};\n\n// Destructuring with a rest element is the idiomatic way to drop a field: pull\n// passwordHash out and `rest` holds everything else - which is precisely a\n// PublicUser. Wrapped in an immediately-invoked arrow so the throwaway\n// `passwordHash` binding does not leak into this scope.\nconst pub: PublicUser = (() => { const { passwordHash, ...rest } = user; return rest; })();\n// Legal because every UserPatch field is optional; supplying just one is fine.\nconst patch: UserPatch = { email: \"new@example.com\" };\nconst s: Summary = summarize(user);\n\nconsole.log(\"public:\", pub);\nconsole.log(\"patch:\",  patch);\nconsole.log(\"summary:\", s);",
      "output": "",
      "executed": false,
      "anchor": "utility-types",
      "description": "Partial, Pick, Omit, ReturnType"
    }
  ],
