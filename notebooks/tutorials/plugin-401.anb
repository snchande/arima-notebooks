{
  "id": "plugin-401",
  "name": "Plugin 401 · Versioning and Iterating",
  "description": "Advanced plugin — what a redeploy actually does, how removed members are cleaned up, and how to iterate without leaving debris behind.",
  "metadata": {
    "category": "tutorial",
    "subcategory": "Plugins",
    "language": "agent",
    "level": 401,
    "kind": "plugin",
    "plugin": {
      "version": "0.2.0",
