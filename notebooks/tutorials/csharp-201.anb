  "cells": [
    {
      "id": "cs201-md-1",
      "type": "MARKDOWN",
      "source": "# C# Data Processing & Pipelines\n\nThis notebook covers:\n- LINQ grouping, aggregation, and joins\n- Working with `Dictionary<K,V>` and nested collections\n- **Pipeline orchestration** using `//@ anchor:` and `//@ depends:` annotations\n\n## How Pipelines Work\n\nAnnotate C# cells just like JShell cells:\n```csharp\n//@ anchor: myStep\n// This cell can be referenced by other cells\n```\n```csharp\n//@ depends: myStep\n// Arima runs myStep first, then this cell\n```\n\nClick **Run with deps** (→ button) or use a **Pipeline cell** to orchestrate multi-cell workflows.",
      "output": "",
      "executed": false
    },
    {
      "id": "cs201-load",
      "type": "CODE",
      "mode": "csharp",
      "anchor": "cs_loadSalesData",
      "source": "//@ anchor: cs_loadSalesData\n//@ description: Step 1: Define data model and load dataset\n// Step 1: define the shape of a row, then load the rows.\n// Naming the record before the data is the habit worth copying: once Sale\n// exists, every later step is checked against it, so a typo like s.Regoin fails\n// to compile instead of quietly producing an empty group.\nrecord Sale(string Region, string Product, int Quarter, decimal Amount, int Units);\n\n// Amounts carry the `m` suffix, making them decimal rather than double. Money\n// summed as double accumulates rounding error; decimal is base 10 and does not.\nvar sales = new List<Sale> {\n    new(\"North\", \"Widget A\", 1, 12400m, 124),\n    new(\"North\", \"Widget B\", 1,  8900m,  89),\n    new(\"South\", \"Widget A\", 1, 11200m, 112),\n    new(\"South\", \"Widget B\", 1,  6300m,  63),\n    new(\"North\", \"Widget A\", 2, 15600m, 156),\n    new(\"North\", \"Widget B\", 2,  9800m,  98),\n    new(\"South\", \"Widget A\", 2, 14100m, 141),\n    new(\"South\", \"Widget B\", 2,  7900m,  79),\n    new(\"North\", \"Widget A\", 3, 13800m, 138),\n    new(\"East\",  \"Widget A\", 3, 10500m, 105),\n    new(\"East\",  \"Widget B\", 3,  5600m,  56),\n    new(\"West\",  \"Widget A\", 3,  9200m,  92),\n};\n\n// `sales` outlives this cell. Cells in one notebook share a session, which is\n// what lets the //@ depends: steps below read it without reloading anything.\nConsole.WriteLine($\"Loaded {sales.Count} sales records\");\nBaristaTable(sales);",
      "output": "",
      "executed": false,
      "description": "Step 1: Define data model and load dataset"
    },
    {
      "id": "cs201-md-2",
      "type": "MARKDOWN",
      "source": "## Grouping and Aggregation\n\nLINQ's `GroupBy` is perfect for pivot-style analysis.",
      "output": "",
      "executed": false
    },
    {
      "id": "cs201-group",
      "type": "CODE",
      "mode": "csharp",
      "anchor": "cs_salesByRegion",
      "source": "//@ anchor: cs_salesByRegion\n//@ depends: cs_loadSalesData\n//@ description: Step 2: Aggregate by region\n// Step 2: aggregate by region.\n// //@ depends: cs_loadSalesData above is what guarantees `sales` exists here.\n// Arima runs the anchor cell first, so this step never has to defend itself\n// against being executed out of order.\nvar byRegion = sales\n    // GroupBy hands back one group per distinct Region. A group is both an\n    // IEnumerable of its members and a carrier of .Key - the value that formed it.\n    .GroupBy(s => s.Region)\n    // Select reshapes each group into a summary row. The anonymous type here is\n    // a pivot table row: one line per region, several aggregates across it.\n    .Select(g => new {\n        Region     = g.Key,\n        TotalSales = g.Sum(s => s.Amount),\n        TotalUnits = g.Sum(s => s.Units),\n        // Average over the group's rows, not over all sales - each aggregate\n        // call re-walks only the members of its own group.\n        AvgDeal    = g.Average(s => s.Amount)\n    })\n    .OrderByDescending(r => r.TotalSales)\n    // ToList() forces the deferred query now and caches the result, so the\n    // foreach below - and the final report cell - reuse the same computed rows.\n    .ToList();\n\nConsole.WriteLine(\"Sales by region:\");\nforeach (var r in byRegion)\n    // Widths (,-8 and ,10) line the columns up; N0 adds thousands separators\n    // and drops the decimals.\n    Console.WriteLine($\"  {r.Region,-8} ${r.TotalSales,10:N0}  units: {r.TotalUnits,5}  avg: ${r.AvgDeal:N0}\");",
      "output": "",
      "executed": false,
      "description": "Step 2: Aggregate by region"
    },
    {
      "id": "cs201-product",
      "type": "CODE",
      "mode": "csharp",
      "anchor": "cs_salesByProduct",
      "source": "//@ anchor: cs_salesByProduct\n//@ depends: cs_loadSalesData\n//@ description: Step 3: Aggregate by product\n// Step 3: the same dataset, pivoted on a different key.\n// This cell also depends only on cs_loadSalesData, not on the region step -\n// so the two are siblings in the graph and neither waits on the other.\nvar byProduct = sales\n    .GroupBy(s => s.Product)\n    .Select(g => new {\n        Product    = g.Key,\n        TotalSales = g.Sum(s => s.Amount),\n        TotalUnits = g.Sum(s => s.Units),\n        // Not every aggregate is arithmetic. This one projects the group down\n        // to its region names, removes duplicates, and counts what is left -\n        // a reach measure: how many regions this product actually sold in.\n        RegionCount = g.Select(s => s.Region).Distinct().Count()\n    })\n    .OrderByDescending(p => p.TotalSales)\n    .ToList();\n\nConsole.WriteLine(\"Sales by product:\");\nforeach (var p in byProduct)\n    Console.WriteLine($\"  {p.Product,-12} ${p.TotalSales,10:N0}  units: {p.TotalUnits,5}  regions: {p.RegionCount}\");",
      "output": "",
      "executed": false,
      "description": "Step 3: Aggregate by product"
    },
    {
      "id": "cs201-report",
      "type": "CODE",
      "mode": "csharp",
      "anchor": "cs_finalReport",
      "source": "//@ anchor: cs_finalReport\n//@ depends: cs_salesByRegion, cs_salesByProduct\n//@ description: Step 4: Final summary\n// Step 4: the join point. Two anchors in //@ depends: means both branches must\n// finish before this runs - that is the whole reason to declare dependencies\n// rather than trusting the order cells happen to sit in the notebook.\nvar totalRevenue = sales.Sum(s => s.Amount);\nvar totalUnits   = sales.Sum(s => s.Units);\n\n// Both lists were already sorted descending by their step, so First() is the\n// top row. Prefer First() to [0] here: it states the intent, and it throws a\n// clear error on an empty sequence instead of an index-out-of-range.\nvar topRegion    = byRegion.First().Region;\nvar topProduct   = byProduct.First().Product;\n\n// BaristaHtml renders its argument as HTML in the output pane rather than as\n// plain text - useful for a final summary that a person, not a later cell, reads.\nBaristaHtml($\"<h3>Sales Summary</h3><ul><li>Total Revenue: <strong>${totalRevenue:N0}</strong></li><li>Total Units Sold: <strong>{totalUnits:N0}</strong></li><li>Top Region: <strong>{topRegion}</strong></li><li>Top Product: <strong>{topProduct}</strong></li></ul>\");",
      "output": "",
      "executed": false,
      "description": "Step 4: Final summary"
    },
    {
      "id": "cs201-pipeline",
      "type": "CODE",
      "mode": "csharp",
      "source": "//@ pipeline: C# Sales Analysis\n//@ steps: cs_loadSalesData, cs_salesByRegion, cs_salesByProduct, cs_finalReport\n//@ description: Full sales analysis pipeline\n// A pipeline cell holds no code - the //@ steps: line above is the whole cell.\n// Arima reads the anchors, follows each cell's //@ depends: declarations, and\n// topologically sorts them, so the listed order is a starting point rather than\n// a schedule: the two aggregation steps could run in either order, and the\n// report is held back until both have finished.\n// Press Run Pipeline to execute the graph.",
      "output": "",
      "executed": false
    }
  ],
