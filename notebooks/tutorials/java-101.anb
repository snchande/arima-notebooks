      "id": "j101-classes-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-define-a-class-inline-t\n//@ description: 🔵 JShell Mode — define a class inline, then instantiate it\n// --- JShell mode: declare a class inline, then create instances of it ---\nclass Point {\n    // Fields: one copy of each lives inside every Point object you create.\n    double x, y;\n\n    // A constructor has no return type and shares the class's name. It runs\n    // once, when 'new Point(...)' allocates the object.\n    Point(double x, double y) {\n        // The parameters shadow the fields because they have the same names.\n        // 'this.x' means \"the field of the object being constructed\"; a bare\n        // 'x' would mean the parameter. Dropping 'this.' here would assign the\n        // parameter to itself and leave the fields at 0.\n        this.x = x;\n        this.y = y;\n    }\n\n    // An instance method: it reads 'this' object's fields and the other one's.\n    // Private state of another instance of the SAME class is visible - access\n    // control in Java is per-class, not per-object.\n    double distanceTo(Point other) {\n        double dx = this.x - other.x;\n        double dy = this.y - other.y;\n        return Math.sqrt(dx*dx + dy*dy);   // Pythagoras\n    }\n\n    // Every object inherits toString() from Object, which prints something\n    // unhelpful like Point@1b6d3586. Overriding it is what makes the\n    // println() calls below readable. @Override is not required, but it makes\n    // the compiler reject a typo such as 'tostring'.\n    @Override public String toString() {\n        return String.format(\"Point(%.1f, %.1f)\", x, y);\n    }\n}\n\nvar p1 = new Point(0, 0);\nvar p2 = new Point(3, 4);\n// The int literals 0, 3 and 4 widen to double automatically - Java allows\n// conversions that cannot lose information without asking for a cast.\nSystem.out.println(\"p1 = \" + p1);   // string concatenation calls toString()\nSystem.out.println(\"p2 = \" + p2);\nSystem.out.printf(\"Distance p1->p2 = %.2f%n\", p1.distanceTo(p2));",
      "output": "p1 = Point(0.0, 0.0)\r\np2 = Point(3.0, 4.0)\r\nDistance p1?p2 = 5.00\r\n",
      "returnValue": "java.io.PrintStream@6267c3bb",
      "executed": true,
      "executionCount": 23,
      "error": "",
      "anchor": "jshell-mode-define-a-class-inline-t",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — define a class inline, then instantiate it"
    },
    {
      "id": "j101-classes-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-classic-oop-class-with-en\n//@ description: ☕ Java Mode — classic OOP: class with encapsulation, constructor, toString\n// --- Java mode: encapsulation - state that can only change through methods ---\npublic class BankAccount {\n    // 'private' is the point of the exercise. No code outside this class can\n    // write to balance directly, so every change has to pass through deposit()\n    // or withdraw() and be checked there. That is what keeps the rule\n    // \"balance is never negative\" true for the whole life of the object.\n    private String owner;\n    private double balance;\n\n    public BankAccount(String owner, double initialBalance) {\n        this.owner   = owner;\n        this.balance = initialBalance;\n    }\n\n    public void deposit(double amount) {\n        // Reject bad input at the boundary, loudly. Throwing beats returning a\n        // flag: the caller cannot accidentally ignore an exception.\n        if (amount <= 0) throw new IllegalArgumentException(\"Amount must be positive\");\n        balance += amount;\n        System.out.printf(\"  Deposited $%.2f -> balance $%.2f%n\", amount, balance);\n    }\n\n    public void withdraw(double amount) {\n        // IllegalArgumentException would blame the argument; the argument is\n        // fine, it is the account's state that forbids this. IllegalState\n        // Exception says exactly that, and the distinction helps whoever\n        // reads the stack trace later.\n        if (amount > balance) throw new IllegalStateException(\"Insufficient funds\");\n        balance -= amount;\n        System.out.printf(\"  Withdrew $%.2f -> balance $%.2f%n\", amount, balance);\n    }\n\n    @Override public String toString() {\n        // Note that toString() can read the private fields freely - it is\n        // inside the class. Only the outside world is kept at arm's length.\n        return String.format(\"BankAccount[owner=%s, balance=$%.2f]\", owner, balance);\n    }\n\n    // A class may hold its own main(); this one doubles as the demo runner.\n    public static void main(String[] args) {\n        var account = new BankAccount(\"Alice\", 1000.00);\n        System.out.println(\"Created: \" + account);\n        account.deposit(500);    // int 500 widens to the double parameter\n        account.withdraw(200);\n        System.out.println(\"Final:   \" + account);\n    }\n}",
      "output": "Created: BankAccount[owner=Alice, balance=$1000.00]\r\n  Deposited $500.00 ? balance $1500.00\r\n  Withdrew $200.00 ? balance $1300.00\r\nFinal:   BankAccount[owner=Alice, balance=$1300.00]\r\n",
      "returnValue": "",
