    {
      "id": "j101-hello-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-no-class-wrapper-needed\n//@ description: 🔵 JShell Mode — no class wrapper needed, runs line by line\n// --- JShell mode: no class wrapper, statements run one after another ---\n// A .java file must wrap every statement in a class and a main() method.\n// JShell does that wrapping for you behind the scenes, so a bare statement\n// like the next line is already a complete, runnable program.\nSystem.out.println(\"Hello, Arima Notebooks!\");\n\n// Runtime.version() reports the JDK that is actually running this cell.\n// That matters more than what you last installed: the language features you\n// are allowed to use are decided by this number.\nSystem.out.println(\"Java version: \" + Runtime.version());\n\n// printf formats rather than concatenates.\n//   %s = \"any object, rendered through its toString()\"\n//   %n = a line break in the platform's own convention\n// (plain \"\\n\" is always exactly one LF byte, which is what you want in files\n// but not always what you want on a console).\nSystem.out.printf(\"Today is %s%n\", java.time.LocalDate.now());\n\n// String.format does the same formatting work but hands the String back\n// instead of printing it - useful when the text is going somewhere else.\n// version() returns a List<Integer> such as [21, 0, 2], so get(0) is the\n// feature-release number: 21.\nvar greeting = String.format(\"Welcome to Java %s!\", Runtime.version().version().get(0));\nSystem.out.println(greeting);",
      "output": "Hello, Arima Notebooks!\r\nJava version: 25+37-LTS-3491\r\nToday is 2026-03-14\r\nWelcome to Java 25!\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 15,
      "error": "",
      "anchor": "jshell-mode-no-class-wrapper-needed",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — no class wrapper needed, runs line by line"
    },
    {
      "id": "j101-hello-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-full-class-with-main-met\n//@ description: ☕ Java Mode — full class with main() method (standard Java program structure)\n// --- Java mode: the full class-with-main() shape of a real program ---\n// In a real .java file this would be the entire file content, and the file\n// would have to be named HelloWorld.java to match the public class.\npublic class HelloWorld {\n\n    // main() is the one method the JVM knows how to call from outside.\n    // Each part of the signature is required:\n    //   public  - callable from outside the class (the JVM is \"outside\")\n    //   static  - runs without anyone constructing a HelloWorld first\n    //   void    - returns nothing; the exit code comes from System.exit\n    //   String[] args - the command-line arguments, empty here\n    public static void main(String[] args) {\n        System.out.println(\"Hello, Arima Notebooks!\");\n        System.out.println(\"Java version: \" + Runtime.version());\n        System.out.printf(\"Today is %s%n\", java.time.LocalDate.now());\n\n        // Inside a class you can write either \"String greeting\" or \"var greeting\".\n        // Production code often spells the type out so a reader scanning the\n        // file never has to work out what the right-hand side returns.\n        String greeting = String.format(\"Welcome to Java %s!\",\n                Runtime.version().version().get(0));\n        System.out.println(greeting);\n    }\n}",
      "output": "Hello, Arima Notebooks!\r\nJava version: 25+37-LTS-3491\r\nToday is 2026-03-14\r\nWelcome to Java 25!\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 13,
      "error": "",
      "anchor": "java-mode-full-class-with-main-met",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "☕ Java Mode — full class with main() method (standard Java program structure)"
    },
