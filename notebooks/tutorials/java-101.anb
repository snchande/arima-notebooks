    {
      "id": "j101-loops-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-2\n//@ description: 🔵 JShell Mode\n// --- JShell mode: the loop forms, and when each one fits ---\n\n// The classic for packs three things into one line: set up (int i = 1),\n// the test run before every pass (i <= 5), and the step run after every pass\n// (i++). Use it when you need the counter itself.\nSystem.out.print(\"1-5:  \");\nfor (int i = 1; i <= 5; i++) System.out.print(i + \" \");\nSystem.out.println();   // print() does not break the line; println() does\n\n// A while loop when the number of passes is not known up front - here we stop\n// on a value, not on a count. Note that the body has to advance n itself;\n// forgetting that is the usual cause of an infinite loop.\nint n = 1;\nSystem.out.print(\"Powers of 2: \");\nwhile (n <= 32) { System.out.print(n + \" \"); n *= 2; }   // n *= 2 is n = n * 2\nSystem.out.println();\n\n// The enhanced for-each: no index, no off-by-one. It works on any array and on\n// anything Iterable, but it gives you the element only - not its position.\nvar fruits = new String[]{\"apple\", \"banana\", \"cherry\"};\nfor (var fruit : fruits) System.out.println(\"  - \" + fruit);\n\n// break and continue are the two escape hatches:\n//   continue - abandon THIS pass, go straight to the next one\n//   break    - abandon the loop entirely\nSystem.out.print(\"Odd 1-9: \");\nfor (int i = 1; i <= 10; i++) {\n    if (i % 2 == 0) continue;   // % is remainder; == 0 means \"evenly divisible\"\n    if (i > 9) break;           // never actually fires here: 10 is even, so it\n                                // is skipped by the continue above. It is shown\n                                // to make the syntax concrete.\n    System.out.print(i + \" \");\n}\nSystem.out.println();",
      "output": "1�5:  1 2 3 4 5 \r\nPowers of 2: 1 2 4 8 16 32 \r\n  � apple\r\n  � banana\r\n  � cherry\r\nOdd 1�9: 1 3 5 7 9 \r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 19,
      "error": "",
      "anchor": "jshell-mode-2",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode"
    },
    {
      "id": "j101-loops-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-loops-inside-a-class\n//@ description: ☕ Java Mode — loops inside a class\n// --- Java mode: loops inside a class ---\nimport java.util.List;\n\npublic class LoopsDemo {\n\n    // do-while tests AFTER the body, so the body always runs at least once.\n    // That is the whole reason it exists: countDown(0) would still print one\n    // line, whereas a plain while loop would print nothing.\n    static void countDown(int from) {\n        System.out.print(\"Countdown: \");\n        do {\n            System.out.print(from + \" \");\n            from--;   // 'from' is a copy of the caller's value, so decrementing\n                      // it here cannot affect the caller. Java passes by value.\n        } while (from > 0);\n        System.out.println(\"Go!\");\n    }\n\n    public static void main(String[] args) {\n        // Nested loops: the inner loop runs to completion for every single pass\n        // of the outer one, so this body executes 4 x 4 = 16 times.\n        System.out.println(\"Multiplication table (1-4):\");\n        for (int i = 1; i <= 4; i++) {\n            for (int j = 1; j <= 4; j++) {\n                System.out.printf(\"%3d\", i * j);   // width 3 keeps the grid square\n            }\n            System.out.println();   // end the row once the inner loop is done\n        }\n        countDown(5);\n\n        // List.of builds an IMMUTABLE list - add() or set() on it throws.\n        // That is a feature: it cannot be modified behind your back.\n        var colors = List.of(\"red\", \"green\", \"blue\");\n\n        // forEach takes a lambda and calls it once per element. It reads like a\n        // for-each loop, but the loop itself now belongs to the collection.\n        colors.forEach(c -> System.out.println(\"  Color: \" + c));\n    }\n}",
      "output": "Multiplication table (1�4):\r\n  1  2  3  4\r\n  2  4  6  8\r\n  3  6  9 12\r\n  4  8 12 16\r\nCountdown: 5 4 3 2 1 Go!\r\n  Color: red\r\n  Color: green\r\n  Color: blue\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 20,
      "error": "",
      "anchor": "java-mode-loops-inside-a-class",
      "dependsOn": [],
