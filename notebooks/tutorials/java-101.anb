    {
      "id": "j101-vars-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-declare-variables-at-top\n//@ description: 🔵 JShell Mode — declare variables at top level, 'var' infers type\n// --- JShell mode: variables at top level; 'var' infers the type ---\n// 'var' does not mean \"untyped\". The compiler still pins down exactly one type\n// at the point of declaration, reading it off the initialiser on the right, and\n// that type can never change afterwards. This is still fully static typing.\nvar name    = \"Alice\";      // -> String\nvar age     = 30;           // -> int    (a whole-number literal is int by default)\nvar height  = 1.75;         // -> double (a decimal literal is double by default)\nvar active  = true;         // -> boolean\nvar initial = 'A';          // -> char   single quotes hold exactly one character;\n                            //           double quotes would have given a String\n\n// Spelling the type out does the same thing. Prefer it when the initialiser\n// does not make the type obvious at a glance.\nString city = \"New York\";\nint year    = 2026;\n\n// '+' is overloaded: with a String on either side it means \"concatenate\", and\n// the other operand is converted to text through its toString(). That is why\n// an int can sit next to a String here without an explicit conversion.\nSystem.out.println(\"Name:   \" + name   + \" (String)\");\nSystem.out.println(\"Age:    \" + age    + \" (int)\");\nSystem.out.println(\"Height: \" + height + \" (double)\");\nSystem.out.println(\"City:   \" + city   + \", Year: \" + year);",
      "output": "Name:   Alice (String)\r\nAge:    30 (int)\r\nHeight: 1.75 (double)\r\nCity:   New York, Year: 2026\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 15,
      "error": "",
      "anchor": "jshell-mode-declare-variables-at-top",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — declare variables at top level, 'var' infers type"
    },
    {
      "id": "j101-vars-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-variables-inside-a-method\n//@ description: ☕ Java Mode — variables inside a method (same syntax, same types)\n// --- Java mode: the same variables, declared inside a method ---\npublic class VariablesDemo {\n    public static void main(String[] args) {\n        // These five are Java's primitives: they hold a value directly rather\n        // than a reference to an object, so they can never be null. String is\n        // the odd one out here - it is a real object.\n        String name    = \"Alice\";\n        int    age     = 30;\n        double height  = 1.75;\n        boolean active = true;\n        char initial   = 'A';\n\n        // var works inside methods too (Java 10+), but only where there is an\n        // initialiser to infer from - never for fields or method parameters.\n        var city = \"New York\";\n        var year = 2026;\n\n        // printf conversions must match the argument's type, and the compiler\n        // does not check them for you - a mismatch fails at run time.\n        //   %-8s  left-align a string in 8 columns  (the '-' means left)\n        //   %-10d an int in 10 columns\n        //   %-10.2f a double, 10 columns wide, 2 digits after the point\n        //   %-10b a boolean\n        System.out.printf(\"%-8s %-10s %s%n\", \"name\",   name,   \"(String)\");\n        System.out.printf(\"%-8s %-10d %s%n\", \"age\",    age,    \"(int)\");\n        System.out.printf(\"%-8s %-10.2f %s%n\",\"height\", height, \"(double)\");\n        System.out.printf(\"%-8s %-10b %s%n\", \"active\", active, \"(boolean)\");\n    }\n}",
      "output": "name     Alice      (String)\r\nage      30         (int)\r\nheight   1.75       (double)\r\nactive   true       (boolean)\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 16,
      "error": "",
      "anchor": "java-mode-variables-inside-a-method",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "☕ Java Mode — variables inside a method (same syntax, same types)"
    },
