    {
      "id": "j101-control-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode\n//@ description: 🔵 JShell Mode\n// --- JShell mode: the three ways Java branches ---\nint score = 85;\n\n// An if / else-if chain is tested top to bottom and stops at the FIRST match.\n// That is why the bounds can be written as bare \">=\" instead of ranges: by the\n// time the second test runs, we already know the score is below 90.\nif (score >= 90)      System.out.println(\"Grade: A\");\nelse if (score >= 80) System.out.println(\"Grade: B\");\nelse if (score >= 70) System.out.println(\"Grade: C\");\nelse                  System.out.println(\"Grade: F\");\n\n// A switch EXPRESSION (Java 14+) produces a value, so it can be assigned.\n// score / 10 is integer division between two ints: the fractional part is\n// discarded, not rounded. 85 / 10 is 8, and 89 / 10 is also 8 - which is\n// exactly the bucketing we want here.\nvar grade = switch (score / 10) {\n    // The arrow form takes one branch and stops. There is no fall-through and\n    // therefore no 'break' - the classic C-style bug simply cannot happen.\n    case 10, 9 -> \"A\";      // one case may list several values\n    case 8     -> \"B\";\n    case 7     -> \"C\";\n    case 6     -> \"D\";\n    // A switch expression must cover every possible input, because it has to\n    // yield a value in all cases. 'default' is what makes this one exhaustive.\n    default    -> \"F\";\n};\nSystem.out.println(\"Switch grade: \" + grade);\n\n// The ternary ?: is an expression too - the compact form of an if/else that\n// chooses between two values. The parentheses are needed because '+' binds\n// tighter than '?', so without them Java would try to concatenate first.\nSystem.out.println(\"Result: \" + (score >= 60 ? \"Pass\" : \"Fail\"));",
      "output": "Grade: B\r\nSwitch grade: B\r\nResult: Pass\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 17,
      "error": "",
      "anchor": "jshell-mode",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode"
    },
    {
      "id": "j101-control-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-same-control-flow-inside-a\n//@ description: ☕ Java Mode — same control flow inside a class\n// --- Java mode: the same control flow, factored into a method ---\npublic class ControlFlowDemo {\n\n    // Pulling the switch into its own method is the real win: the rule now has\n    // a name, and it can be tested and reused instead of being copy-pasted.\n    // 'static' because it depends only on its argument, not on any object state.\n    static String getGrade(int score) {\n        return switch (score / 10) {\n            case 10, 9 -> \"A\";\n            case 8     -> \"B\";\n            case 7     -> \"C\";\n            case 6     -> \"D\";\n            default    -> \"F\";\n        };\n    }\n\n    public static void main(String[] args) {\n        // An array literal. Arrays have a fixed length, set when they are created.\n        int[] scores = {95, 85, 75, 65, 55};\n\n        System.out.println(\"Score | Grade | Result\");\n        System.out.println(\"------|-------|-------\");\n\n        // The enhanced for (\"for each score in scores\") is preferred when you do\n        // not need the index - there is no counter to get wrong.\n        for (int score : scores) {\n            // %3d pads the number to 3 columns so the column stays aligned;\n            // %5s does the same for the grade.\n            System.out.printf(\"  %3d | %5s | %s%n\",\n                score, getGrade(score), score >= 60 ? \"Pass\" : \"Fail\");\n        }\n    }\n}",
      "output": "Score | Grade | Result\r\n------|-------|-------\r\n   95 |     A | Pass\r\n   85 |     B | Pass\r\n   75 |     C | Pass\r\n   65 |     D | Pass\r\n   55 |     F | Fail\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 18,
      "error": "",
      "anchor": "java-mode-same-control-flow-inside-a",
      "dependsOn": [],
