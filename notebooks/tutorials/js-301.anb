    {
      "id": "js-301-composition",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: function-composition\n//@ description: Function Composition\n// --- Function Composition ---\n// Compose: build a new function by chaining smaller functions together.\n// compose(f, g)(x) = f(g(x))   - right to left\n// pipe(f, g)(x)    = g(f(x))   - left to right (more readable for data pipelines)\n\n// Simple compose (right-to-left, like the mathematical notation f(g(x)))\n// reduceRight walks the list from the end, so the LAST function listed runs first.\nconst compose = (...fns) => x => fns.reduceRight((acc, fn) => fn(acc), x);\n\n// pipe = compose in reverse (left-to-right, like a Unix pipe)\n// The accumulator here is the DATA flowing through, not a running total - each\n// step receives the previous step's output.\nconst pipe = (...fns) => x => fns.reduce((acc, fn) => fn(acc), x);\n\n// Building blocks - each is a pure, single-purpose function\nconst trim        = s => s.trim();\nconst toLower     = s => s.toLowerCase();\n// \\s+ matches one or more whitespace characters; the /g flag replaces every run,\n// not just the first one.\nconst removeSpaces = s => s.replace(/\\s+/g, '-');\n// These two are curried: they take a configuration value and return the actual\n// step, so the pipeline below can be assembled from parameterised pieces.\nconst addPrefix   = prefix => s => `${prefix}${s}`;\nconst truncate    = max => s => s.length > max ? s.slice(0, max) + '...' : s;\n\n// Compose a URL-slug generator\n// Order matters: trimming before lowercasing before hyphenating gives a clean\n// slug, and truncation comes last so the prefix is always present.\nconst toSlug = pipe(\n    trim,\n    toLower,\n    removeSpaces,\n    addPrefix('post-'),   // called now; the returned step runs later\n    truncate(20)\n);\n\nconst titles = [\n    '  Hello World  ',\n    'Modern JavaScript Patterns',\n    '  Arima Notebooks Tutorial  ',\n    'A'\n];\n\nconsole.log('Slugs:');\ntitles.forEach(t => console.log(`  '${t}' → '${toSlug(t)}'`));\n\n// You can also compose predicates\nconst isString  = x => typeof x === 'string';\nconst isLong    = s => s.length > 5;\n// .test() returns a boolean; the /i flag makes the match case-insensitive.\nconst hasVowel  = s => /[aeiou]/i.test(s);\n\n// every() short-circuits on the first false, some() on the first true - so the\n// cheap predicates are worth listing first.\nconst allPass = (...preds) => x => preds.every(p => p(x));\nconst anyPass = (...preds) => x => preds.some(p => p(x));\n\n// isString runs before isLong, which is what protects .length from a non-string.\nconst isGoodWord = allPass(isString, isLong, hasVowel);\nconst words = ['hi', 'hello', 'rhythm', 'JavaScript', '123'];\nconsole.log('\\nGood words:', words.filter(isGoodWord));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "function-composition",
      "dependsOn": [],
