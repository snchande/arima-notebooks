    {
      "id": "js-301-map-filter-reduce",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: map-filter-reduce-the-fp-trinity\n//@ description: map, filter, reduce — the FP trinity\n// --- map, filter, reduce - the FP trinity ---\n// These three array methods cover the vast majority of data transformation needs.\n// They are pure: they return new arrays/values, never mutate the original.\n// Because each returns a value, they chain - unlike a for-loop, which returns\n// nothing and forces you to declare a mutable accumulator up front.\n\nconst products = [\n    { name: 'Widget',    price: 9.99,  qty: 100, category: 'hardware' },\n    { name: 'Gadget',    price: 24.99, qty: 25,  category: 'electronics' },\n    { name: 'Doohickey', price: 4.50,  qty: 500, category: 'hardware' },\n    { name: 'Thingamajig', price: 49.99, qty: 10, category: 'electronics' },\n    { name: 'Whatsit',   price: 1.99,  qty: 200, category: 'hardware' },\n];\n\n// map: transform each element, returns a new array of the same length\nconst names = products.map(p => p.name);\n// { ...p, revenue } copies every existing field and adds one more - an immutable\n// \"enrich\" step, since the source objects are not touched.\nconst withRevenue = products.map(p => ({ ...p, revenue: p.price * p.qty }));\nconsole.log('Names:', names);\nconsole.log('Revenue:', withRevenue.map(p => `${p.name}: $${p.revenue.toFixed(2)}`));\n\n// filter: keep elements that match a predicate, returns a shorter (or equal) array\n// A predicate is any function returning a truthy/falsy value. '===' compares\n// without coercion, which is what you want for string tags like this.\nconst hardware = products.filter(p => p.category === 'hardware');\nconst expensive = products.filter(p => p.price > 20);\nconsole.log('\\nHardware products:', hardware.map(p => p.name));\nconsole.log('Expensive (>$20) :', expensive.map(p => p.name));\n\n// reduce: fold the array into a single value (number, string, object, array...)\n// reduce(callback, initialValue)\n// callback(accumulator, currentElement) -> new accumulator\n// map and filter are both special cases of reduce; reduce is the general tool.\nconst totalRevenue = products.reduce((acc, p) => acc + p.price * p.qty, 0);\nconsole.log(`\\nTotal revenue: $${totalRevenue.toFixed(2)}`);\n\n// Build an index (object keyed by name) with reduce\n// The accumulator does not have to be a number. Here it is an object, turning a\n// list into a lookup table so retrieval is O(1) instead of a scan.\nconst productIndex = products.reduce((acc, p) => {\n    acc[p.name] = p;    // acc is the object we're building up\n    return acc;         // always return the accumulator - forgetting this yields undefined\n}, {});\nconsole.log('Widget price:', productIndex['Widget'].price);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "map-filter-reduce-the-fp-trinity",
      "dependsOn": [],
