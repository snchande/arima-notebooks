    {
      "id": "js-301-immutability",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: immutability\n//@ description: Immutability\n// --- Immutability ---\n// WHY: Mutable shared state is the #1 source of bugs in large applications.\n// Immutable data means once created, an object never changes -\n// you create a new modified copy instead.\n\n// Object.freeze - shallow freeze (nested objects are still mutable)\nconst config = Object.freeze({\n    host: 'localhost',\n    port: 8585,\n    debug: false,\n});\n// The failure mode differs by mode, which is a good reason to prefer modules\n// (always strict) over loose scripts.\n// config.port = 9000;  // silently ignored in sloppy mode, throws in strict mode\nconsole.log('config.port:', config.port);  // still 8585\n\n// Immutable update patterns using spread\nconst user = { name: 'Alice', age: 30, prefs: { theme: 'dark', lang: 'en' } };\n\n// Update top-level field\n// Spread first, override after: later keys win, so 'age: 31' replaces the copied\n// value. Reversing the two lines would silently do nothing.\nconst olderUser = { ...user, age: 31 };\nconsole.log('user.age    :', user.age);       // 30 - unchanged\nconsole.log('olderUser.age:', olderUser.age); // 31\n\n// Update nested field (need to spread each level)\n// A single spread is SHALLOW: without the inner { ...user.prefs } both objects\n// would share the same prefs object and the \"copy\" would leak changes back.\nconst lightUser = { ...user, prefs: { ...user.prefs, theme: 'light' } };\nconsole.log('user.prefs.theme     :', user.prefs.theme);      // dark\nconsole.log('lightUser.prefs.theme:', lightUser.prefs.theme); // light\n\n// Immutable array operations\n// The rule: avoid push/pop/splice/sort, which mutate; prefer spread/filter/map,\n// which return new arrays.\nconst arr = [1, 2, 3, 4, 5];\n\n// Add to end / beginning\nconst withSix  = [...arr, 6];\nconst withZero = [0, ...arr];\n\n// Remove by index\n// The '_' names the element we deliberately ignore; only the index matters here.\nconst without3 = arr.filter((_, i) => i !== 2);   // remove index 2\n\n// Update element at index\n// map's second argument is the index, so a conditional inside map is the\n// immutable equivalent of arr[2] = 99.\nconst updated = arr.map((val, i) => i === 2 ? 99 : val);  // index 2 becomes 99\n\nconsole.log('\\nOriginal :', arr);\nconsole.log('withSix  :', withSix);\nconsole.log('withZero :', withZero);\nconsole.log('without3 :', without3);\nconsole.log('updated  :', updated);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
