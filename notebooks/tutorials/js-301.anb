    {
      "id": "js-301-currying",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: currying-and-partial-application\n//@ description: Currying and Partial Application\n// --- Currying and Partial Application ---\n// CURRYING: transform f(a, b, c) into f(a)(b)(c)\n// Each call returns a new function waiting for the next argument.\n// WHY: enables partial application - pre-fill some arguments now, supply the rest later.\n\n// Manual curry\n// Read 'a => b => a + b' as: a function of 'a' that RETURNS a function of 'b'.\n// The inner function closes over 'a', which is why the value survives.\nconst curriedAdd = a => b => a + b;\nconst add10 = curriedAdd(10);   // partial: 'a' is fixed at 10\nconsole.log('add10(5)  :', add10(5));    // 15\nconsole.log('add10(32) :', add10(32));   // 42\n\n// Practical: a curried filter-builder\n// Three nested arrows means three separate calls, each narrowing the behaviour.\n// Ordering the parameters most-general-first (key, then value, then data) is what\n// makes the intermediate steps reusable.\nconst filterBy = (key) => (value) => (arr) =>\n    arr.filter(item => item[key] === value);\n\nconst byCategory = filterBy('category');        // still needs a value and an array\nconst getHardware    = byCategory('hardware');  // now only needs an array\nconst getElectronics = byCategory('electronics');\n\nconst products = [\n    { name: 'Widget', category: 'hardware',    price: 9.99  },\n    { name: 'Gadget', category: 'electronics', price: 24.99 },\n    { name: 'Thingamajig', category: 'electronics', price: 49.99 },\n    { name: 'Doohickey',   category: 'hardware',    price: 4.50  },\n];\n\nconsole.log('Hardware:', getHardware(products).map(p => p.name));\nconsole.log('Electronics:', getElectronics(products).map(p => p.name));\n\n// General curry utility - wraps any function\nconst curry = (fn) => {\n    // fn.length is the ARITY: how many parameters were declared. Note it stops\n    // counting at the first default or rest parameter.\n    const arity = fn.length;   // number of declared parameters\n    // Named function expression so the inner body can call itself recursively.\n    return function curried(...args) {\n        // Enough arguments collected? Run for real.\n        if (args.length >= arity) return fn(...args);\n        // Otherwise return a function that remembers what we have so far.\n        return (...more) => curried(...args, ...more);\n    };\n};\n\nconst clamp = curry((min, max, value) => Math.min(Math.max(value, min), max));\n// Two of three arguments supplied, so we get back a one-argument function.\nconst clamp0to100 = clamp(0, 100);\nconsole.log('\\nclamp0to100(-5) :', clamp0to100(-5));   // 0\nconsole.log('clamp0to100(42) :', clamp0to100(42));    // 42\nconsole.log('clamp0to100(200):', clamp0to100(200));   // 100",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "currying-and-partial-application",
