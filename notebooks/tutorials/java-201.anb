      "description": "🔵 JShell Mode — Stream pipeline: source → intermediate ops → terminal op"
    },
    {
      "id": "j202-streams-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-streams-with-records-coll\n//@ description: ☕ Java Mode — Streams with records, collectors, and flatMap\n// --- Java mode: records plus collectors on a realistic dataset ---\nimport java.util.*;\nimport java.util.stream.*;\n\n// A record is the natural row type for this kind of work: named components,\n// value equality, and accessors that can be used as method references below.\nrecord Student(String name, String subject, int score) {}\n\npublic class StreamsDemo {\n    public static void main(String[] args) {\n        var students = List.of(\n            new Student(\"Alice\", \"Math\",    92),\n            new Student(\"Bob\",   \"Math\",    78),\n            new Student(\"Alice\", \"Science\", 88),\n            new Student(\"Bob\",   \"Science\", 85),\n            new Student(\"Carol\", \"Math\",    95),\n            new Student(\"Carol\", \"Science\", 90)\n        );\n\n        // groupingBy takes a second collector that decides what to do with each\n        // group. Without it you get List<Student> per key; with\n        // averagingInt you get the average directly - the grouping and the\n        // aggregation happen in the same pass.\n        System.out.println(\"Average by subject:\");\n        students.stream()\n            .collect(Collectors.groupingBy(Student::subject,\n                     Collectors.averagingInt(Student::score)))\n            .forEach((sub, avg) -> System.out.printf(\"  %-9s %.1f%n\", sub, avg));\n\n        // max() returns Optional because a stream may be empty and there would\n        // then be no maximum to return. ifPresent runs only when there is one,\n        // so there is no null to forget to check.\n        students.stream()\n            .max(Comparator.comparingInt(Student::score))\n            .ifPresent(s -> System.out.println(\"Top student: \" + s.name() +\n                \" (\" + s.score() + \")\"));\n\n        // Comparator.comparingInt(...).reversed() reads as \"by score, highest\n        // first\". Building comparators this way avoids hand-written compare\n        // methods and the sign errors that come with them.\n        var passing = students.stream()\n            .filter(s -> s.score() >= 80)\n            .sorted(Comparator.comparingInt(Student::score).reversed())\n            .map(s -> s.name() + \"/\" + s.subject() + \"=\" + s.score())\n            // joining is the collector to reach for instead of concatenating\n            // in a loop: it uses one StringBuilder internally.\n            .collect(Collectors.joining(\", \"));\n        System.out.println(\"Passing: \" + passing);\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "java-mode-streams-with-records-coll",
