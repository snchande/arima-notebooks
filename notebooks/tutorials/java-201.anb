    {
      "id": "j202-records-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-records-are-compact-imm\n//@ description: 🔵 JShell Mode — records are compact, immutable data classes\n// --- JShell mode: records - a whole data class in one line ---\n// \"record Person(String name, int age)\" tells the compiler to generate the\n// private final fields, the constructor, the accessors name() and age(),\n// equals(), hashCode() and toString(). Writing that by hand is roughly 40\n// lines you would then have to keep in sync by hand every time a field changes.\nrecord Person(String name, int age) {\n    // A record is still a class, so it can carry behaviour. What it must not\n    // carry is extra mutable state: no additional instance fields are allowed.\n    String greeting() { return \"Hi, I'm \" + name + \" and I'm \" + age; }\n}\n\nrecord Point(double x, double y) {\n    // A derived value belongs in a method, not a field: it is computed from x\n    // and y, so storing it would only create something that can fall out of date.\n    double magnitude() { return Math.sqrt(x*x + y*y); }\n}\n\nvar alice = new Person(\"Alice\", 30);\nvar bob   = new Person(\"Bob\",   25);\n\nSystem.out.println(alice);               // generated toString: Person[name=Alice, age=30]\n// The accessor is name(), not getName(). Records deliberately skip the\n// JavaBeans \"get\" prefix - the component name IS the method name.\nSystem.out.println(alice.name());\nSystem.out.println(alice.greeting());\n// Generated equals() compares component by component (value equality), rather\n// than asking \"are these the same object in memory\". Two separately\n// constructed Person(\"Alice\", 30) values would therefore be equal.\nSystem.out.println(alice.equals(bob));\n\nvar p = new Point(3.0, 4.0);\nSystem.out.printf(\"Point %s magnitude = %.2f%n\", p, p.magnitude());",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "jshell-mode-records-are-compact-imm",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — records are compact, immutable data classes"
    },
    {
      "id": "j202-records-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-records-in-production-code\n//@ description: ☕ Java Mode — records in production code\n// --- Java mode: a record carrying validation and factory methods ---\nimport java.util.List;\n\npublic record Product(String id, String name, double price) {\n\n    // A COMPACT constructor: no parameter list, no assignments. It runs before\n    // the generated constructor stores the fields, and it works on the\n    // parameters. Assigning to 'name' here changes what gets stored - this is\n    // the one place where a record can normalise its own input.\n    public Product {\n        if (price < 0) throw new IllegalArgumentException(\"Price cannot be negative\");\n        name = name.strip();  // trims leading/trailing whitespace, Unicode-aware\n    }\n\n    // A static factory reads better than a constructor when the arguments alone\n    // do not explain the intent: Product.free(...) says what it means.\n    public static Product free(String id, String name) {\n        return new Product(id, name, 0.0);\n    }\n\n    // A record is immutable, so a \"change\" has to return a NEW record rather\n    // than mutate this one. The wither convention (withX) makes that explicit.\n    public Product withDiscount(double pct) {\n        return new Product(id, name, price * (1 - pct / 100));\n    }\n\n    public static void main(String[] args) {\n        var laptop  = new Product(\"P001\", \"  Laptop  \", 999.99);  // strip() cleans this\n        var freebie = Product.free(\"P002\", \"Sticker\");\n        var sale    = laptop.withDiscount(20);   // laptop itself is untouched\n        // System.out::println is a method reference - shorthand for the lambda\n        // p -> System.out.println(p).\n        List.of(laptop, freebie, sale).forEach(System.out::println);\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
