    {
      "id": "j202-optional-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-optional-avoids-null-poin\n//@ description: 🔵 JShell Mode — Optional avoids NullPointerException\n// --- JShell mode: Optional makes \"there may be no value\" part of the type ---\nimport java.util.*;\n\n// The point of Optional is not that it prevents crashes by magic. It is that a\n// method returning Optional<String> ANNOUNCES that the value may be missing, so\n// the caller cannot forget - the compiler will not let them use it as a String.\n\nvar present = Optional.of(\"Hello\");        // of() rejects null: it throws on one\nvar empty   = Optional.<String>empty();    // explicit type: nothing to infer from\nvar maybe   = Optional.ofNullable(null);   // ofNullable() accepts null quietly,\n                                           // giving an empty Optional instead\n\nSystem.out.println(\"present.isPresent() = \" + present.isPresent());\nSystem.out.println(\"empty.isEmpty()     = \" + empty.isEmpty());\n// get() throws NoSuchElementException when empty, so it is only safe after a\n// check. The orElse/map style below is preferred precisely because it cannot.\nSystem.out.println(\"present.get()       = \" + present.get());\n\n// orElse's argument is evaluated ALWAYS, even when the Optional has a value.\nSystem.out.println(empty.orElse(\"default\"));\n// orElseGet takes a Supplier and only calls it when the value is missing -\n// the one to use when computing the fallback is expensive.\nSystem.out.println(empty.orElseGet(() -> \"computed default\"));\n\n// map transforms the value if there is one and does nothing if there is not.\n// No null check appears anywhere, because there is no null to check.\nvar upper = present.map(String::toUpperCase);\nSystem.out.println(\"Mapped: \" + upper.orElse(\"nothing\"));\n\npresent.ifPresent(v -> System.out.println(\"Value: \" + v));\n// ifPresentOrElse covers both branches in one call, so neither can be skipped.\nempty.ifPresentOrElse(\n    v -> System.out.println(\"Got: \" + v),\n    () -> System.out.println(\"Empty!\")\n);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "jshell-mode-optional-avoids-null-poin",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — Optional avoids NullPointerException"
    },
    {
      "id": "j202-optional-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-optional-in-a-real-world-l\n//@ description: ☕ Java Mode — Optional in a real-world lookup scenario\n// --- Java mode: Optional where it earns its keep - a lookup that can miss ---\nimport java.util.*;\nimport java.util.stream.*;\n\npublic class OptionalDemo {\n    // Map.of builds a small immutable map. 'static final' plus immutability\n    // makes it safe to share: nothing can rewrite the phone book at run time.\n    static final Map<String, String> PHONE_BOOK = Map.of(\n        \"Alice\", \"555-0100\",\n        \"Bob\",   \"555-0200\"\n    );\n\n    // Map.get() returns null for a missing key, which is the classic source of\n    // NullPointerException three call frames later. Wrapping it here converts\n    // \"absent\" from a value into part of the return TYPE, once, at the source.\n    static Optional<String> findPhone(String name) {\n        return Optional.ofNullable(PHONE_BOOK.get(name));\n    }\n\n    static String formatEntry(String name) {\n        // Each map() runs only if a value survived the previous stage, so the\n        // whole chain short-circuits on a miss with no branching to write.\n        return findPhone(name)\n            .map(phone -> name + \": \" + phone)\n            .map(String::toUpperCase)\n            // orElse supplies the one and only place a default is decided.\n            .orElse(name + \": NOT FOUND\");\n    }\n\n    public static void main(String[] args) {\n        // Carol and Dave are absent, and the pipeline handles them without a\n        // single null check in sight.\n        List.of(\"Alice\", \"Bob\", \"Carol\", \"Dave\")\n            .stream()\n            // A reference to a static method of this class: Class::method.\n            .map(OptionalDemo::formatEntry)\n            .forEach(System.out::println);\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
