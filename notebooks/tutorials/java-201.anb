    {
      "id": "j202-exceptions-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-exceptions-with-try-with-r\n//@ description: ☕ Java Mode — exceptions with try-with-resources\n// --- Java mode: try-with-resources, multi-catch, and finally ---\nimport java.io.*;\n\npublic class ExceptionDemo {\n    // 'throws' on an unchecked exception is documentation only - the compiler\n    // does not require callers to handle ArithmeticException. It is written\n    // here to make the contract visible to a reader.\n    static int divide(int a, int b) throws ArithmeticException {\n        if (b == 0) throw new ArithmeticException(\"Division by zero\");\n        return a / b;\n    }\n\n    static String readResource(String name) {\n        // try-with-resources: anything declared in these parentheses must\n        // implement AutoCloseable, and close() is called automatically when the\n        // block exits - normally, by return, or by an exception. That is what\n        // makes it strictly better than closing by hand in a finally block,\n        // where an exception thrown while closing can mask the original one.\n        try (var reader = new StringReader(\"Data from \" + name)) {\n            var buf = new char[50];\n            // read() fills the buffer and returns how many characters it\n            // actually got, which is not necessarily the buffer's length -\n            // hence the 0..n slice rather than new String(buf).\n            int n = reader.read(buf);\n            return new String(buf, 0, n);\n        } catch (IOException e) {\n            // IOException is CHECKED: the compiler insists it be caught or\n            // declared, because I/O failing is a normal fact of life.\n            return \"Error: \" + e.getMessage();\n        }\n    }\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(divide(10, 2));\n            System.out.println(divide(10, 0));   // throws; the line below never runs\n        // Multi-catch (Java 7+): one block for several unrelated types, so the\n        // shared handling is written once. Inside it, 'e' has the nearest\n        // common supertype of the listed exceptions.\n        } catch (ArithmeticException | IllegalArgumentException e) {\n            System.out.println(\"Caught: \" + e.getMessage());\n        } finally {\n            // finally runs whether the try succeeded, threw, or returned. It is\n            // for cleanup that try-with-resources cannot express.\n            System.out.println(\"(finally always runs)\");\n        }\n\n        System.out.println(readResource(\"config.txt\"));\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
