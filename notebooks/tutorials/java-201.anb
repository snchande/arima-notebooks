    {
      "id": "j202-exceptions-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode\n//@ description: 🔵 JShell Mode\n// --- JShell mode: catching what goes wrong ---\n\n// ArithmeticException is UNCHECKED (it extends RuntimeException), so the\n// compiler never forces you to handle it - integer division by zero is a bug\n// to be fixed, not a condition to be routinely expected. Note that this is an\n// integer-only rule: 10.0 / 0 quietly yields Infinity instead of throwing.\ntry {\n    int result = 10 / 0;\n} catch (ArithmeticException e) {\n    System.out.println(\"Caught: \" + e.getMessage());\n}\n\nString[] data = {\"42\", \"hello\", null};\nfor (var s : data) {\n    try {\n        int val = Integer.parseInt(s);\n        System.out.println(\"Parsed: \" + val);\n    // Several catch blocks are tested top to bottom, and the FIRST matching\n    // type wins - so more specific exception types must come before more\n    // general ones, or the general one would swallow everything.\n    } catch (NumberFormatException e) {\n        System.out.println(\"Not a number: \" + s);   // \"hello\" lands here\n    } catch (NullPointerException e) {\n        System.out.println(\"Null value!\");          // and null lands here\n    }\n}\n\n// Extending RuntimeException makes this unchecked too: callers may catch it,\n// but they are not forced to declare it. Extend Exception instead when the\n// caller genuinely has to make a decision about it.\nclass InsufficientFundsException extends RuntimeException {\n    InsufficientFundsException(double amount) {\n        // super(...) sets the message that getMessage() will return. Building\n        // it in the constructor keeps the wording in one place.\n        super(\"Insufficient funds: need $\" + amount);\n    }\n}\n\ntry {\n    throw new InsufficientFundsException(50.0);\n} catch (InsufficientFundsException e) {\n    System.out.println(\"Error: \" + e.getMessage());\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
