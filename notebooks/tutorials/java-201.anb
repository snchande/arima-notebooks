    {
      "id": "j202-lambdas-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-custom-functional-interfac\n//@ description: ☕ Java Mode — custom functional interface + strategy pattern\n// --- Java mode: writing your own functional interface ---\nimport java.util.*;\nimport java.util.function.*;\n\n// java.util.function does not have every shape. Transformer<T> is \"T in, same\n// T out\", which Function<T,T> could express but less readably in a signature.\n// @FunctionalInterface is optional but worth adding: it makes the compiler\n// reject a second abstract method, which would silently break every lambda.\n@FunctionalInterface\ninterface Transformer<T> {\n    T transform(T input);\n\n    // DEFAULT methods carry an implementation, so they do not count as the\n    // single abstract method. This is how an interface gains combinators\n    // without every implementer having to write them.\n    default Transformer<T> andThen(Transformer<T> next) {\n        // The returned lambda closes over 'this' and 'next', so composing is\n        // lazy: nothing is transformed until the result is actually called.\n        return input -> next.transform(this.transform(input));\n    }\n}\n\npublic class LambdaDemo {\n    public static void main(String[] args) {\n        // Each strategy is one line. Swapping behaviour now means swapping a\n        // value, not writing a subclass - that is the point of the pattern.\n        Transformer<String> trim  = String::strip;        // an instance method\n        Transformer<String> upper = String::toUpperCase;  // reference on the receiver\n        Transformer<String> excl  = s -> s + \"!\";\n\n        // Build the pipeline once; it is just another Transformer<String>.\n        var pipeline = trim.andThen(upper).andThen(excl);\n\n        List<String> inputs = List.of(\"  hello  \", \" world \", \" barista \");\n        inputs.stream()\n              // pipeline::transform is a reference to the method of THIS object -\n              // a bound method reference, capturing the pipeline instance.\n              .map(pipeline::transform)\n              .forEach(System.out::println);\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
