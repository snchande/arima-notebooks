    {
      "id": "fs201-md-1",
      "type": "MARKDOWN",
      "source": "# F# Advanced Patterns\n\nThis notebook covers:\n- `Option` and `Result` types for safe error handling\n- Computation expressions (`seq { }`, `async { }`)\n- Using NuGet packages in F# cells\n- Pipeline orchestration with `//@ anchor:` and `//@ depends:`\n\n## Pipeline annotations in F#\n\n```fsharp\n//@ anchor: myStep\n// code...\n```\n```fsharp\n//@ depends: myStep\n// runs after myStep\n```",
      "output": "",
      "executed": false
    },
    {
      "id": "fs201-option",
      "type": "CODE",
      "mode": "fsharp",
      "source": "//@ anchor: option-t-safe-nullable-values\n//@ description: Option<T> - safe nullable values\n// Option<'T> is F#'s answer to null. A value is either Some x or None, and the\n// two are different enough that the compiler makes you handle both - there is\n// no way to reach the x inside a Some without first admitting None is possible.\n// That is the whole trade: a little ceremony now, no NullReferenceException later.\nlet divide a b =\n    // `=` inside an expression is equality, not assignment. F# has no separate\n    // `==`, because binding is done with `let` and never with `=` alone.\n    if b = 0 then None\n    else Some (a / b)\n\n// `divide 100` is partial application: divide takes two arguments one at a time,\n// so supplying only the first yields a new function awaiting the second. That is\n// what List.map receives - a ready-made \"100 divided by ...\" function.\nlet results = [10; 0; 5; 0; 2] |> List.map (divide 100)\n\n// iteri is iter with the index passed alongside each element.\nresults |> List.iteri (fun i r ->\n    // Matching on an Option is how you open it. The Some branch names the value\n    // inside; the None branch has nothing to name. Drop either one and the\n    // compiler warns the match is incomplete.\n    match r with\n    | Some v -> printfn \"100 / divisor[%d] = %d\" i v\n    | None   -> printfn \"100 / divisor[%d] = undefined (div by zero)\" i)\n\n// The annotation (x: float) is needed here: sqrt is generic over numeric types,\n// so without it F# cannot decide which one this function is for.\nlet safeSqrt (x: float) =\n    if x < 0.0 then None else Some (sqrt x)\n\n// Option.map applies a function to the value *if* there is one, and passes None\n// straight through untouched - so the sprintf never has to consider failure.\n// defaultValue then unwraps the Option, supplying a fallback for the None case.\n// Together they replace the whole match above when you only need one branch's value.\nlet display = safeSqrt 16.0 |> Option.map (sprintf \"sqrt = %.2f\") |> Option.defaultValue \"invalid\"\nprintfn \"%s\" display",
      "output": "",
      "executed": false,
      "anchor": "option-t-safe-nullable-values",
      "description": "Option<T> — safe nullable values"
    },
    {
      "id": "fs201-result",
      "type": "CODE",
      "mode": "fsharp",
      "source": "//@ anchor: result-t-e-explicit-success-failure\n//@ description: Result<'T,'E> - explicit success/failure\n// Result<'T,'E> is Option with a reason attached: Ok carries the value, Error\n// carries an explanation. Reach for it when the caller needs to know *why*\n// something failed, not merely that it did.\n// Modelling the failures as their own union - rather than as strings - means\n// the compiler can check that every error a caller handles actually exists.\ntype ParseError = | EmptyInput | NotANumber of string | OutOfRange of int\n\n// The return annotation is optional but earns its place on a public function:\n// it states the contract without the reader having to infer it.\nlet parsePositiveInt (s: string) : Result<int, ParseError> =\n    if System.String.IsNullOrWhiteSpace(s) then Error EmptyInput\n    else\n        // .NET's TryParse returns a bool and sets an out parameter. F# folds\n        // that pattern into a tuple, so it can be matched directly.\n        match System.Int32.TryParse(s) with\n        | false, _  -> Error (NotANumber s)\n        // A `when` clause adds a condition to a pattern. Order matters: this\n        // branch must come before the plain `true, n` case, or that one would\n        // catch every success first.\n        | true, n when n <= 0 -> Error (OutOfRange n)\n        | true, n   -> Ok n\n\nlet inputs = [\"42\"; \"\"; \"abc\"; \"-5\"; \"100\"]\n\ninputs |> List.iter (fun s ->\n    match parsePositiveInt s with\n    | Ok n      -> printfn \"'%s' -> Ok(%d)\" s n\n    // %A prints the error case with the data it carries, so OutOfRange -5 shows\n    // both which rule was broken and the value that broke it.\n    | Error err -> printfn \"'%s' -> Error(%A)\" s err)",
      "output": "",
      "executed": false,
      "anchor": "result-t-e-explicit-success-failure",
      "description": "Result<'T,'E> — explicit success/failure"
    },
    {
      "id": "fs201-seq",
      "type": "CODE",
      "mode": "fsharp",
      "source": "//@ anchor: sequence-expressions-lazy-evaluation\n//@ description: Sequence expressions - lazy evaluation\n// A seq is lazy: elements are produced on demand, never stored in full. That is\n// what makes an endless sequence a sensible thing to write down.\n// Seq.unfold grows one from a seed. The function receives the current state and\n// returns Some (elementToEmit, nextState), or None to stop. Here the state is\n// the pair of consecutive Fibonacci numbers, so each step emits `a` and slides\n// the window forward to (b, a + b). It never returns None - the sequence is\n// infinite, and only the consumer decides when to stop.\nlet fibonacci =\n    Seq.unfold (fun (a, b) -> Some (a, (b, a + b))) (0, 1)\n\n// Seq.take asks for exactly 20; toList then forces those 20 and nothing more.\n// Without a take, this would run forever.\nlet fibs20 = fibonacci |> Seq.take 20 |> Seq.toList\nprintfn \"First 20 Fibonacci: %A\" fibs20\n\n// A `seq { }` computation expression is the general form: ordinary control flow\n// where `yield` emits an element. Execution suspends at each yield and resumes\n// when the consumer asks for the next one.\nlet primes =\n    // The set lives outside the seq block so it persists across resumptions -\n    // it is the sieve's memory of composites already crossed off.\n    let sieve = System.Collections.Generic.HashSet<int>()\n    seq {\n        for n in 2 .. 1000 do\n            if not (sieve.Contains n) then\n                yield n\n                // n*2 .. n .. 1000 is a stepped range: start, step, stop.\n                // HashSet.Add returns a bool F# would otherwise force you to\n                // handle; `ignore` is the explicit \"yes, discard this\".\n                for m in n*2 .. n .. 1000 do sieve.Add(m) |> ignore\n    }\n\n// Only the first 15 primes are ever computed - the loop above stops as soon as\n// the consumer stops pulling.\nlet first15primes = primes |> Seq.take 15 |> Seq.toList\nprintfn \"First 15 primes: %A\" first15primes",
      "output": "",
      "executed": false,
      "anchor": "sequence-expressions-lazy-evaluation",
      "description": "Sequence expressions — lazy evaluation"
    },
    {
      "id": "fs201-md-nuget",
      "type": "MARKDOWN",
      "source": "## Using NuGet Packages\n\nInstall packages via **Packages → NuGet** tab, or add `#r \"nuget: PackageId, Version\"` directly in a cell.\n\nThe example below uses **Humanizer** to format numbers and dates in human-readable form.\n\n> Install: `Humanizer.Core` version `2.14.1` in the NuGet tab first.",
      "output": "",
      "executed": false
    },
    {
      "id": "fs201-nuget",
      "type": "CODE",
      "mode": "fsharp",
      "source": "//@ anchor: humanizer-core-is-loaded-inline-no-nu-g\n//@ description: Humanizer.Core is loaded inline - no NuGet tab install needed:\n// #r \"nuget: ...\" is an F# Interactive directive, not code: it tells the script\n// engine to fetch the package and reference it before compiling the rest of the\n// cell. Pinning the version keeps the notebook reproducible.\n#r \"nuget: Humanizer.Core, 2.14.1\"\n\n// `open` is F#'s import. Humanizer works by extension methods, so opening the\n// namespace is what makes .Bytes() and .Humanize() appear on existing types.\nopen Humanizer\n\nlet sizes = [1; 1024; 1048576; 1073741824]\nlet dates = [System.DateTime.Now.AddDays(-1.0); System.DateTime.Now.AddHours(-3.0); System.DateTime.Now.AddMinutes(-5.0)]\n\n// s.Bytes() reads the int as a quantity of bytes; Humanize() then picks the\n// largest sensible unit. Note this is a display concern only - the underlying\n// value is untouched.\nfor s in sizes do\n    printfn \"%d bytes = %s\" s (s.Bytes().Humanize())\n\nprintfn \"\"\n\n// Humanize on a DateTime measures the gap to now and words it relatively,\n// which is why these lines read \"yesterday\" rather than showing a timestamp.\nfor d in dates do\n    printfn \"%s\" (d.Humanize())",
      "output": "",
      "executed": false,
      "anchor": "humanizer-core-is-loaded-inline-no-nu-g",
      "description": "Humanizer.Core is loaded inline — no NuGet tab install needed:"
    },
    {
      "id": "fs201-pipeline-md",
      "type": "MARKDOWN",
      "source": "## F# Pipeline Orchestration\n\nAnnotate cells to create a multi-step data pipeline.",
      "output": "",
      "executed": false
    },
    {
      "id": "fs201-load",
      "type": "CODE",
      "mode": "fsharp",
      "anchor": "fs_loadData",
      "source": "//@ anchor: fs_loadData\n//@ description: Declares transactions variable\n// Step 1 of the pipeline: define the row shape, then the rows.\n// Records give this dataset field names the compiler enforces, so a later step\n// asking for t.Catagory fails to build rather than silently summing nothing.\ntype Transaction = { Id: int; Category: string; Amount: decimal; Month: int }\n\n// Semicolons separate fields on one line; a newline separates list elements.\n// Amounts are decimal (the `m` suffix) - the correct choice for money.\nlet transactions = [\n    { Id=1; Category=\"Food\";      Amount=85.50m;  Month=1 }\n    { Id=2; Category=\"Transport\"; Amount=42.00m;  Month=1 }\n    { Id=3; Category=\"Food\";      Amount=120.30m; Month=2 }\n    { Id=4; Category=\"Utilities\"; Amount=95.00m;  Month=1 }\n    { Id=5; Category=\"Food\";      Amount=75.20m;  Month=3 }\n    { Id=6; Category=\"Transport\"; Amount=38.50m;  Month=2 }\n    { Id=7; Category=\"Utilities\"; Amount=102.00m; Month=2 }\n    { Id=8; Category=\"Food\";      Amount=90.10m;  Month=3 }\n]\n\n// This binding survives the cell. The next step declares //@ depends: fs_loadData,\n// which is what lets Arima guarantee this cell has run before that one reads it.\nprintfn \"Loaded %d transactions\" (List.length transactions)",
      "output": "",
      "executed": false,
      "description": "Declares transactions variable"
    },
    {
      "id": "fs201-analyze",
      "type": "CODE",
      "mode": "fsharp",
      "anchor": "fs_analyzeSpend",
      "source": "//@ anchor: fs_analyzeSpend\n//@ depends: fs_loadData\n//@ description: Declares byCategory variable\n// Step 2: the whole aggregation is one left-to-right pipeline. Read it as a\n// sentence - take the transactions, group them, total each group, sort the\n// totals - which is exactly the order the work happens in.\nlet byCategory =\n    transactions\n    // groupBy yields (key, members) tuples: the category, then its transactions.\n    |> List.groupBy (fun t -> t.Category)\n    |> List.map (fun (cat, ts) ->\n        // sumBy adds the projected field rather than the elements themselves,\n        // so no intermediate list of amounts is built.\n        // The result is a (category, total) tuple, collapsing each group to a row.\n        cat, ts |> List.sumBy (fun t -> t.Amount))\n    // `snd` is the built-in \"second element of a tuple\", so this sorts by total.\n    // Passing the function by name instead of writing (fun (_, t) -> t) is the\n    // idiomatic form and says the same thing.\n    |> List.sortByDescending snd\n\nprintfn \"Spending by category:\"\n\n// printfn has no thousands-separator specifier, so this borrows .NET's\n// String.Format, where {0:N2} groups the digits and fixes two decimals.\nbyCategory |> List.iter (fun (cat, total) ->\n    printfn \"  %-12s $%s\" cat (System.String.Format(\"{0:N2}\", total)))",
      "output": "",
      "executed": false,
      "description": "Declares byCategory variable"
    },
    {
      "id": "fs201-pipeline",
      "type": "CODE",
      "mode": "fsharp",
      "source": "//@ pipeline: F# Spending Analysis\n//@ steps: fs_loadData, fs_analyzeSpend\n//@ description: Load and analyse transaction data\n// A pipeline cell carries no code - the //@ steps: line above is the whole cell.\n// Arima resolves the named anchors, reads each cell's //@ depends: declarations,\n// and runs them in dependency order. Listing the steps records the intent; the\n// declared dependencies are what actually determine the schedule.\n// Press Run Pipeline to execute the graph.",
      "output": "",
      "executed": false
    }
