    {
      "id": "jshell-101-arithmetic",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: arithmetic-operators\n//@ description: Arithmetic operators\n// --- Arithmetic operators ---\n// The five standard operators, plus the one rule that catches everyone out:\n// dividing two ints gives an int, and the remainder is thrown away.\n\nint a = 17;\nint b = 5;\n\n// The inner parentheses matter. Without them, \"a + b  = \" + a would already have\n// produced a String, and + b would append \"5\" instead of adding.\nSystem.out.println(\"a + b  = \" + (a + b));   // 22  addition\nSystem.out.println(\"a - b  = \" + (a - b));   // 12  subtraction\nSystem.out.println(\"a * b  = \" + (a * b));   // 85  multiplication\nSystem.out.println(\"a / b  = \" + (a / b));   // 3   int / int is an int - 3.4 truncates to 3\nSystem.out.println(\"a % b  = \" + (a % b));   // 2   modulus: what is left over, 17 - (3 * 5)\n\n// Casting ONE operand to double is enough: Java promotes the other one to match,\n// and the division is then done in floating point.\ndouble exactDiv = (double) a / b;\nSystem.out.println(\"(double)a / b = \" + exactDiv);  // 3.4\n\n// Compound assignment: read the variable, apply the operator, store it back.\nint counter = 10;\ncounter += 5;   // exactly the same as: counter = counter + 5   -> 15\ncounter *= 2;   // exactly the same as: counter = counter * 2   -> 30\nSystem.out.println(\"counter after += 5, *= 2: \" + counter);  // 30",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
