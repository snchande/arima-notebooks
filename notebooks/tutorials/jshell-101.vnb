    {
      "id": "jshell-101-conditionals",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: conditionals-if-else-and-the-ternary-ope\n//@ description: Conditionals: if/else and the ternary operator\n// --- Conditionals: if/else and the ternary operator ---\n// Every cell in this notebook shares one JShell session, so `name` and `score` from\n// the first cell are still here.\n\nint temperature = 22;\n\n// The branches are tested in order and the FIRST match wins - which is why each\n// condition only needs to rule out the ones above it (< 15 already implies >= 0).\nif (temperature < 0) {\n    System.out.println(\"Freezing! Bundle up.\");\n} else if (temperature < 15) {\n    System.out.println(\"Cold. Wear a jacket.\");\n} else if (temperature < 25) {\n    System.out.println(\"Comfortable. Enjoy the day!\");\n} else {\n    // else has no condition: it catches everything left over.\n    System.out.println(\"Hot! Stay hydrated.\");\n}\n\n// The ternary operator is an if/else that produces a VALUE, so it can be assigned.\n// && is logical AND, and it short-circuits: if the left side is false the right side\n// is never evaluated.\nString verdict = (temperature >= 15 && temperature <= 25) ? \"pleasant\" : \"extreme\";\nSystem.out.println(\"The weather is \" + verdict + \" (\" + temperature + \" C)\");\n\nSystem.out.println();               // println() with no argument prints a blank line\nSystem.out.println(\"=== Score Report ===\");\nSystem.out.printf(\"Student: %s%n\", name);    // name came from the first cell\nSystem.out.printf(\"Score  : %d%n\", score);\n\n// Ternaries chain: each colon is followed by the next test, so this reads as\n// \"A if >= 90, otherwise B if >= 80, otherwise ... otherwise F\".\nString letterGrade = score >= 90 ? \"A\" : score >= 80 ? \"B\" : score >= 70 ? \"C\" : score >= 60 ? \"D\" : \"F\";\nSystem.out.printf(\"Grade  : %s%n\", letterGrade);",
      "output": "",
