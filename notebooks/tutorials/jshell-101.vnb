    {
      "id": "jshell-101-vars",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: declaring-variables\n//@ description: Declaring variables\n// --- Declaring variables ---\n// Java is statically typed: every variable has one fixed type, decided when it is\n// declared and checked by the compiler at every use. The type comes first, then the\n// name, then the value - or you can write 'var' and let the compiler work it out.\n\nint age = 28;                        // int    - a whole number, 32 bits, about +/-2.1 billion\ndouble salary = 95_000.50;           // double - 64-bit floating point. The underscores are\n                                     //          purely for readability; Java ignores them\nboolean isActive = true;             // boolean - only ever true or false (no 0/1 as in C)\nchar grade = 'A';                    // char   - ONE Unicode character, in SINGLE quotes\nString name = \"Alice\";               // String - a class, not a primitive, so DOUBLE quotes\n\n// 'var' (Java 10+) infers the type from the right-hand side. The variable is still\n// statically typed - city really is a String - you just did not have to write it.\nvar city = \"San Francisco\";          // inferred as String\nvar score = 42;                      // inferred as int\n\n// The + operator concatenates when either side is a String: the number is converted\n// to text automatically. println writes the line and moves to the next one.\nSystem.out.println(\"Name   : \" + name);\nSystem.out.println(\"Age    : \" + age);\nSystem.out.println(\"Salary : \" + salary);\nSystem.out.println(\"Active : \" + isActive);\nSystem.out.println(\"Grade  : \" + grade);\nSystem.out.println(\"City   : \" + city + \"  Score: \" + score);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "declaring-variables",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Declaring variables"
