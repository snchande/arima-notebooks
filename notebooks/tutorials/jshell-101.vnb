    {
      "id": "jshell-101-casting",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: type-casting\n//@ description: Type casting\n// --- Type casting ---\n// Widening (small type -> large type) is automatic: nothing can be lost.\n// Narrowing (large type -> small type) must be written out, because something can be.\n\nint intVal = 42;\ndouble wideDouble = intVal;              // widening: int -> double, no cast needed\nSystem.out.println(\"int -> double (widening): \" + wideDouble);  // 42.0\n\ndouble piApprox = 3.99999;\n// The (int) cast TRUNCATES towards zero - it does not round. 3.99999 becomes 3.\n// Use Math.round() when you want 4.\nint narrowedInt = (int) piApprox;\nSystem.out.println(\"double -> int (narrowing, truncates): \" + narrowedInt);  // 3\n\n// Parsing is a different thing entirely: a String is not a number, so no cast can\n// convert it. These static methods read the text and produce a value.\nString numberStr = \"123\";\nint parsed = Integer.parseInt(numberStr);              // throws NumberFormatException on \"abc\"\ndouble parsedDouble = Double.parseDouble(\"3.14159\");\nSystem.out.println(\"Parsed int    : \" + parsed);\nSystem.out.println(\"Parsed double : \" + parsedDouble);\n\n// And back the other way. String.valueOf() accepts any type, which makes it the\n// safest default; Integer.toString(parsed) does the same job for ints.\nString backToString = String.valueOf(parsed);\n// getClass().getSimpleName() asks the object what type it actually is at runtime -\n// proof that this really is a String now, not an int.\nSystem.out.println(\"Back to string: '\" + backToString + \"'  (type: \" + backToString.getClass().getSimpleName() + \")\");",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
