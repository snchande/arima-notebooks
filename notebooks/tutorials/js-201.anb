    {
      "id": "js-201-classes",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: classes\n//@ description: Classes\n// --- Classes ---\n// WHY: ES6 classes are syntactic sugar over prototype-based inheritance.\n// They make OOP patterns much more readable without changing the underlying model.\n\nclass Animal {\n    // '#' marks a genuinely private field (ES2022). Unlike a leading underscore\n    // convention, the privacy is enforced by the language: reading obj.#name\n    // from outside the class body is a syntax error, not a runtime slip.\n    #name;      // private field (ES2022) - only accessible inside this class\n    #sound;\n\n    constructor(name, sound) {\n        this.#name  = name;\n        this.#sound = sound;\n        this.energy = 100;   // public: just a normal property on the instance\n    }\n\n    // Methods live on the prototype, so all instances share one copy rather than\n    // each object carrying its own function.\n    speak() {\n        console.log(`${this.#name} says: ${this.#sound}!`);\n    }\n\n    eat(food) {\n        this.energy += 10;\n        console.log(`${this.#name} eats ${food}. Energy: ${this.energy}`);\n    }\n\n    // A getter is read like a property (obj.name), not called like a method.\n    // Here it exposes the private field for reading without allowing writes.\n    get name() { return this.#name; }   // getter\n\n    // 'static' attaches the method to the class itself, not to instances, so it\n    // is called as Animal.create(...). Useful for named alternatives to 'new'.\n    static create(name, sound) {        // static factory method\n        return new Animal(name, sound);\n    }\n}\n\nclass Dog extends Animal {\n    constructor(name) {\n        // super() runs the parent constructor. JavaScript refuses to let you\n        // touch 'this' before it, because the object is not initialised yet.\n        super(name, 'Woof');    // must call super() before using 'this'\n        this.tricks = [];\n    }\n\n    learn(trick) {\n        // 'this.name' reaches the inherited getter - Dog cannot see #name directly,\n        // since private fields are not inherited into the subclass body.\n        this.tricks.push(trick);\n        console.log(`${this.name} learned: ${trick}`);\n    }\n\n    // Redefining speak() overrides the parent version for Dog instances.\n    speak() {\n        super.speak();          // call parent method\n        console.log(`${this.name} wags tail.`);\n    }\n}\n\nconst cat = Animal.create('Whiskers', 'Meow');\ncat.speak();\ncat.eat('tuna');\n\nconst dog = new Dog('Rex');\ndog.speak();                 // Dog's override runs, which calls Animal's via super\ndog.learn('sit');\ndog.learn('shake');\nconsole.log('tricks:', dog.tricks);\n// instanceof walks the prototype chain, so a Dog is also an Animal.\nconsole.log('is Animal:', dog instanceof Animal);",
      "output": "",
      "returnValue": null,
