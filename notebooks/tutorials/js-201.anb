    {
      "id": "js-201-destructuring",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: destructuring\n//@ description: Destructuring\n// --- Destructuring ---\n// WHY: Unpacking values from arrays/objects into named variables cleanly.\n// Reduces boilerplate and makes intent clearer.\n\n// Array destructuring\n// Arrays destructure BY POSITION, so the names on the left are yours to choose.\nconst rgb = [255, 128, 0];\nconst [red, green, blue] = rgb;\nconsole.log(`R:${red} G:${green} B:${blue}`);\n\n// Skip elements with commas\n// The empty slot means \"consume this position but bind nothing\".\nconst [first, , third] = ['a', 'b', 'c'];\nconsole.log('first:', first, ' third:', third);\n\n// Swap variables without a temp\nlet x = 1, y = 2;\n// The right side builds [2, 1] first, then destructures it back into x and y,\n// so no temporary variable is needed. The leading semicolon habit matters here:\n// a line starting with '[' can otherwise be parsed as indexing the line above.\n[x, y] = [y, x];\nconsole.log('swapped x:', x, ' y:', y);\n\n// Object destructuring\n// Objects destructure BY NAME, so the names must match the property keys.\nconst user = { name: 'Bob', age: 25, city: 'Austin', role: 'admin' };\nconst { name, age, city } = user;\nconsole.log(`${name}, ${age}, from ${city}`);\n\n// Rename while destructuring\n// Read 'name: userName' as \"take property name, call it userName here\".\nconst { name: userName, role: userRole } = user;\nconsole.log(`userName: ${userName}  role: ${userRole}`);\n\n// Default values\n// A default applies only when the property is missing or undefined - not when it\n// is 0, '' or null. 'theme' and 'lang' are absent on user, so both defaults fire.\nconst { name: n2, theme = 'light', lang = 'en' } = user;\nconsole.log(`theme: ${theme}  lang: ${lang}`);\n\n// Nested destructuring\n// 'customer: { name: custName, email }' descends into the nested object; note\n// that 'customer' itself is NOT bound as a variable - it is only a path.\nconst order = { id: 42, customer: { name: 'Alice', email: 'a@b.com' }, total: 99.99 };\nconst { id, customer: { name: custName, email }, total } = order;\nconsole.log(`Order #${id} by ${custName} (${email}) — $${total}`);",
      "output": "",
      "returnValue": null,
