    {
      "id": "js-201-async",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: promises-and-async-await\n//@ description: Promises and async/await\n// --- Promises and async/await ---\n// WHY: JavaScript is single-threaded. Async operations (I/O, timers, network)\n// use callbacks, which nest deeply ('callback hell'). Promises flatten this.\n// async/await makes async code look and behave like synchronous code.\n\n// A Promise represents a value that will be available in the future.\n// States: pending -> fulfilled (resolved) or rejected. A promise settles once\n// and keeps its result; calling resolve twice has no further effect.\nconst fetchUser = (id) => new Promise((resolve, reject) => {\n    // The executor function runs IMMEDIATELY and synchronously. It receives two\n    // callbacks: resolve for success, reject for failure.\n    // Simulate async work with setTimeout\n    setTimeout(() => {\n        if (id > 0) {\n            resolve({ id, name: `User ${id}`, email: `user${id}@example.com` });\n        } else {\n            // Reject with an Error, not a string - Errors carry a stack trace.\n            reject(new Error(`Invalid user id: ${id}`));\n        }\n    }, 10);   // 10ms delay to simulate async\n});\n\n// Promise chaining with .then() / .catch()\nfetchUser(1)\n    .then(user => {\n        console.log('Fetched:', user.name);\n        // Returning a promise from .then() flattens the chain: the next .then()\n        // waits for it rather than receiving the promise object itself.\n        return fetchUser(2);         // chain: return another promise\n    })\n    .then(user => console.log('Also fetched:', user.name))\n    // One .catch() at the end covers every step above it - rejections propagate\n    // down the chain until something handles them.\n    .catch(err => console.error('Error:', err.message));\n\n// async/await - cleaner syntax for the same thing\nasync function loadUsers() {\n    // 'await' only works inside an async function; try/catch around it converts\n    // a rejected promise into an ordinary thrown exception you can catch here.\n    try {\n        // These two awaits run one AFTER the other: u2 does not start until u1\n        // has resolved. That is correct when the second depends on the first,\n        // and wasteful when it does not.\n        const u1 = await fetchUser(1);\n        const u2 = await fetchUser(2);\n        console.log('\\nasync/await result:');\n        console.log(` ${u1.name} | ${u1.email}`);\n        console.log(` ${u2.name} | ${u2.email}`);\n\n        // Run both in PARALLEL with Promise.all\n        // Both calls are started before the await, so the wait is one delay, not\n        // two. Promise.all rejects as soon as any single promise rejects.\n        const [u3, u4] = await Promise.all([fetchUser(3), fetchUser(4)]);\n        console.log(`\\nParallel fetch: ${u3.name}, ${u4.name}`);\n    } catch (err) {\n        console.error('loadUsers error:', err.message);\n    }\n}\n\n// An async function always returns a promise. Nothing awaits this call, so it\n// just schedules the work; Node stays alive until the pending timers fire.\nloadUsers();",
      "output": "",
