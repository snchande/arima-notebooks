{
  "id": "js-201",
  "name": "JavaScript 201 — Modern ES6+ Features",
  "description": "A practical tour of ES6+ JavaScript: let/const, arrow functions, template literals, destructuring, default/rest/spread, classes, Promises, and async/await.",
  "created": "2026-03-29T00:00:00",
