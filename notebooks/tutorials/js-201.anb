    {
      "id": "js-201-template-literals",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: template-literals\n//@ description: Template Literals\n// --- Template Literals ---\n// WHY: String concatenation with + is error-prone and hard to read.\n// Template literals (backtick strings) support embedded expressions and newlines.\n\nconst name = 'Alice';\nconst age  = 30;\nconst balance = 1234.56;\n\n// Embedded expressions with ${...}\n// Whatever is inside ${} is evaluated and converted to a string.\nconst greeting = `Hello, ${name}! You are ${age} years old.`;\nconsole.log(greeting);\n\n// Multi-line strings - newlines are literal\n// A backtick string keeps every line break exactly as typed, so the leading and\n// trailing newlines below are part of the value.\nconst receipt = `\n=== Account Summary ===\nName    : ${name}\nAge     : ${age}\nBalance : $${balance.toFixed(2)}\nStatus  : ${balance > 1000 ? 'Gold Member' : 'Standard'}\n`;\n// The two $ above are different: the first is a literal dollar sign, the second\n// opens the ${...} placeholder. toFixed(2) returns a string, not a number.\n// `cond ? a : b` is the ternary operator - an if/else that yields a value, which\n// is what lets it live inside a template.\nconsole.log(receipt);\n\n// Expressions inside ${} can be anything\nconst items = ['Widget', 'Gadget', 'Doohickey'];\n// A nested ternary handles the plural 's' inline.\nconsole.log(`Cart has ${items.length} item${items.length !== 1 ? 's' : ''}.`);\nconsole.log(`Items: ${items.join(', ')}`);\n\n// Tagged template literals (advanced): a function processes the template\n// The tag receives the fixed text pieces as `strings` and the interpolated\n// values as rest arguments, so it can escape, translate or decorate them.\nfunction highlight(strings, ...values) {\n    // There is always one more text piece than value, hence the undefined guard.\n    return strings.reduce((result, str, i) =>\n        result + str + (values[i] !== undefined ? `[${values[i]}]` : ''), '');\n}\nconst product = 'Widget';\nconst price   = 9.99;\n// No parentheses: the backtick string itself is the argument list.\nconsole.log(highlight`Buy ${product} for $${price} today!`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "template-literals",
