    {
      "id": "j401-mcp-demo",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: mcp-demo\n//@ depends: imports\n//@ description: Demonstrate MCP server connectivity via HTTP\n\n// Arima's MCP server is plain HTTP, so a JShell cell can talk to the very\n// server that is running it. Nothing here is special to Arima - this is how\n// any MCP client would speak to any MCP server.\nimport java.net.http.*;\nimport java.net.URI;\n\n// HttpClient is the JDK's built-in client (Java 11+). One instance is meant to\n// be reused; it owns a connection pool.\nvar client = HttpClient.newHttpClient();\n\n// MCP speaks JSON-RPC 2.0: an envelope of jsonrpc/id/method/params. The id is\n// what lets a client match a reply to its request when several are in flight.\n// The \\\" sequences are escaped quotes - a JSON string living inside a Java one.\nvar listToolsBody = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"tools/list\\\",\\\"params\\\":{}}\";\n\n// The builder pattern again: each call returns the builder, and build() freezes\n// an immutable HttpRequest.\nvar request = HttpRequest.newBuilder()\n    .uri(URI.create(\"http://localhost:8585/api/mcp/messages\"))\n    .header(\"Content-Type\", \"application/json\")\n    .POST(HttpRequest.BodyPublishers.ofString(listToolsBody))\n    .build();\n\n// send() is the blocking call; sendAsync() would return a CompletableFuture.\n// BodyHandlers.ofString says \"decode the response body into a String\".\nvar response = client.send(request, HttpResponse.BodyHandlers.ofString());\nSystem.out.println(\"MCP tools/list response (status \" + response.statusCode() + \"):\");\n\n// Scanning for \"name\": by hand is deliberately crude - it keeps this cell free\n// of a JSON library. Real client code should parse properly instead; string\n// scanning breaks the moment a tool description happens to contain the word.\nvar body = response.body();\nint idx = 0;\n// indexOf returns -1 when there is no further match, which is what ends the loop.\nwhile ((idx = body.indexOf(\"\\\"name\\\":\", idx)) != -1) {\n    int start = body.indexOf(\"\\\"\", idx + 7) + 1;  // 7 = length of the key \"name\":\n    int end = body.indexOf(\"\\\"\", start);          // up to the closing quote\n    if (start > 0 && end > start) {\n        String name = body.substring(start, end);\n        if (name.startsWith(\"barista_\")) System.out.println(\"  Tool: \" + name);\n    }\n    idx = end + 1;   // advance past this match, or the loop would never finish\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": 18,
      "error": "",
      "anchor": "mcp-demo",
      "dependsOn": [
        "imports"
