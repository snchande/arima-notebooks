    {
      "id": "jshell-301-flatmap",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: flat-map-flatten-nested-structures\n//@ description: flatMap - flatten nested structures\nimport java.util.List;\nimport java.util.stream.Collectors;\nimport java.util.stream.Stream;\n\n// --- flatMap - flatten nested structures ---\n// map turns each element into ONE new element. flatMap turns each element into a\n// STREAM of elements and splices them all together, so one input can yield many\n// outputs - or none.\n\nList<List<Integer>> nested = List.of(\n    List.of(1, 2, 3),\n    List.of(4, 5),\n    List.of(6, 7, 8, 9)\n);\n\n// .map(List::stream) would give Stream<Stream<Integer>> - a stream of streams, which\n// is almost never what you want. flatMap unwraps one level, giving Stream<Integer>.\nList<Integer> flat = nested.stream()\n    .flatMap(List::stream)\n    .collect(Collectors.toList());\nSystem.out.println(\"Flattened: \" + flat);\n\n// The same shape appears whenever one item expands into several - here, one sentence\n// into many words.\nList<String> sentences = List.of(\n    \"the quick brown fox\",\n    \"jumps over the lazy dog\"\n);\n\nList<String> allWords = sentences.stream()\n    // split() returns String[], so Stream.of() turns that array into a stream for\n    // flatMap to splice in.\n    .flatMap(s -> Stream.of(s.split(\" \")))\n    .distinct()      // \"the\" appears in both sentences; keep it once\n    .sorted()\n    .collect(Collectors.toList());\nSystem.out.println(\"Unique words: \" + allWords);\nSystem.out.println(\"Word count  : \" + allWords.size());",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "flat-map-flatten-nested-structures",
