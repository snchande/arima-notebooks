    {
      "id": "jshell-301-collectors",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: collectors-grouping-by-split-a-stream-in\n//@ description: Collectors.groupingBy - split a stream into groups\nimport java.util.List;\nimport java.util.Map;\nimport java.util.stream.Collectors;\n\n// --- Collectors.groupingBy - split a stream into groups ---\n// groupingBy(classifier) runs the classifier on every element and files each one\n// under the value it returns, producing Map<key, List<element>>.\n\n// A record is a compact immutable data class: Java generates the constructor,\n// accessors (name(), dept(), salary()), equals, hashCode and toString for you.\nrecord Employee(String name, String dept, double salary) {}\n\nList<Employee> employees = List.of(\n    new Employee(\"Alice\",   \"Engineering\", 120_000),\n    new Employee(\"Bob\",     \"Marketing\",    85_000),\n    new Employee(\"Charlie\", \"Engineering\", 110_000),\n    new Employee(\"Diana\",   \"Marketing\",    90_000),\n    new Employee(\"Eve\",     \"Engineering\", 135_000),\n    new Employee(\"Frank\",   \"HR\",           75_000),\n    new Employee(\"Grace\",   \"HR\",           80_000)\n);\n\n// Employee::dept is a method reference to the record's accessor - the classifier.\nMap<String, List<Employee>> byDept = employees.stream()\n    .collect(Collectors.groupingBy(Employee::dept));\n\nSystem.out.println(\"=== Employees by Department ===\");\n// Map.forEach hands the lambda both the key and the value.\nbyDept.forEach((dept, emps) -> {\n    System.out.println(dept + \":\");\n    emps.forEach(e -> System.out.printf(\"  %-10s $%.0f%n\", e.name(), e.salary()));\n});\n\n// The two-argument form takes a DOWNSTREAM collector that reduces each group instead\n// of listing it. counting() replaces each List with its size.\nMap<String, Long> countByDept = employees.stream()\n    .collect(Collectors.groupingBy(Employee::dept, Collectors.counting()));\nSystem.out.println(\"\\nHeadcount: \" + countByDept);\n\n// Same shape, different downstream collector: the mean of one field per group.\nMap<String, Double> avgSalary = employees.stream()\n    .collect(Collectors.groupingBy(Employee::dept,\n             Collectors.averagingDouble(Employee::salary)));\nSystem.out.println(\"Avg salary:\");\navgSalary.forEach((dept, avg) -> System.out.printf(\"  %-12s $%.0f%n\", dept, avg));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "collectors-grouping-by-split-a-stream-in",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Collectors.groupingBy — split a stream into groups"
    },
    {
      "id": "jshell-301-optional",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: optional-null-safe-wrappers\n//@ description: Optional - null-safe wrappers\nimport java.util.Optional;\nimport java.util.List;\n\n// --- Optional - null-safe wrappers ---\n// Optional<T> is a box that either holds a value or is empty. Returning one instead\n// of null moves \"there might be nothing here\" from a runtime surprise into the type,\n// where the compiler makes the caller deal with it.\n\nOptional<String> present = Optional.of(\"hello\");         // throws if given null\nOptional<String> empty   = Optional.empty();             // deliberately holds nothing\nOptional<String> maybe   = Optional.ofNullable(null);    // null -> empty, no exception\n\nSystem.out.println(\"present.isPresent()  : \" + present.isPresent());\nSystem.out.println(\"empty.isEmpty()      : \" + empty.isEmpty());\n// get() throws NoSuchElementException when empty - safe here, but orElse is better.\nSystem.out.println(\"present.get()        : \" + present.get());\n\n// orElse takes a ready-made fallback; orElseGet takes a lambda that is only called\n// when the Optional is actually empty. Prefer orElseGet when the fallback is costly.\nString val1 = empty.orElse(\"default\");\nString val2 = empty.orElseGet(() -> \"computed-\" + System.currentTimeMillis());\nSystem.out.println(\"orElse               : \" + val1);\nSystem.out.println(\"orElseGet            : \" + val2);\n\n// map applies the function ONLY if a value is present, and rewraps the result -\n// so a chain of maps never needs a null check in the middle.\nOptional<Integer> length = present.map(String::length);  // Optional[5]\nSystem.out.println(\"map to length        : \" + length.orElse(0));\n\n// filter empties the Optional when the predicate fails.\nOptional<String> filtered = present.filter(s -> s.startsWith(\"h\"));\nSystem.out.println(\"filter startsWith h  : \" + filtered.orElse(\"no match\"));\n\n// This is where you meet Optional in practice: findFirst() cannot promise a match,\n// so it returns one. findFirst also SHORT-CIRCUITS - it stops at the first hit.\nList<String> names = List.of(\"Charlie\", \"Alice\", \"Bob\", \"Diana\");\nString first = names.stream()\n    .filter(n -> n.startsWith(\"A\"))\n    .findFirst()\n    .orElse(\"not found\");\nSystem.out.println(\"First name with A    : \" + first);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "optional-null-safe-wrappers",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Optional — null-safe wrappers"
    },
    {
      "id": "jshell-301-pipeline",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: putting-it-all-together-employee-data-pi\n//@ description: Putting it all together: Employee data pipeline\nimport java.util.List;\nimport java.util.Map;\nimport java.util.stream.Collectors;\n\n// --- Putting it all together: Employee data pipeline ---\n// The Employee record and the employees list are still in scope from the earlier\n// cell - one JShell session runs the whole notebook.\n\n// Task: find the departments whose average salary is above 90,000, and name the\n//       top earner in each.\n\nSystem.out.println(\"=== High-Value Departments Report ===\");\nSystem.out.println();\n\n// Step 1: one entry per department, holding that department's employees.\nMap<String, List<Employee>> byDept = employees.stream()\n    .collect(Collectors.groupingBy(Employee::dept));\n\n// Step 2: stream the MAP's entries. Each entry is one department plus its list.\nbyDept.entrySet().stream()\n    // The filter runs a whole inner pipeline per department: average that group's\n    // salaries and keep the group only if the mean clears the bar.\n    .filter(entry -> entry.getValue().stream()\n            .mapToDouble(Employee::salary)\n            .average()\n            .orElse(0) > 90_000)\n    // Sorting by key makes the report deterministic - a HashMap has no order of its own.\n    .sorted(Map.Entry.comparingByKey())\n    .forEach(entry -> {\n        String dept = entry.getKey();\n        List<Employee> emps = entry.getValue();\n\n        double avg = emps.stream()\n            .mapToDouble(Employee::salary).average().orElse(0);\n\n        // max() with a comparator returns Optional<Employee>. Double.compare handles\n        // the floating-point edge cases that a - b would get wrong.\n        Employee top = emps.stream()\n            .max((a, b) -> Double.compare(a.salary(), b.salary()))\n            // orElseThrow says \"this cannot be empty\" - a group always has members.\n            .orElseThrow();\n\n        // %,.0f adds thousands separators and drops the decimals.\n        System.out.printf(\"Dept: %-14s  Avg: $%,.0f  Top earner: %s ($%,.0f)%n\",\n            dept, avg, top.name(), top.salary());\n    });",
      "output": "",
