    {
      "id": "jshell-301-create",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: creating-streams\n//@ description: Creating Streams\nimport java.util.stream.Stream;\nimport java.util.stream.IntStream;\nimport java.util.Arrays;\nimport java.util.List;\n\n// --- Creating Streams ---\n// A stream is not a collection: it holds no data, it describes a computation over a\n// source. Five common ways to get one:\n\n// 1. From a List - by far the most common starting point.\nList<String> colors = List.of(\"red\", \"green\", \"blue\", \"red\", \"yellow\", \"blue\");\nStream<String> s1 = colors.stream();\n// count() is a TERMINAL operation: it runs the pipeline and closes the stream.\n// Using s1 again after this line would throw IllegalStateException.\nSystem.out.println(\"From List count: \" + s1.count());\n\n// 2. Stream.of - a stream straight from values, no collection needed.\nStream.of(\"alpha\", \"beta\", \"gamma\")\n      .forEach(w -> System.out.print(w + \" \"));   // forEach is also terminal\nSystem.out.println();\n\n// 3. Arrays.stream on an int[] gives an IntStream, which - unlike Stream<Integer> -\n// has arithmetic built in, so sum() is available without any mapping.\nint[] nums = {5, 3, 8, 1, 9, 2, 7};\nint sum = Arrays.stream(nums).sum();\nSystem.out.println(\"Sum of array: \" + sum);\n\n// 4. IntStream.range(a, b) counts a..b-1; rangeClosed(a, b) includes b.\nSystem.out.print(\"range(1,6)  : \");\nIntStream.range(1, 6).forEach(i -> System.out.print(i + \" \"));\nSystem.out.println();\n\n// 5. Stream.iterate(seed, fn) applies fn over and over: 1, 2, 4, 8, ...\n// It is INFINITE, so a limit() (or another short-circuiting op) is mandatory -\n// without it the terminal operation would never finish.\nSystem.out.print(\"Powers of 2 : \");\nStream.iterate(1, n -> n * 2)\n      .limit(8)\n      .forEach(n -> System.out.print(n + \" \"));\nSystem.out.println();",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "creating-streams",
