    {
      "id": "jshell-301-reduce",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: reduce-distinct-limit-count\n//@ description: reduce, distinct, limit, count\nimport java.util.List;\nimport java.util.stream.Collectors;\n\n// --- reduce, distinct, limit, count ---\n\nList<Integer> numbers = List.of(3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5);\n\n// reduce(identity, accumulator) folds the whole stream into ONE value.\n// The identity is both the starting point and the answer for an empty stream, so it\n// must be neutral for the operation: 0 for addition, 1 for multiplication.\nint total = numbers.stream()\n    .reduce(0, (acc, n) -> acc + n);   // acc carries the running result\nSystem.out.println(\"Sum    : \" + total);\n\nint product = numbers.stream()\n    .reduce(1, (acc, n) -> acc * n);   // starting from 0 here would give 0\nSystem.out.println(\"Product: \" + product);\n\n// distinct() drops repeats, deciding equality with equals()/hashCode().\nList<Integer> unique = numbers.stream()\n    .distinct()\n    .sorted()\n    .collect(Collectors.toList());\nSystem.out.println(\"Distinct sorted: \" + unique);\n\n// skip() and limit() together are pagination. Both are lazy, so limit(3) also stops\n// the upstream work as soon as three elements have made it through.\nList<Integer> page = numbers.stream()\n    .distinct()\n    .sorted()\n    .skip(2)     // drop the first 2\n    .limit(3)    // then take the next 3\n    .collect(Collectors.toList());\nSystem.out.println(\"Page (skip 2, limit 3): \" + page);\n\n// Each of these needs its OWN stream - a stream cannot be reused after a terminal op.\nlong count = numbers.stream().distinct().count();\n// max() on an IntStream returns OptionalInt; getAsInt() unwraps it and would throw\n// on an empty stream, which is safe here because the list is known to be non-empty.\nint max = numbers.stream().mapToInt(Integer::intValue).max().getAsInt();\nint min = numbers.stream().mapToInt(Integer::intValue).min().getAsInt();\nSystem.out.printf(\"Unique count: %d  Min: %d  Max: %d%n\", count, min, max);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "reduce-distinct-limit-count",
