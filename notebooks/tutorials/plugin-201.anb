{
  "id": "plugin-201",
  "name": "Plugin 201 · Choosing Members",
  "description": "Intermediate plugin — what belongs in one bundle, what does not, and why the answer is about the person installing it.",
  "metadata": {
    "category": "tutorial",
    "subcategory": "Plugins",
    "language": "agent",
