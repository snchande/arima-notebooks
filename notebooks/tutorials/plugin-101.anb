{
  "id": "plugin-101",
  "name": "Plugin 101 · Review Kit",
  "description": "Beginner plugin — bundles a code-reviewer agent, a commit-message skill and the word-count tool into one installable Claude Code plugin.",
  "metadata": {
    "kind": "plugin",
    "category": "tutorial",
