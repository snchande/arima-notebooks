    {
      "id": "601-md-s1",
      "type": "MARKDOWN",
      "mode": "jshell",
      "source": "---\n## Part 1 — Descriptive Statistics\n`DescriptiveStatistics` — mean, median, variance, percentiles, skewness, kurtosis.",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": null,
      "dependsOn": [],
      "pipelineSteps": []
    },
    {
      "id": "601-desc-stats",
      "type": "CODE",
      "mode": "jshell",
      "anchor": "desc-stats",
      "source": "//@ anchor: desc-stats\n//@ description: Prints N=%d  Min=%.1f  Max=%.1f%n\n// Note there is no import statement anywhere in this notebook. Arima\n// pre-imports Commons Math, XChart, Tablesaw, OpenCSV and its own\n// BaristaDisplay helper into every JShell session, so DescriptiveStatistics\n// is already a name the compiler knows.\n\n// Monthly mean temperatures in degrees Celsius, January through December.\ndouble[] temps = {3.1,4.8,8.2,13.5,18.0,22.4,25.1,24.6,19.8,13.2,7.4,3.9};\n\n// DescriptiveStatistics keeps the values, which is what lets it answer\n// percentile questions later. (SummaryStatistics is the streaming cousin: it\n// keeps only running totals, so it can handle unbounded data but cannot give\n// you a median.)\nDescriptiveStatistics ds = new DescriptiveStatistics(temps);\n\n// getN() returns long because the sample could be huge; the cast just matches\n// the %d conversion to an int here.\nSystem.out.printf(\"N=%d  Min=%.1f  Max=%.1f%n\", (int)ds.getN(), ds.getMin(), ds.getMax());\n\n// There is no getMedian(): the median IS the 50th percentile, so asking for\n// getPercentile(50) is the same question. Mean and median differing tells you\n// the distribution is skewed - here they are close, so it is roughly balanced.\nSystem.out.printf(\"Mean=%.2f  Median=%.2f  StdDev=%.2f%n\",\n    ds.getMean(), ds.getPercentile(50), ds.getStandardDeviation());\n\n// Skewness: 0 is symmetric, positive means a long right tail.\n// Kurtosis (Commons Math reports EXCESS kurtosis): 0 matches a normal\n// distribution, negative means flatter with thinner tails - which is what a\n// seasonal cycle spread evenly across the year looks like.\nSystem.out.printf(\"Skewness=%.3f  Kurtosis=%.3f%n\", ds.getSkewness(), ds.getKurtosis());\n\n// Percentiles describe the SHAPE in a way the mean cannot: P25 to P75 is the\n// interquartile range, the middle half of the year.\nSystem.out.printf(\"P25=%.2f  P75=%.2f  P90=%.2f%n\",\n    ds.getPercentile(25), ds.getPercentile(75), ds.getPercentile(90));\n\n// BaristaDisplay renders rich output back into the notebook cell rather than\n// printing text - here, a small HTML summary table.\nBaristaDisplay.stats(\"Monthly Temps (deg C)\", temps);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Prints N=%d  Min=%.1f  Max=%.1f%n"
    },
    {
      "id": "601-md-s2",
      "type": "MARKDOWN",
      "mode": "jshell",
      "source": "## Part 2 — Linear Regression\n`SimpleRegression` — slope, intercept, R², standard errors, predictions.",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": null,
      "dependsOn": [],
      "pipelineSteps": []
    },
    {
      "id": "601-regression",
      "type": "CODE",
      "mode": "jshell",
      "anchor": "regression",
      "source": "//@ anchor: regression\n//@ description: Prints y = %.4fx + %.4f%n\n// Ordinary least squares: find the straight line that minimises the sum of the\n// SQUARED vertical distances from the points. Squaring is what makes large\n// misses count disproportionately, and what makes the solution unique.\nSimpleRegression reg = new SimpleRegression();\ndouble[][] pts = {{1,2.1},{2,4.3},{3,5.9},{4,8.2},{5,10.1},{6,11.8},{7,14.0},{8,16.2}};\n\n// addData feeds points one at a time; the fit is recomputed on demand, so\n// there is no separate \"train\" step to remember.\nfor (double[] p : pts) reg.addData(p[0], p[1]);\n\nSystem.out.printf(\"y = %.4fx + %.4f%n\", reg.getSlope(), reg.getIntercept());\n\n// R^2 is the fraction of the variation in y that the line accounts for: 1.0\n// would be a perfect fit. SlopeStdErr is the uncertainty in the slope - a\n// slope is only meaningful when it is large compared with its own error.\n// predict(9) extrapolates beyond the data, which is always the riskiest use\n// of a fitted line.\nSystem.out.printf(\"R^2=%.4f  SlopeErr=%.4f  Predict(9)=%.3f%n\",\n    reg.getRSquare(), reg.getSlopeStdErr(), reg.predict(9));\n\nXYChart c = BaristaDisplay.xyChart(\"Linear Regression\",\"X\",\"Y\",700,380);\n\n// The styler holds presentation; the series hold data. Setting Scatter BEFORE\n// adding the points and Line before adding the fit is the trick that gives one\n// chart two different render styles - the default applies at the moment a\n// series is added.\nc.getStyler().setDefaultSeriesRenderStyle(XYSeries.XYSeriesRenderStyle.Scatter);\n// XChart wants two parallel double[] arrays, so the array of pairs is split.\ndouble[] xs=Arrays.stream(pts).mapToDouble(p->p[0]).toArray();\ndouble[] ys=Arrays.stream(pts).mapToDouble(p->p[1]).toArray();\nc.addSeries(\"Data\",xs,ys).setMarkerColor(BaristaDisplay.PALETTE[0]);\n\nc.getStyler().setDefaultSeriesRenderStyle(XYSeries.XYSeriesRenderStyle.Line);\n// A straight line needs only its two endpoints, so the fitted series is drawn\n// from predict(1) to predict(8) rather than from eight computed points.\nXYSeries fit=c.addSeries(\"Fit\",new double[]{1,8},new double[]{reg.predict(1),reg.predict(8)});\n// Markers off, so the fit reads as a line rather than as two data points.\nfit.setMarker(SeriesMarkers.NONE); fit.setLineColor(BaristaDisplay.PALETTE[2]);\nBaristaDisplay.show(c);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Prints y = %.4fx + %.4f%n"
    },
    {
      "id": "601-md-s3",
      "type": "MARKDOWN",
      "mode": "jshell",
      "source": "## Part 3 — Probability Distributions\nNormal, T, Binomial, Poisson — PDF, CDF, inverse CDF.",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": null,
      "dependsOn": [],
      "pipelineSteps": []
    },
    {
      "id": "601-distributions",
      "type": "CODE",
      "mode": "jshell",
      "anchor": "distributions",
      "source": "//@ anchor: distributions\n//@ description: Prints t(10)   P(T<2.228)=%.4f%n\n// Only the distributions Arima does not pre-import need naming explicitly.\nimport org.apache.commons.math3.distribution.BinomialDistribution;\nimport org.apache.commons.math3.distribution.PoissonDistribution;\n\nNormalDistribution nd = new NormalDistribution(0,1);   // standard normal: mean 0, sd 1\nTDistribution td = new TDistribution(10);              // 10 degrees of freedom\nBinomialDistribution bd = new BinomialDistribution(20,0.4);  // 20 trials, p=0.4\nPoissonDistribution pd = new PoissonDistribution(3.5);       // mean rate 3.5\n\n// cumulativeProbability(x) is the CDF: P(X <= x), the area to the LEFT of x.\n// inverseCumulativeProbability(p) runs it backwards: which x has that much\n// area to its left. 0.975 rather than 0.95 because a two-sided 95% interval\n// leaves 2.5% in each tail - this is where the familiar 1.96 comes from.\n// Note \"95%%\": in a format string, %% is how you print one literal percent.\nSystem.out.printf(\"Normal  P(X<1.96)=%.4f  95%% z=%.3f%n\",\n    nd.cumulativeProbability(1.96), nd.inverseCumulativeProbability(0.975));\n\n// The t distribution is the normal's heavier-tailed relative, used when the\n// standard deviation is estimated from a small sample rather than known.\nSystem.out.printf(\"t(10)   P(T<2.228)=%.4f%n\", td.cumulativeProbability(2.228));\n\n// Discrete distributions have probability(k) - the chance of EXACTLY k, which\n// is a meaningful question only because the outcomes are countable. For a\n// continuous distribution the equivalent is density(x), not a probability.\nSystem.out.printf(\"Binom(20,0.4) P(X=8)=%.4f%n\", bd.probability(8));\nSystem.out.printf(\"Poisson(3.5)  P(X<=5)=%.4f%n\", pd.cumulativeProbability(5));\n\n// Sample both PDFs on the same 80 points from -4 to +4 so they can be overlaid.\nint n2=80; double[] xv=new double[n2],nv=new double[n2],tv=new double[n2];\nfor(int i=0;i<n2;i++){xv[i]=-4.0+i*8.0/n2; nv[i]=nd.density(xv[i]); tv[i]=td.density(xv[i]);}\nXYChart dist=BaristaDisplay.xyChart(\"Normal vs t(10) PDF\",\"x\",\"Density\",700,360);\n// Marker size 0 leaves a clean curve: 80 markers would obscure the shape.\ndist.getStyler().setMarkerSize(0);\ndist.addSeries(\"N(0,1)\",xv,nv); dist.addSeries(\"t(10)\",xv,tv);\n// The t curve sits slightly lower in the middle and higher in the tails -\n// that is the extra uncertainty a small sample buys you, drawn.\nBaristaDisplay.show(dist);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Prints t(10)   P(T<2.228)=%.4f%n"
    },
    {
      "id": "601-md-s4",
      "type": "MARKDOWN",
      "mode": "jshell",
      "source": "## Part 4 — Correlation\nPearson (linear) and Spearman (rank) correlation coefficients.",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": null,
      "dependsOn": [],
      "pipelineSteps": []
    },
    {
      "id": "601-correlation",
      "type": "CODE",
      "mode": "jshell",
      "anchor": "correlation",
      "source": "//@ anchor: correlation\n//@ description: Prints height vs weight\nimport org.apache.commons.math3.stat.correlation.PearsonsCorrelation;\nimport org.apache.commons.math3.stat.correlation.SpearmansCorrelation;\n\ndouble[] height={160,165,170,175,180,185,190};\ndouble[] weight={55,62,68,74,80,88,95};\ndouble[] noise ={90,45,72,30,85,50,60};   // deliberately unrelated to height\n\n// Pearson measures how close the relationship is to a straight LINE.\n// Spearman ranks the values first and correlates the ranks, so it measures\n// whether the relationship is MONOTONIC - it catches a curve that always rises\n// but not linearly, where Pearson would understate the connection. Ranking\n// also makes Spearman far less sensitive to a single extreme outlier.\nPearsonsCorrelation pc=new PearsonsCorrelation();\n// Named sc2 rather than sc simply because a JShell session is shared across\n// cells and short names collide easily.\nSpearmansCorrelation sc2=new SpearmansCorrelation();\n\n// Both coefficients run from -1 to +1. Near 0 means no relationship OF THAT\n// KIND - never that the variables are independent.\nSystem.out.printf(\"height vs weight  Pearson=%.4f  Spearman=%.4f%n\",\n    pc.correlation(height,weight), sc2.correlation(height,weight));\nSystem.out.printf(\"height vs noise   Pearson=%.4f  Spearman=%.4f%n\",\n    pc.correlation(height,noise), sc2.correlation(height,noise));\n\n// And the standing warning: a correlation this strong still says nothing about\n// which variable causes which, or whether a third one drives both.\nBaristaDisplay.table(new String[][]{\n    {\"height vs weight\",String.format(\"%.4f\",pc.correlation(height,weight)),\"Strong positive\"},\n    {\"height vs noise\", String.format(\"%.4f\",pc.correlation(height,noise)), \"Weak/random\"}\n},\"Pair\",\"Pearson r\",\"Interpretation\");",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Prints height vs weight"
    },
    {
