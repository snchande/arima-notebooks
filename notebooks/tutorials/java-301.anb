    {
      "id": "j302-builder-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-generic-builder-with-valid\n//@ description: ☕ Java Mode — Generic Builder with validation and immutable result\n// --- Java mode: a builder that validates, producing an immutable record ---\nimport java.util.*;\n\npublic class BuilderDemo {\n    // The result is a record, so immutability and equals/hashCode come free.\n    // The builder exists purely to make CONSTRUCTING one bearable.\n    public record Config(\n        String host, int port, int maxConnections,\n        Duration connectTimeout, boolean sslEnabled, Map<String, String> properties\n    ) {\n        // A nested record used as a tiny value type. Wrapping an int in\n        // Duration means a caller cannot pass milliseconds where seconds were\n        // meant - the compiler now catches what a bare 'int' would not.\n        public record Duration(int ms) {\n            public static Duration ofSeconds(int s) { return new Duration(s * 1000); }\n            @Override public String toString() { return ms + \"ms\"; }\n        }\n\n        // The entry point takes the one genuinely required value, so it is\n        // impossible to start building without a host.\n        public static Builder builder(String host) { return new Builder(host); }\n\n        public static class Builder {\n            // 'final' for the required field: it can never be changed later.\n            private final String host;\n            // Optional settings carry sensible defaults.\n            private int port = 5432;\n            private int maxConnections = 10;\n            private Duration connectTimeout = Duration.ofSeconds(5);\n            private boolean sslEnabled = false;\n            private final Map<String, String> props = new LinkedHashMap<>();\n\n            // requireNonNull fails here, at the call site, rather than letting\n            // a null host travel on and surface somewhere far less obvious.\n            Builder(String host) { this.host = Objects.requireNonNull(host); }\n            public Builder port(int p)           { port = p;              return this; }\n            public Builder maxConnections(int n) { maxConnections = n;    return this; }\n            public Builder timeout(Duration d)   { connectTimeout = d;    return this; }\n            // A flag needs no argument: ssl() reads better than ssl(true).\n            public Builder ssl()                 { sslEnabled = true;     return this; }\n            public Builder property(String k, String v) { props.put(k,v); return this; }\n\n            public Config build() {\n                // build() is the single choke point where the object becomes\n                // real, which makes it the right place for cross-field checks.\n                if (port < 1 || port > 65535) throw new IllegalStateException(\"Invalid port\");\n                // unmodifiableMap wraps the builder's map so the finished Config\n                // cannot be mutated through a reference to it afterwards.\n                return new Config(host, port, maxConnections, connectTimeout,\n                                  sslEnabled, Collections.unmodifiableMap(props));\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        var config = Config.builder(\"db.example.com\")\n            .port(5432)\n            .maxConnections(20)\n            .timeout(Config.Duration.ofSeconds(10))\n            .ssl()\n            .property(\"applicationName\", \"Arima\")\n            .build();\n\n        // Record accessors: host(), port(), ... - no 'get' prefix.\n        System.out.println(\"host:       \" + config.host());\n        System.out.println(\"port:       \" + config.port());\n        System.out.println(\"maxConn:    \" + config.maxConnections());\n        System.out.println(\"timeout:    \" + config.connectTimeout());\n        System.out.println(\"ssl:        \" + config.sslEnabled());\n        System.out.println(\"properties: \" + config.properties());\n    }\n}",
      "output": "",
