    {
      "id": "j302-builder-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-builder-pattern-for-readable-ob\n//@ description: [JShell] Builder pattern for readable object construction\n// --- JShell mode: the builder pattern ---\n// The problem it solves: a constructor with five parameters, three of which\n// are optional, forces either a telescoping family of overloads or a call site\n// like new HttpRequest(\"GET\", url, null, null, 5000) that nobody can read.\nclass HttpRequest {\n    // 'final' fields set once in the constructor: after build() returns, the\n    // request cannot be altered, so it is safe to share or reuse.\n    final String method, url;\n    final java.util.Map<String, String> headers;\n    final String body;\n    final int timeoutMs;\n\n    // The constructor is PRIVATE, so the builder is the only way in and every\n    // instance necessarily went through build().\n    private HttpRequest(Builder b) {\n        method = b.method; url = b.url;\n        headers = b.headers; body = b.body; timeoutMs = b.timeoutMs;\n    }\n\n    // A static nested class: it belongs to HttpRequest but does not hold a\n    // reference to an enclosing instance, because there is not one yet.\n    static class Builder {\n        // Defaults live here, stated once, where they are easy to find.\n        String method = \"GET\", url, body;\n        java.util.Map<String,String> headers = new java.util.LinkedHashMap<>();\n        int timeoutMs = 5000;\n\n        // Each setter returns 'this'. That single detail is what makes the\n        // calls chain, and it is the whole trick behind the readable call site.\n        Builder url(String url)            { this.url = url;      return this; }\n        Builder method(String m)           { this.method = m;     return this; }\n        Builder header(String k, String v) { headers.put(k, v);   return this; }\n        Builder body(String b)             { this.body = b;       return this; }\n        Builder timeout(int ms)            { this.timeoutMs = ms; return this; }\n        HttpRequest build()                { return new HttpRequest(this); }\n    }\n\n    @Override public String toString() {\n        return method + \" \" + url + \" headers=\" + headers.size() +\n               \" timeout=\" + timeoutMs + \"ms\";\n    }\n}\n\n// Every argument is now labelled by the method that accepts it, and the\n// optional ones can simply be left out.\nvar req = new HttpRequest.Builder()\n    .url(\"https://api.example.com/users\")\n    .method(\"POST\")\n    .header(\"Content-Type\", \"application/json\")\n    .header(\"Authorization\", \"Bearer token123\")\n    .body(\"{name: Alice, role: admin}\")\n    .timeout(3000)\n    .build();\n\nSystem.out.println(req);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "jshell-builder-pattern-for-readable-ob",
