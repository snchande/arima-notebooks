    {
      "id": "j302-sealed-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-sealed-class-hierarchy\n//@ description: 🔵 JShell Mode — sealed class hierarchy\n// --- JShell mode: a sealed hierarchy, and why that makes switch safe ---\n\n// 'sealed ... permits' publishes a CLOSED list of subtypes. An ordinary\n// interface can be implemented by anyone, anywhere, so the compiler can never\n// know it has seen every case. Sealing removes that doubt, and the pattern\n// switch below cashes it in.\n//\n// Naming note: Arima auto-imports org.knowm.xchart.style.markers.* into every\n// JShell session, which already owns the names Circle and Rectangle. Declaring\n// records with those names here would silently resolve to the chart markers and\n// the cell would not compile, so this lesson uses Disc / Rect / Tri instead.\nsealed interface Shape permits Disc, Rect, Tri {}\nrecord Disc(double radius)               implements Shape {}\nrecord Rect(double width, double height) implements Shape {}\nrecord Tri(double base, double height)   implements Shape {}\n\ndouble area(Shape s) {\n    return switch (s) {\n        // A TYPE PATTERN: \"case Disc d\" tests the type and, if it matches,\n        // binds the already-narrowed value to d. No instanceof, no cast, and\n        // no chance of casting to the wrong type by accident.\n        case Disc c -> Math.PI * c.radius() * c.radius();\n        case Rect r -> r.width() * r.height();\n        case Tri  t -> 0.5 * t.base() * t.height();\n        // There is deliberately no 'default'. Because Shape is sealed, the\n        // compiler can prove these three cases are exhaustive - and if someone\n        // later adds a fourth permitted subtype, THIS switch stops compiling\n        // instead of quietly falling through at run time.\n    };\n}\n\nvar shapes = new Shape[]{\n    new Disc(5),\n    new Rect(4, 6),\n    new Tri(3, 8)\n};\nfor (var shape : shapes) {\n    // %s calls the record's generated toString(), so each shape prints with\n    // its component values - handy for exactly this kind of table.\n    System.out.printf(\"%-25s area = %.4f%n\", shape, area(shape));\n}",
      "output": "Circle[radius=5.0]        area = 78.5398\r\nRectangle[width=4.0, h=6.0] area = 24.0000\r\nTriangle[base=3.0, h=8.0] area = 12.0000\r\n",
      "returnValue": "",
      "executed": true,
      "executionCount": 1,
      "error": "",
      "anchor": "jshell-mode-sealed-class-hierarchy",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "🔵 JShell Mode — sealed class hierarchy"
    },
    {
      "id": "j302-sealed-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-sealed-hierarchy-as-domain\n//@ description: ☕ Java Mode — sealed hierarchy as domain model with visitor-like dispatch\n// --- Java mode: a sealed hierarchy as an expression tree ---\npublic class SealedDemo {\n    // This is an algebraic data type: an Expr is exactly one of three shapes,\n    // and the tree is recursive because Add and Mul hold Exprs of their own.\n    // Nesting them inside SealedDemo lets 'permits' be omitted - when the\n    // subtypes live in the same file, the compiler infers the list.\n    sealed interface Expr permits Num, Add, Mul {}\n    record Num(int value)             implements Expr {}\n    record Add(Expr left, Expr right) implements Expr {}\n    record Mul(Expr left, Expr right) implements Expr {}\n\n    // Two different operations over the same tree, each written as one switch.\n    // With a classic class hierarchy you would add an abstract method to Expr\n    // for each of these, spreading one operation across three files; here each\n    // operation stays in one place and the data types stay dumb.\n    static int eval(Expr expr) {\n        return switch (expr) {\n            case Num n -> n.value();                        // base case\n            case Add a -> eval(a.left()) + eval(a.right()); // recurse on children\n            case Mul m -> eval(m.left()) * eval(m.right());\n        };\n    }\n\n    static String pretty(Expr expr) {\n        return switch (expr) {\n            case Num n -> String.valueOf(n.value());\n            // Parenthesising every branch is the cheap way to be certain the\n            // printed form never depends on precedence rules.\n            case Add a -> \"(\" + pretty(a.left()) + \" + \" + pretty(a.right()) + \")\";\n            case Mul m -> \"(\" + pretty(m.left()) + \" * \" + pretty(m.right()) + \")\";\n        };\n    }\n\n    public static void main(String[] args) {\n        // The tree structure IS the precedence - there is no parsing here, so\n        // (2 + 3) * (4 + 1) = 25 simply by how the nodes are nested.\n        var expr = new Mul(new Add(new Num(2), new Num(3)),\n                           new Add(new Num(4), new Num(1)));\n        System.out.println(pretty(expr) + \" = \" + eval(expr));\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
