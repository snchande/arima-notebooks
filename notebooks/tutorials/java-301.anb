      "description": "🔵 JShell Mode — Virtual threads (Project Loom)"
    },
    {
      "id": "j302-vthreads-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-structured-concurrency-wit\n//@ description: ☕ Java Mode — structured concurrency with virtual threads\n// --- Java mode: five I/O-bound calls, run concurrently, scoped to one block ---\nimport java.util.concurrent.*;\nimport java.util.*;\n\npublic class VirtualThreadsDemo {\n    // A stand-in for a call that spends its time waiting on someone else -\n    // the case virtual threads are built for.\n    static String callService(String name, int delayMs) {\n        try { Thread.sleep(delayMs); }\n        catch (InterruptedException e) { Thread.currentThread().interrupt(); }\n        return name + \" responded in \" + delayMs + \"ms\";\n    }\n\n    public static void main(String[] args) throws Exception {\n        var start = System.currentTimeMillis();\n\n        var futures = new ArrayList<Future<String>>();\n        // The try-with-resources block is the \"structure\" in structured\n        // concurrency: every task started inside it is guaranteed to be\n        // finished by the time control leaves it, so no work can outlive the\n        // scope that owns it and quietly fail somewhere else.\n        try (var exec = Executors.newVirtualThreadPerTaskExecutor()) {\n            // submit() returns immediately with a Future placeholder; the work\n            // itself is already running on its own virtual thread.\n            futures.add(exec.submit(() -> callService(\"Auth\",    80)));\n            futures.add(exec.submit(() -> callService(\"User DB\", 120)));\n            futures.add(exec.submit(() -> callService(\"Cache\",   30)));\n            futures.add(exec.submit(() -> callService(\"Billing\", 95)));\n            futures.add(exec.submit(() -> callService(\"Email\",   60)));\n        }  // close() blocks here until all five have completed\n\n        var elapsed = System.currentTimeMillis() - start;\n        System.out.println(\"Results (ran in parallel, ~\" + elapsed + \"ms total):\");\n        // f.get() cannot block now - the executor already waited for everything.\n        // It is still the call that would rethrow any exception a task threw.\n        for (var f : futures) System.out.println(\"  \" + f.get());\n        // Sequentially this would be 80+120+30+95+60 = 385ms. Concurrently it\n        // is bounded by the slowest single call, about 120ms.\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
