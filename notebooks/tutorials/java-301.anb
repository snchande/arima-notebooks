    {
      "id": "j302-async-java",
      "type": "CODE",
      "mode": "java",
      "source": "//@ anchor: java-mode-async-pipeline-with-timeou\n//@ description: ☕ Java Mode — async pipeline with timeout and error handling\n// --- Java mode: fanning out several calls and waiting for all of them ---\nimport java.util.concurrent.*;\nimport java.util.List;\n\npublic class AsyncDemo {\n    record WeatherData(String city, double temp) {}\n\n    static CompletableFuture<WeatherData> getWeather(String city) {\n        return CompletableFuture.supplyAsync(() -> {\n            // Thread.sleep stands in for network latency here.\n            // Catching InterruptedException and immediately re-setting the flag\n            // with Thread.currentThread().interrupt() is the standard move:\n            // catching it clears the flag, and swallowing it would hide a\n            // cancellation request from everything further up the stack.\n            try { Thread.sleep(50); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }\n            double temp = 15 + Math.random() * 20;\n            return new WeatherData(city, temp);\n        });\n    }\n\n    public static void main(String[] args) throws Exception {\n        var cities = List.of(\"London\", \"Tokyo\", \"New York\", \"Sydney\");\n\n        // Every getWeather call starts as soon as it is made, so by the time\n        // this stream finishes, all four requests are already in flight.\n        var futures = cities.stream()\n            .map(AsyncDemo::getWeather)\n            .toList();\n\n        // allOf returns a CompletableFuture<Void> that completes when every\n        // input has. The array argument is the API's shape; new\n        // CompletableFuture[0] is the usual idiom for \"size it for me\".\n        CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).get();\n\n        System.out.println(\"Weather report:\");\n        futures.stream()\n            // getNow(null) never blocks - it is only safe because allOf()\n            // above already guaranteed every future has completed.\n            .map(f -> f.getNow(null))\n            .sorted(java.util.Comparator.comparingDouble(WeatherData::temp).reversed())\n            .forEach(w -> System.out.printf(\"  %-10s %.1f C%n\", w.city(), w.temp()));\n    }\n}",
      "output": "",
      "returnValue": null,
      "executed": false,
