    {
      "id": "j302-vthreads-jshell",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: jshell-mode-virtual-threads-project\n//@ description: 🔵 JShell Mode — Virtual threads (Project Loom)\n// --- JShell mode: virtual threads (Project Loom) ---\n// A platform thread maps 1:1 onto an OS thread and costs about a megabyte of\n// stack, which is why pools exist. A virtual thread is managed by the JVM,\n// starts at a few hundred bytes, and unmounts from its carrier thread whenever\n// it blocks - so a million of them is reasonable where a thousand platform\n// threads would not be.\nimport java.util.concurrent.*;\nimport java.util.concurrent.atomic.*;\n\n// AtomicInteger, not int: several threads touch this counter at once, and\n// counter++ on a plain int is read-modify-write - three steps that can\n// interleave and lose updates. incrementAndGet() is one indivisible operation.\nvar counter = new AtomicInteger(0);\nvar tasks   = new java.util.ArrayList<Thread>();\n\nfor (int i = 0; i < 1000; i++) {\n    // A lambda may only capture variables that are final or effectively final,\n    // and the loop variable i changes on every pass. Copying it into 'id'\n    // gives each task its own unchanging value.\n    final int id = i;\n    // unstarted() builds the thread without running it, so all 1000 can be\n    // created first and then released together below.\n    tasks.add(Thread.ofVirtual().unstarted(() -> {\n        counter.incrementAndGet();\n        // Sleeping is exactly where a virtual thread pays off: it releases its\n        // carrier thread instead of parking an OS thread for 10ms.\n        try { Thread.sleep(10); } catch (InterruptedException e) {}\n        counter.decrementAndGet();\n    }));\n}\n\ntasks.forEach(Thread::start);\n// join() waits for one thread to finish. Doing it for every task is how we\n// know the work is complete before reporting on it.\ntasks.forEach(t -> { try { t.join(); } catch (Exception e) {} });\n\nSystem.out.println(\"Launched 1000 virtual threads successfully.\");\nSystem.out.println(\"Thread type: \" + tasks.get(0).getClass().getSimpleName());\n\n// The executor form is what production code uses. Note this is NOT a pool:\n// newVirtualThreadPerTaskExecutor creates one fresh virtual thread per task,\n// because virtual threads are cheap enough that pooling them buys nothing.\ntry (var exec = Executors.newVirtualThreadPerTaskExecutor()) {\n    // CopyOnWriteArrayList because several tasks add to it concurrently; a\n    // plain ArrayList would corrupt under that.\n    var results = new java.util.concurrent.CopyOnWriteArrayList<String>();\n    for (int i = 0; i < 5; i++) {\n        final int id = i;\n        exec.submit(() -> results.add(\"Task-\" + id + \" done on \" +\n            Thread.currentThread().isVirtual()));\n    }\n}  // close() shuts the executor down AND blocks until every task has finished -\n   // try-with-resources is what makes that automatic here.\nSystem.out.println(\"Virtual thread executor demo complete.\");",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "jshell-mode-virtual-threads-project",
      "dependsOn": [],
