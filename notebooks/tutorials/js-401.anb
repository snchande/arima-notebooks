    {
      "id": "jsds-8",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: generate-readings\n//@ description: Defines the generateReadings function\nconst ss   = require('simple-statistics');\nconst { create, all } = require('mathjs');\nconst math = create(all);\n\n// Simulated sensor readings dataset\n// Array.from({length: n}, fn) is the idiomatic way to build an array of n\n// generated items: the object supplies only a length, and the mapper is called\n// once per index.\nfunction generateReadings(n, baseMean, noise) {\n  return Array.from({ length: n }, (_, i) => ({\n    // Date arithmetic is in milliseconds, so i * 60000 steps one minute per row.\n    // slice(11,19) cuts the HH:MM:SS section out of the ISO timestamp.\n    timestamp: new Date(Date.now() + i * 60000).toISOString().slice(11,19),\n    // Ten readings per sensor: integer division by 10 gives the group number.\n    sensor: 'T-' + (Math.floor(i / 10) + 1),\n    // (Math.random() - 0.5) centres the noise on zero; multiplying by noise*2\n    // spreads it over +/- noise. The leading unary + converts the string that\n    // toFixed returns back into a number.\n    value: +(baseMean + (Math.random() - 0.5) * noise * 2).toFixed(2)\n  }));\n}\n\n// Note: no seed, so the numbers differ on every run - realistic for a sensor\n// feed, but it means the output below is not reproducible.\nconst readings = generateReadings(30, 22.5, 3);\nconsole.log('=== Sensor Data Analysis ===');\nconsole.log('Sample (first 5):');\n// slice() copies a section without mutating the source array.\nbarista.table(readings.slice(0, 5));\n\n// Project the single numeric column out of the records before doing statistics.\nconst values = readings.map(r => r.value);\nconsole.log('\\nStatistical Summary:');\nconsole.log(`  Readings: ${values.length}`);\nconsole.log(`  Mean:     ${ss.mean(values).toFixed(3)}`);\nconsole.log(`  Std Dev:  ${ss.standardDeviation(values).toFixed(3)}`);\nconsole.log(`  Range:    [${ss.min(values)}, ${ss.max(values)}]`);\n// The interquartile range is the width of the middle 50% of the data - a spread\n// measure that ignores the tails entirely.\nconsole.log(`  IQR:      ${(ss.quantile(values, 0.75) - ss.quantile(values, 0.25)).toFixed(3)}`);\n\n// Detect outliers using z-score\n// A z-score restates each value as \"how many standard deviations from the mean\",\n// which makes the threshold unit-independent. |z| > 2 flags roughly the most\n// extreme 5% of a normal distribution, so expect a handful of false positives.\nconst mean = ss.mean(values);\nconst std  = ss.standardDeviation(values);\nconst outliers = readings.filter(r => Math.abs((r.value - mean) / std) > 2);\nconsole.log(`\\nOutliers (|z| > 2): ${outliers.length}`);\n// barista.table on an empty array would print an empty frame, so guard it.\nif (outliers.length > 0) barista.table(outliers);",
      "output": "",
      "returnValue": null,
