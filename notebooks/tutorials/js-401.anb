    {
      "id": "jsds-2",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: sample-dataset-exam-scores\n//@ description: Sample dataset: exam scores\n// Every cell is a separate Node process, so each one must require what it uses -\n// there is no shared state with the cell above.\nconst ss = require('simple-statistics');\n\n// Sample dataset: exam scores\nconst scores = [72, 85, 91, 68, 78, 95, 62, 88, 74, 83, 79, 91, 67, 86, 77, 92, 70, 84, 88, 75];\n\nconsole.log('=== Exam Score Analysis ===');\nconsole.log(`Count:       ${scores.length}`);\nconsole.log(`Min:         ${ss.min(scores)}`);\nconsole.log(`Max:         ${ss.max(scores)}`);\n// The mean is pulled toward outliers; the median is not. When the two disagree\n// sharply, the distribution is skewed - which is what sampleSkewness quantifies.\nconsole.log(`Mean:        ${ss.mean(scores).toFixed(2)}`);\nconsole.log(`Median:      ${ss.median(scores)}`);\n// The mode is the most frequent value - meaningful for repeated integers like\n// these, close to useless for continuous measurements.\nconsole.log(`Mode:        ${ss.mode(scores)}`);\n// Standard deviation is the square root of the variance, so it is back in the\n// same unit as the data (marks, not marks-squared) and is the one to quote.\nconsole.log(`Std Dev:     ${ss.standardDeviation(scores).toFixed(2)}`);\nconsole.log(`Variance:    ${ss.variance(scores).toFixed(2)}`);\n// Skewness: 0 is symmetric, negative leans left (a tail of low scores).\nconsole.log(`Skewness:    ${ss.sampleSkewness(scores).toFixed(4)}`);\n// Kurtosis describes tail weight - how often extreme values show up.\nconsole.log(`Kurtosis:    ${ss.sampleKurtosis(scores).toFixed(4)}`);\nconsole.log();\n\nconsole.log('Percentiles:');\n// quantile takes a fraction in 0..1, hence p/100. p50 is the median by definition.\n[25, 50, 75, 90, 95].forEach(p => {\n  console.log(`  p${p}: ${ss.quantile(scores, p/100).toFixed(1)}`);\n});",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "sample-dataset-exam-scores",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Sample dataset: exam scores"
    },
    {
      "id": "jsds-3",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: linear-regression\n//@ description: Linear regression\nconst ss = require('simple-statistics');\n\n// Linear regression\n// simple-statistics expects [x, y] pairs, not two parallel arrays.\nconst points = [\n  [1, 2.1], [2, 3.9], [3, 6.2], [4, 7.8], [5, 10.1],\n  [6, 11.9], [7, 14.2], [8, 16.0], [9, 17.8], [10, 20.3]\n];\n\n// Fits y = m*x + b by least squares: the line minimising the sum of squared\n// vertical distances from the points. Returns the coefficients as { m, b }.\nconst result = ss.linearRegression(points);\n// linearRegressionLine turns those coefficients into a callable predictor -\n// pass an x, get the fitted y.\nconst line   = ss.linearRegressionLine(result);\n\nconsole.log('=== Linear Regression ===');\nconsole.log(`Slope (m):     ${result.m.toFixed(4)}`);   // change in y per unit of x\nconsole.log(`Intercept (b): ${result.b.toFixed(4)}`);   // value of y where x = 0\nconsole.log(`Equation:      y = ${result.m.toFixed(2)}x + ${result.b.toFixed(2)}`);\nconsole.log();\n\n// R-squared is the fraction of the variance in y explained by the line: 1.0 is a\n// perfect fit, 0 means the line does no better than predicting the mean.\nconst rSquared = ss.rSquared(points, line);\nconsole.log(`R²:            ${rSquared.toFixed(4)}`);\nconsole.log();\n\nconsole.log('Predictions:');\n// x = 15 and 20 lie beyond the observed range. Extrapolating like this assumes\n// the linear relationship keeps holding, which the data cannot confirm.\nbarista.table(\n  [1, 5, 10, 15, 20].map(x => ({\n    x,\n    predicted: line(x).toFixed(2)\n  }))\n);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "linear-regression",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Linear regression"
