      "pipelineSteps": []
    },
    {
      "id": "jsds-1",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: check-that-packages-are-installed\n//@ description: Check that packages are installed\n// Check that packages are installed\n\n// require() loads a CommonJS module. If the package is missing it THROWS, so the\n// try/catch below turns a stack trace into an actionable message.\ntry {\n  // Both names resolve out of Arima's npm module directory, which is shared by\n  // every JS and TS cell - install once, use anywhere.\n  const ss   = require('simple-statistics');\n  const math = require('mathjs');\n  // `a || b` falls back when the left side is falsy; here it covers packages\n  // that do not export a `version` field at all.\n  console.log('✓ simple-statistics', ss.version || 'installed');\n  console.log('✓ mathjs', math.version || 'installed');\n  console.log('\\nReady for data science!');\n} catch(e) {\n  // `e` is an Error object; .message is the human-readable part, without the stack.\n  console.error('Missing package:', e.message);\n  console.error('Go to Packages → npm tab and install: simple-statistics, mathjs');\n}",
      "output": "",
      "returnValue": null,
      "executed": true,
      "executionCount": 8,
      "error": "Missing package: Cannot find module 'simple-statistics'\nRequire stack:\n- script.js\nGo to Packages → npm tab and install: simple-statistics, mathjs",
