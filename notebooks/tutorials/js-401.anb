    {
      "id": "jsds-5",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: math\n//@ description: Declares math variable\n// mathjs ships a default instance, but create(all) builds your own configured\n// one. That is the recommended entry point: it lets you set number type or\n// precision per instance instead of mutating a global.\nconst { create, all } = require('mathjs');\nconst math = create(all);\n\nconsole.log('=== mathjs Basics ===');\n\n// Expression evaluation\n// evaluate() parses a STRING of math notation - handy when the expression comes\n// from user input or a config file rather than from source code.\nconsole.log(math.evaluate('12 / (2.3 + 0.7)'));         // 4\n// '^' is exponentiation in mathjs notation, not JavaScript's bitwise XOR.\nconsole.log(math.evaluate('sqrt(3^2 + 4^2)'));           // 5\nconsole.log(math.evaluate('log(1000, 10)'));             // 3\n// Euler's identity. In floating point the answer is a whisker away from zero, so\n// format() is used to round it to a readable form.\nconsole.log(math.format(math.evaluate('e^(pi*i) + 1'))); // ~0\n\n// Unit conversions\n// mathjs understands units as first-class values, so it converts and checks\n// dimensions for you. The result is a Unit object; toString() renders it.\nconsole.log('\\n=== Unit Conversions ===');\nconsole.log(math.evaluate('100 km/h to mi/h').toString());\nconsole.log(math.evaluate('1 kg to lbs').toString());\n// Temperature is the interesting case: degF to degC needs an offset, not just a\n// scale factor, and mathjs handles that distinction.\nconsole.log(math.evaluate('100 degF to degC').toString());\nconsole.log(math.evaluate('1 atm to Pa').toString());",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "math",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Declares math variable"
    },
    {
      "id": "jsds-6",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: matrix-operations\n//@ description: Matrix operations\nconst { create, all } = require('mathjs');\nconst math = create(all);\n\n// Matrix operations\nconsole.log('=== Matrix Operations ===');\n\n// A Matrix is a mathjs type, not a plain array - that is what lets the operators\n// below know they are working on matrices rather than nested lists.\nconst A = math.matrix([[1, 2], [3, 4]]);\nconst B = math.matrix([[5, 6], [7, 8]]);\n\nconsole.log('A =', math.format(A));\nconsole.log('B =', math.format(B));\nconsole.log('A + B =', math.format(math.add(A, B)));\n// multiply() is true matrix multiplication (rows times columns), NOT the\n// element-by-element product. Order matters: A*B is generally not B*A.\nconsole.log('A * B =', math.format(math.multiply(A, B)));\n// The determinant summarises how the matrix scales area/volume. Zero means the\n// matrix is singular and has no inverse.\nconsole.log('det(A) =', math.det(A));\nconsole.log('inv(A) =', math.format(math.inv(A)));\n// Transpose flips rows and columns.\nconsole.log('transpose(A) =', math.format(math.transpose(A)));\n\n// Eigenvalues\n// This matrix is symmetric (it equals its own transpose), which guarantees real\n// eigenvalues. An eigenvalue is the factor by which its eigenvector is stretched\n// when the matrix is applied - the directions the transform leaves unrotated.\nconst sym = math.matrix([[4, -2], [-2, 3]]);\nconst eig = math.eigs(sym);\nconsole.log('\\nEigenvalues of [[4,-2],[-2,3]]:', math.format(eig.values));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "matrix-operations",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Matrix operations"
    },
    {
      "id": "jsds-7",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: statistics-functions-in-mathjs\n//@ description: Statistics functions in mathjs\nconst { create, all } = require('mathjs');\nconst math = create(all);\n\n// Statistics functions in mathjs\n// mathjs overlaps with simple-statistics here. Reach for mathjs when you are\n// already using its matrices or units, and for simple-statistics when you want\n// regressions and hypothesis tests.\nconsole.log('=== mathjs Statistics ===');\n\nconst data = [2, 4, 4, 4, 5, 5, 7, 9];\nconsole.log('Data:', data);\nconsole.log('Mean:', math.mean(data));\nconsole.log('Median:', math.median(data));\n// mathjs std() defaults to the SAMPLE standard deviation (dividing by n-1), the\n// right choice when the data is a sample from a larger population.\nconsole.log('Std (sample):', math.std(data).toFixed(4));\nconsole.log('Variance:', math.variance(data).toFixed(4));\n// Median absolute deviation: a spread measure built on medians, so a single wild\n// outlier barely moves it, unlike the standard deviation.\nconsole.log('Mad (mean abs dev):', math.mad(data).toFixed(4));\n\n// Number formatting\nconsole.log('\\n=== Number Formatting ===');\n// Engineering notation keeps the exponent a multiple of 3, matching SI prefixes.\nconsole.log(math.format(1.23456789e-7, { notation: 'engineering' }));\n// 'fixed' with precision 0 means no decimal places at all.\nconsole.log(math.format(1234567, { notation: 'fixed', precision: 0 }));\n// A bare number as the second argument means \"this many significant digits\".\nconsole.log(math.format(math.pi, 10));",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "statistics-functions-in-mathjs",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "Statistics functions in mathjs"
    },
    {
