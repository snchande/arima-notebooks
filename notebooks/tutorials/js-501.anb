    {
      "id": "jsc-bar",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: bar-chart-monthly-revenue\n//@ description: ── BAR CHART — Monthly Revenue ──────────────────────────────────────────\n// --- BAR CHART - Monthly Revenue ---\nconst d3 = require('d3');\n\nconst data = [\n  {m:'Jan',v:42},{m:'Feb',v:38},{m:'Mar',v:51},{m:'Apr',v:47},\n  {m:'May',v:63},{m:'Jun',v:58},{m:'Jul',v:71},{m:'Aug',v:68},\n  {m:'Sep',v:55},{m:'Oct',v:72},{m:'Nov',v:65},{m:'Dec',v:80}\n];\n\n// The \"margin convention\": declare the outer canvas, subtract space for axis\n// labels and the title, and draw everything inside the remaining inner box. The\n// <g transform='translate(ml,mt)'> further down shifts the origin into that box,\n// so all plotting maths can pretend the chart starts at (0,0).\nconst W=680, H=340, ml=55, mt=42, mr=20, mb=45;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\n// A SCALE maps data values (the domain) to pixel positions (the range).\n// scaleBand is the categorical one: it slices the width into equal bands, one per\n// month, and reserves 30% of each slot as padding between bars.\nconst x = d3.scaleBand().domain(data.map(d=>d.m)).range([0,iw]).padding(0.3);\n// scaleLinear is continuous. The range is [ih, 0] - inverted on purpose, because\n// SVG y grows DOWNWARD, so the largest value must map to the smallest y.\n// The *1.15 leaves headroom above the tallest bar for its value label; .nice()\n// rounds the domain out to friendly tick boundaries.\nconst y = d3.scaleLinear().domain([0, d3.max(data,d=>d.v)*1.15]).range([ih,0]).nice();\nconst maxV = d3.max(data,d=>d.v);\n// y.ticks(5) asks for about five evenly spaced, human-readable values - it may\n// return four or six, whichever divides the domain more cleanly.\nconst yTicks = y.ticks(5);\n\n// Horizontal gridlines: one <line> per tick, drawn at that tick's y position.\n// .join('') collapses the array into a single string of SVG markup.\nconst grid = yTicks.map(t=>\n  `<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`\n).join('');\n\nconst bars = data.map(d=>{\n  // t is the value normalised to 0..1, used to shift hue, saturation and\n  // lightness together so taller bars read as hotter. Encoding one variable\n  // twice (height and colour) is fine; encoding two different variables in\n  // height and colour would be the thing to avoid.\n  const t = d.v/maxV;\n  const hue  = (260+t*40).toFixed(0);\n  const sat  = (58+t*22).toFixed(0);\n  const lit  = (44+t*16).toFixed(0);\n  const bx   = x(d.m).toFixed(1);           // left edge of this month's band\n  const bw   = x.bandwidth().toFixed(1);    // band width minus the padding\n  // An SVG rect is positioned by its TOP-left corner, so the height is measured\n  // from the value's y down to the baseline, and y itself is the value's y.\n  const bh   = (ih-y(d.v)).toFixed(1);\n  const by   = y(d.v).toFixed(1);\n  const mid  = (x(d.m)+x.bandwidth()/2).toFixed(1);\n  return `<rect x='${bx}' y='${by}' width='${bw}' height='${bh}' fill='hsl(${hue},${sat}%,${lit}%)' rx='3'/>`\n       // -5 lifts the label just clear of the bar's top edge.\n       + `<text x='${mid}' y='${(y(d.v)-5).toFixed(1)}' text-anchor='middle' font-size='10' fill='${TXT}'>${d.v}k</text>`;\n}).join('');\n\n// Axis labels are just text elements; text-anchor controls which part of the\n// string sits at the given x - 'middle' to centre under a bar, 'end' to\n// right-align the y labels against the axis.\nconst xLbls = data.map(d=>\n  `<text x='${(x(d.m)+x.bandwidth()/2).toFixed(1)}' y='${ih+15}' text-anchor='middle' font-size='11' fill='${TXT}'>${d.m}</text>`\n).join('');\nconst yLbls = yTicks.map(t=>\n  `<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${t}k</text>`\n).join('');\n\n// barista.html() renders raw markup inline in the notebook output. Everything\n// above was string building; this is the only line that produces a visible chart.\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${W/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Monthly Revenue 2024 — Bar Chart</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${bars}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${xLbls}${yLbls}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-42,${(ih/2).toFixed(0)}) rotate(-90)'>Revenue ($K)</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "bar-chart-monthly-revenue",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── BAR CHART — Monthly Revenue ──────────────────────────────────────────"
    },
    {
      "id": "jsc-line",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: line-chart-multi-series-stock-perfo\n//@ description: ── LINE CHART — Multi-series Stock Performance ───────────────────────────\n// --- LINE CHART - Multi-series Stock Performance ---\nconst d3 = require('d3');\n\nconst months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n// Carrying the colour with the data keeps a series and its legend swatch in sync\n// even if the array is later reordered.\nconst series = [\n  { name:'BaristaAI',   color:'#7c3aed', vals:[142,156,148,171,163,182,195,188,201,215,208,234] },\n  { name:'CloudSys',  color:'#06b6d4', vals:[98,102,115,109,121,128,135,142,138,151,159,168] },\n  { name:'DataFlow',  color:'#10b981', vals:[67,74,71,83,79,88,92,86,95,102,98,115] }\n];\n\n// mr is much larger here than in the bar chart because the legend lives in that\n// right-hand margin rather than on top of the plot.\nconst W=680, H=340, ml=55, mt=42, mr=115, mb=45;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\n// flatMap flattens one level, giving a single array of every value across all\n// three series - needed so that one shared y scale covers them all. Separate\n// scales per series would make the lines visually incomparable.\nconst allV = series.flatMap(s=>s.vals);\nconst x = d3.scaleLinear().domain([0,11]).range([0,iw]);   // 12 months, indexed 0..11\n// Starting the domain at 88% of the minimum rather than at 0 zooms in on the\n// variation. Legitimate for stock prices, where relative change is the story;\n// misleading for bar charts, where bar length is read as magnitude.\nconst y = d3.scaleLinear().domain([d3.min(allV)*0.88, d3.max(allV)*1.05]).range([ih,0]).nice();\n// A line generator turns an array of values into an SVG path 'd' string. The x\n// accessor ignores the value and uses the array index; curveMonotoneX smooths\n// the line without inventing local peaks the data does not contain.\nconst lineGen = d3.line().x((_,i)=>x(i)).y(v=>y(v)).curve(d3.curveMonotoneX);\nconst yTicks = y.ticks(5);\n\nconst grid = yTicks.map(t=>\n  `<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`\n).join('');\n\nconst lines = series.map(s=>{\n  const path = lineGen(s.vals);\n  // Dots mark the actual observations; the smoothed curve between them is\n  // interpolation, so showing the real data points keeps the chart honest.\n  const dots = s.vals.map((v,i)=>`<circle cx='${x(i).toFixed(1)}' cy='${y(v).toFixed(1)}' r='3.5' fill='${s.color}'/>`).join('');\n  // fill='none' is essential: without it SVG closes the path and floods it.\n  return `<path d='${path}' fill='none' stroke='${s.color}' stroke-width='2.5'/>${dots}`;\n}).join('');\n\nconst xLbls = months.map((m,i)=>\n  `<text x='${x(i).toFixed(1)}' y='${ih+15}' text-anchor='middle' font-size='10' fill='${TXT}'>${m}</text>`\n).join('');\nconst yLbls = yTicks.map(t=>\n  `<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${t}</text>`\n).join('');\n// The legend sits at iw+12, i.e. just past the right edge of the plot area and\n// inside the margin we reserved for it. i*24 stacks the entries.\nconst legend = series.map((s,i)=>\n  `<rect x='${iw+12}' y='${i*24}' width='14' height='14' fill='${s.color}' rx='3'/>`\n+ `<text x='${iw+30}' y='${i*24+11}' font-size='12' fill='${TXT}'>${s.name}</text>`\n).join('');\n\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${(W-100)/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Stock Performance 2024 — Line Chart</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${lines}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${xLbls}${yLbls}${legend}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-42,${(ih/2).toFixed(0)}) rotate(-90)'>Price ($)</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "line-chart-multi-series-stock-perfo",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── LINE CHART — Multi-series Stock Performance ───────────────────────────"
    },
    {
      "id": "jsc-scatter",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: scatter-plot-correlation-linear-r\n//@ description: ── SCATTER PLOT — Correlation + Linear Regression ───────────────────────\n// --- SCATTER PLOT - Correlation + Linear Regression ---\nconst d3 = require('d3');\n\n// Seeded pseudo-random (reproducible)\n// Math.random() cannot be seeded, so the chart would look different on every run\n// and no two readers would see the same picture. This is a linear congruential\n// generator: good enough for a demo, never for anything security-related.\nlet _s = 42;\n// >>> 0 forces the signed 32-bit result back into an unsigned range before\n// dividing by 2^32 to land in [0, 1).\nconst rng = () => { _s = (_s*1664525+1013904223)&0xffffffff; return (_s>>>0)/4294967296; };\n// Box-Muller transform: two uniform randoms in, one standard-normal value out.\n// Declared here for symmetry with the other cells; this chart uses rng directly.\nconst gauss = () => Math.sqrt(-2*Math.log(rng()+1e-9))*Math.cos(2*Math.PI*rng());\n\n// Two clusters with overlapping but shifted centres, so the groups are visibly\n// different without being separable - realistic for height/weight data.\nconst groupA = Array.from({length:45}, ()=>({ x:155+rng()*30, y:52+rng()*25, g:'A' }));\nconst groupB = Array.from({length:45}, ()=>({ x:162+rng()*30, y:62+rng()*30, g:'B' }));\nconst data   = [...groupA, ...groupB];\n\nconst W=680, H=360, ml=60, mt=42, mr=125, mb=50;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\n// Both axes are continuous here, so both use scaleLinear. The -2/+2 padding stops\n// points from being clipped by the axis lines.\nconst x = d3.scaleLinear().domain([d3.min(data,d=>d.x)-2, d3.max(data,d=>d.x)+2]).range([0,iw]).nice();\nconst y = d3.scaleLinear().domain([d3.min(data,d=>d.y)-2, d3.max(data,d=>d.y)+2]).range([ih,0]).nice();\n\n// Least-squares regression\n// The closed-form solution: slope = covariance(x,y) / variance(x), computed here\n// as sums of deviations from each mean.\nconst n=data.length, mx=d3.mean(data,d=>d.x), my=d3.mean(data,d=>d.y);\nconst slope = data.reduce((s,d)=>s+(d.x-mx)*(d.y-my),0) / data.reduce((s,d)=>s+(d.x-mx)**2,0);\n// The fitted line always passes through the point (mean x, mean y), which is\n// what fixes the intercept once the slope is known.\nconst intercept = my - slope*mx;\n// Draw the line across the full domain by evaluating it at both ends.\nconst [rx0,rx1] = x.domain();\nconst regLine = `<line x1='${x(rx0).toFixed(1)}' y1='${y(intercept+slope*rx0).toFixed(1)}'\n  x2='${x(rx1).toFixed(1)}' y2='${y(intercept+slope*rx1).toFixed(1)}'\n  stroke='#f59e0b' stroke-width='2' stroke-dasharray='6,3'/>`;\n\n// R-squared\n// ssTot is the variation around the mean; ssRes is what the line fails to\n// explain. R-squared = 1 - ssRes/ssTot, so 1.0 is a perfect fit and 0 means the\n// line is no better than just predicting the mean.\nconst ssTot = data.reduce((s,d)=>s+(d.y-my)**2,0);\nconst ssRes = data.reduce((s,d)=>s+(d.y-(intercept+slope*d.x))**2,0);\nconst r2 = (1-ssRes/ssTot).toFixed(3);\n\nconst COLS = {A:'#7c3aed', B:'#06b6d4'};\n// fill-opacity below 1 matters on a scatter plot: overlapping points darken, so\n// dense regions become visible instead of being hidden behind one another.\nconst dots = data.map(d=>\n  `<circle cx='${x(d.x).toFixed(1)}' cy='${y(d.y).toFixed(1)}' r='4.5' fill='${COLS[d.g]}' fill-opacity='0.72'/>`\n).join('');\n\nconst yTicks = y.ticks(5), xTicks = x.ticks(5);\nconst grid = yTicks.map(t=>`<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`).join('');\nconst xLbls = xTicks.map(t=>`<text x='${x(t).toFixed(1)}' y='${ih+15}' text-anchor='middle' font-size='11' fill='${TXT}'>${t.toFixed(0)}</text>`).join('');\nconst yLbls = yTicks.map(t=>`<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${t.toFixed(0)}</text>`).join('');\n\n// The legend doubles as a stats panel: swatches, the trend key, then R-squared and the\n// slope, so a reader can interpret the line without leaving the graphic.\nconst legend =\n  `<circle cx='${iw+18}' cy='6'  r='6' fill='${COLS.A}' fill-opacity='0.8'/><text x='${iw+30}' y='11' font-size='12' fill='${TXT}'>Group A</text>`\n+ `<circle cx='${iw+18}' cy='28' r='6' fill='${COLS.B}' fill-opacity='0.8'/><text x='${iw+30}' y='33' font-size='12' fill='${TXT}'>Group B</text>`\n+ `<line x1='${iw+10}' y1='52' x2='${iw+26}' y2='52' stroke='#f59e0b' stroke-width='2' stroke-dasharray='5,2'/><text x='${iw+30}' y='56' font-size='12' fill='${TXT}'>Trend</text>`\n+ `<text x='${iw+10}' y='76' font-size='11' fill='${TXT}'>R²=${r2}</text>`\n+ `<text x='${iw+10}' y='93' font-size='11' fill='${TXT}'>m=${slope.toFixed(2)}</text>`;\n\n// Draw order is paint order in SVG: grid, then the regression line, then the\n// dots on top so no observation is hidden behind the trend line.\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${(W-110)/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Height vs Weight — Scatter Plot + Regression</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${regLine}${dots}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${xLbls}${yLbls}${legend}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-44,${(ih/2).toFixed(0)}) rotate(-90)'>Weight (kg)</text>\n    <text x='${iw/2}' y='${ih+38}' text-anchor='middle' font-size='11' fill='${TXT}'>Height (cm)</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "scatter-plot-correlation-linear-r",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── SCATTER PLOT — Correlation + Linear Regression ───────────────────────"
    },
    {
      "id": "jsc-histogram",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: histogram-normal-distribution-with\n//@ description: ── HISTOGRAM — Normal Distribution with Bell Curve ─────────────────────\n// --- HISTOGRAM - Normal Distribution with Bell Curve ---\nconst d3 = require('d3');\n\n// Same seeded generator as the scatter cell, with a different seed so the two\n// charts do not share a sequence.\nlet _s = 99;\nconst rng = () => { _s=(_s*1664525+1013904223)&0xffffffff; return (_s>>>0)/4294967296; };\n// Box-Muller: converts two uniform randoms into one standard normal value\n// (mean 0, sd 1). The +1e-9 avoids log(0), which would be -Infinity.\nconst gauss = () => Math.sqrt(-2*Math.log(rng()+1e-9))*Math.cos(2*Math.PI*rng());\n\n// mu shifts the centre, sigma scales the spread: MU + gauss()*SIGMA turns a\n// standard normal into a normal with these parameters.\nconst MU=170, SIGMA=10;\nconst raw = Array.from({length:500}, ()=>MU+gauss()*SIGMA);\n\nconst W=680, H=350, ml=58, mt=42, mr=22, mb=50;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\nconst x = d3.scaleLinear().domain([d3.min(raw)-2, d3.max(raw)+2]).range([0,iw]).nice();\n// d3.bin() builds a binning function; calling it with the data returns an array\n// of bins, each an array of its members carrying .x0 and .x1 edges. Bin count is\n// the one real choice in a histogram: too few hides structure, too many turns\n// the chart into noise.\nconst bins = d3.bin().domain(x.domain()).thresholds(x.ticks(28))(raw);\n// The y axis counts observations, so its domain runs from 0 to the fullest bin.\nconst y = d3.scaleLinear().domain([0, d3.max(bins,b=>b.length)]).range([ih,0]).nice();\n\nconst yTicks = y.ticks(5), xTicks = x.ticks(6);\nconst grid = yTicks.map(t=>`<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`).join('');\nconst yLbls = yTicks.map(t=>`<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${t}</text>`).join('');\nconst xLbls = xTicks.map(t=>`<text x='${x(t).toFixed(1)}' y='${ih+15}' text-anchor='middle' font-size='11' fill='${TXT}'>${t.toFixed(0)}</text>`).join('');\n\nconst bars = bins.map(b=>{\n  // Histogram bars are positioned by their bin EDGES, not by a band scale - that\n  // is the structural difference from a bar chart, and it is why the bars touch.\n  const bx = x(b.x0).toFixed(1);\n  // The -1 leaves a hairline gap; Math.max(0, ...) guards against a negative\n  // width if a bin is narrower than that gap.\n  const bw = Math.max(0, x(b.x1)-x(b.x0)-1).toFixed(1);\n  const by = y(b.length).toFixed(1);\n  const bh = (ih-y(b.length)).toFixed(1);\n  const mid = (b.x0+b.x1)/2;\n  // Colour by distance from the mean in standard deviations, so the 1-sigma\n  // core, the 1-2 sigma shoulders and the tails are visually separated.\n  const z   = Math.abs(mid-MU)/SIGMA;\n  const col = z<1 ? '#7c3aed' : z<2 ? '#9b59b6' : '#5a3a8a';\n  return `<rect x='${bx}' y='${by}' width='${bw}' height='${bh}' fill='${col}' fill-opacity='0.82' rx='1'/>`;\n}).join('');\n\n// Bell curve overlay\n// The normal probability density integrates to 1, whereas the bars are counts.\n// Multiplying the density by (sample size * bin width) rescales it onto the same\n// axis - without that factor the curve would be a flat line at zero.\nconst binW = bins.length>0 ? (bins[0].x1-bins[0].x0) : 1;\n// 120 sample points across the domain, rendered as a polyline. More points give\n// a smoother curve; this is plenty at chart resolution.\nconst bellPts = Array.from({length:120},(_,i)=>{\n  const xv = x.domain()[0] + (x.domain()[1]-x.domain()[0])*(i/119);\n  const density = Math.exp(-0.5*((xv-MU)/SIGMA)**2) / (SIGMA*Math.sqrt(2*Math.PI));\n  return `${x(xv).toFixed(1)},${y(density*raw.length*binW).toFixed(1)}`;\n}).join(' ');\nconst bell = `<polyline points='${bellPts}' fill='none' stroke='#f59e0b' stroke-width='2.5'/>`;\n\n// Annotation lines\n// The empirical rule: about 68% of a normal distribution falls within 1 sigma of\n// the mean and about 95% within 2. Marking those boundaries lets a reader check\n// that claim against the bars.\nconst mx = x(MU).toFixed(1);\nconst s1a = x(MU-SIGMA).toFixed(1), s1b = x(MU+SIGMA).toFixed(1);\nconst s2a = x(MU-2*SIGMA).toFixed(1), s2b = x(MU+2*SIGMA).toFixed(1);\n// parseFloat is needed because toFixed already turned these into strings, and\n// '170.5' + 4 would concatenate rather than add.\nconst annot =\n  `<line x1='${mx}' y1='0' x2='${mx}' y2='${ih}' stroke='#ef4444' stroke-width='1.5' stroke-dasharray='5,3'/>`\n+ `<text x='${parseFloat(mx)+4}' y='13' font-size='10' fill='#ef4444'>μ=${MU}</text>`\n+ `<line x1='${s1a}' y1='0' x2='${s1a}' y2='${ih}' stroke='#10b981' stroke-width='1' stroke-dasharray='4,3'/>`\n+ `<line x1='${s1b}' y1='0' x2='${s1b}' y2='${ih}' stroke='#10b981' stroke-width='1' stroke-dasharray='4,3'/>`\n+ `<text x='${parseFloat(s1b)+4}' y='26' font-size='10' fill='#10b981'>±1σ</text>`\n+ `<line x1='${s2a}' y1='0' x2='${s2a}' y2='${ih}' stroke='#3a7a5a' stroke-width='1' stroke-dasharray='3,4'/>`\n+ `<line x1='${s2b}' y1='0' x2='${s2b}' y2='${ih}' stroke='#3a7a5a' stroke-width='1' stroke-dasharray='3,4'/>`\n+ `<text x='${parseFloat(s2b)+4}' y='40' font-size='10' fill='#3a7a5a'>±2σ</text>`;\n\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${W/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Height Distribution (N=500) — Histogram + Bell Curve</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${bars}${bell}${annot}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${xLbls}${yLbls}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-44,${(ih/2).toFixed(0)}) rotate(-90)'>Count</text>\n    <text x='${iw/2}' y='${ih+38}' text-anchor='middle' font-size='11' fill='${TXT}'>Height (cm)</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "histogram-normal-distribution-with",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── HISTOGRAM — Normal Distribution with Bell Curve ─────────────────────"
    },
    {
      "id": "jsc-donut",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: donut-chart-market-share\n//@ description: ── DONUT CHART — Market Share ────────────────────────────────────────────\n// --- DONUT CHART - Market Share ---\nconst d3 = require('d3');\n\n// Parts of a whole, summing to 100. A donut is only honest when the categories\n// are mutually exclusive and exhaustive - hence the \"Others\" bucket.\nconst data = [\n  {label:'BaristaAI',  value:34, color:'#7c3aed'},\n  {label:'CloudSys', value:28, color:'#06b6d4'},\n  {label:'DataFlow', value:19, color:'#10b981'},\n  {label:'NetPulse', value:12, color:'#f59e0b'},\n  {label:'Others',   value:7,  color:'#6b7280'}\n];\n\nconst W=680, H=380;\n// The centre is nudged left of the canvas midpoint to leave room for the legend\n// on the right; no margin convention here, since a donut has no axes.\nconst cx=W/2-80, cy=H/2+8;\n// innerR > 0 is exactly what makes this a donut rather than a pie. The hole is\n// useful space for a total, and the resulting arcs are compared by angle rather\n// than by area, which people judge slightly more reliably.\nconst outerR=140, innerR=72;\nconst BG='#13131f', TXT='#8888aa', TTL='#cdd6f4';\n\n// d3.pie() does not draw anything - it converts values into start/end angles in\n// radians. sort(null) preserves the input order; without it D3 sorts descending\n// and the legend would no longer match the slices.\nconst pie = d3.pie().value(d=>d.value).sort(null);\n// d3.arc() is the generator that turns one of those angle objects into a path.\nconst arc = d3.arc().innerRadius(innerR).outerRadius(outerR);\n// A zero-width arc at a larger radius: used only for its centroid, which gives a\n// tidy label position just outside the ring.\nconst labelArc = d3.arc().innerRadius(outerR+22).outerRadius(outerR+22);\nconst hoverArc = d3.arc().innerRadius(innerR).outerRadius(outerR+6);\n\nconst arcs = pie(data);\nconst slices = arcs.map(a=>{\n  const pathD = arc(a);\n  // centroid returns [x, y] at the middle of the arc, relative to the centre -\n  // which is why the whole group is translated to (cx, cy) below.\n  const [lx,ly] = labelArc.centroid(a);\n  // Recomputing the percentage from the angle rather than the raw value keeps\n  // the label correct even if the inputs did not already sum to 100.\n  const pct = ((a.endAngle-a.startAngle)/(2*Math.PI)*100).toFixed(1);\n  // Slices under 5% get no label - there is no room, and a crowded rim is worse\n  // than a missing number the legend already carries.\n  const lbl = pct>5 ? `<text x='${lx.toFixed(1)}' y='${(ly+4).toFixed(1)}' text-anchor='middle' font-size='11' fill='${TXT}'>${pct}%</text>` : '';\n  // Stroking each slice in the background colour creates the thin separating gap.\n  return `<path d='${pathD}' fill='${a.data.color}' stroke='${BG}' stroke-width='2.5'/>${lbl}`;\n}).join('');\n\n// Vertically centre the legend block: start at half the leftover height, then\n// step 28px per row.\nconst legend = data.map((d,i)=>{\n  const ly = (H-data.length*28)/2 + i*28;\n  return `<rect x='${W-162}' y='${ly}' width='15' height='15' fill='${d.color}' rx='3'/>`\n       + `<text x='${W-143}' y='${ly+12}' font-size='12' fill='${TXT}'>${d.label}</text>`\n       + `<text x='${W-30}'  y='${ly+12}' text-anchor='end' font-size='12' fill='${d.color}' font-weight='600'>${d.value}%</text>`;\n}).join('');\n\n// The slices are wrapped in a <g> translated to the centre, because arc paths are\n// generated around the origin (0,0). The two centre labels are NOT in that group,\n// so they use absolute canvas coordinates.\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${cx}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Market Share — Donut Chart</text>\n  <g transform='translate(${cx},${cy})'>${slices}</g>\n  <text x='${cx}' y='${cy-10}' text-anchor='middle' font-size='22' font-weight='bold' fill='${TTL}'>100%</text>\n  <text x='${cx}' y='${cy+14}' text-anchor='middle' font-size='11' fill='${TXT}'>Market Total</text>\n  ${legend}\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "donut-chart-market-share",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── DONUT CHART — Market Share ────────────────────────────────────────────"
    },
    {
      "id": "jsc-heatmap",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: heatmap-feature-correlation-matrix\n//@ description: ── HEATMAP — Feature Correlation Matrix ─────────────────────────────────\n// --- HEATMAP - Feature Correlation Matrix ---\nconst d3 = require('d3');\n\nconst labels = ['Revenue','Users','Sessions','Conversions','Retention'];\n// A correlation matrix is symmetric (corr(a,b) === corr(b,a)) and has 1.00 down\n// the diagonal, since every feature correlates perfectly with itself. Those two\n// properties are a quick sanity check on any matrix like this.\nconst matrix = [\n  [1.00, 0.87, 0.82, 0.73, 0.65],\n  [0.87, 1.00, 0.91, 0.68, 0.72],\n  [0.82, 0.91, 1.00, 0.74, 0.69],\n  [0.73, 0.68, 0.74, 1.00, 0.81],\n  [0.65, 0.72, 0.69, 0.81, 1.00]\n];\n\nconst n=labels.length;\n// ml and mt are generous because the row and column labels live in those margins.\nconst W=540, H=460, ml=110, mt=90, mr=20, mb=20;\nconst iw=W-ml-mr, ih=H-mt-mb;\n// Cell size is derived from the grid rather than fixed, so the chart adapts if\n// the matrix grows.\nconst cw=iw/n, ch=ih/n;\nconst BG='#13131f', TXT='#8888aa', TTL='#cdd6f4';\n\n// Color: low=cool blue, high=vivid purple\n// scaleSequential maps a continuous domain onto a colour ramp. The domain starts\n// at 0.55 rather than 0 because every value here is above that - stretching the\n// ramp across the ACTUAL range is what makes the differences visible.\nconst colorScale = d3.scaleSequential().domain([0.55,1.0]).interpolator(\n  // The interpolator receives t normalised to 0..1 and returns any CSS colour.\n  t => `hsl(${(260-t*40).toFixed(0)},${(40+t*45).toFixed(0)}%,${(25+t*30).toFixed(0)}%)`\n);\n\n// flatMap over rows, map over columns: i is the row index (y), j the column (x).\n// Getting those the wrong way round transposes the chart - the classic heatmap bug.\nconst cells = matrix.flatMap((row,i)=>row.map((val,j)=>{\n  const color = colorScale(val);\n  // Switch the text colour on dark cells so the number stays readable - contrast\n  // has to be maintained against a background that is itself data-driven.\n  const tc = val>0.78 ? '#e8d8ff' : '#9090b8';\n  const fw = val===1.0 ? 'bold' : 'normal';\n  return `<rect x='${(j*cw).toFixed(1)}' y='${(i*ch).toFixed(1)}' width='${cw.toFixed(1)}' height='${ch.toFixed(1)}' fill='${color}' stroke='${BG}' stroke-width='2.5'/>`\n       // +5 shifts the baseline down by roughly half the cap height, which\n       // optically centres the text in the cell.\n       + `<text x='${(j*cw+cw/2).toFixed(1)}' y='${(i*ch+ch/2+5).toFixed(1)}' text-anchor='middle' font-size='13' font-weight='${fw}' fill='${tc}'>${val.toFixed(2)}</text>`;\n})).join('');\n\nconst rowLbls = labels.map((l,i)=>\n  `<text x='-8' y='${(i*ch+ch/2+5).toFixed(1)}' text-anchor='end' font-size='12' fill='${TXT}'>${l}</text>`\n).join('');\nconst colLbls = labels.map((l,i)=>{\n  const cx2 = (i*cw+cw/2).toFixed(1);\n  // rotate(angle, cx, cy) turns the label about its own anchor point rather than\n  // about the origin - without the two extra arguments it would fly off-canvas.\n  return `<text x='${cx2}' y='-14' text-anchor='middle' font-size='12' fill='${TXT}' transform='rotate(-35,${cx2},-14)'>${l}</text>`;\n}).join('');\n\n// Color legend bar\n// Ten samples of the same colorScale become gradient stops, so the key is\n// guaranteed to match the cells - it is generated from the identical function.\nconst gradStops = Array.from({length:10},(_,k)=>{\n  const t=k/9;\n  const v = 0.55+t*0.45;\n  return `<stop offset='${(t*100).toFixed(0)}%' stop-color='${colorScale(v)}'/>` ;\n}).join('');\n// <defs> holds definitions that are referenced but not drawn where they sit;\n// fill='url(#lg)' is how the rect below points at this gradient.\nconst legend =\n  `<defs><linearGradient id='lg' x1='0' x2='1'>${gradStops}</linearGradient></defs>`\n+ `<rect x='${ml}' y='${H-16}' width='${iw}' height='12' fill='url(#lg)' rx='3'/>`\n+ `<text x='${ml}' y='${H-20}' font-size='10' fill='${TXT}'>0.55</text>`\n+ `<text x='${ml+iw}' y='${H-20}' text-anchor='end' font-size='10' fill='${TXT}'>1.00</text>`;\n\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${W/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Feature Correlation Matrix — Heatmap</text>\n  <g transform='translate(${ml},${mt})'>${cells}${rowLbls}${colLbls}</g>\n  ${legend}\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "heatmap-feature-correlation-matrix",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── HEATMAP — Feature Correlation Matrix ─────────────────────────────────"
    },
    {
      "id": "jsc-boxplot",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: box-plot-a-b-c-test-comparison\n//@ description: ── BOX PLOT — A/B/C Test Comparison ─────────────────────────────────────\n// --- BOX PLOT - A/B/C Test Comparison ---\nconst d3 = require('d3');\n\nlet _s = 77;\nconst rng = () => { _s=(_s*1664525+1013904223)&0xffffffff; return (_s>>>0)/4294967296; };\nconst gauss = () => Math.sqrt(-2*Math.log(rng()+1e-9))*Math.cos(2*Math.PI*rng());\n\n// Note the deliberate design: B has the same rough centre as A but a much wider\n// spread, and C is both higher and tighter. A bar chart of the means would hide\n// exactly that difference, which is the whole argument for a box plot.\nconst groups = [\n  { name:'Control',     color:'#7c3aed', data: Array.from({length:60}, ()=>50+gauss()*8)   },\n  { name:'Treatment A', color:'#06b6d4', data: Array.from({length:60}, ()=>58+gauss()*7)   },\n  { name:'Treatment B', color:'#10b981', data: Array.from({length:60}, ()=>55+gauss()*12)  },\n  { name:'Treatment C', color:'#f59e0b', data: Array.from({length:60}, ()=>63+gauss()*5.5) }\n];\n\nconst W=680, H=360, ml=58, mt=42, mr=22, mb=55;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\nconst allV = groups.flatMap(g=>g.data);\n// scaleBand for the categorical group axis, one shared linear scale for the\n// values so the four boxes are directly comparable.\nconst x = d3.scaleBand().domain(groups.map(g=>g.name)).range([0,iw]).padding(0.35);\nconst y = d3.scaleLinear().domain([d3.min(allV)-3, d3.max(allV)+3]).range([ih,0]).nice();\n\n// Tukey's five-number summary - the entire content of a box plot.\nconst fiveNum = arr => {\n  // quantile needs sorted input. Spread into a copy first: sort() mutates, and\n  // reordering the caller's data would be an invisible side effect.\n  const s = [...arr].sort((a,b)=>a-b);\n  // q1 and q3 bound the middle 50%; the IQR is that width, and it is the ruler\n  // used for the whiskers.\n  const q1=d3.quantile(s,0.25), q3=d3.quantile(s,0.75), iqr=q3-q1;\n  return {\n    q1, q2:d3.quantile(s,0.50), q3, iqr,   // q2 is the median\n    // Whiskers reach 1.5 IQR beyond the quartiles, but stop at the last real\n    // data point - they never extend past values that actually exist.\n    lo: Math.max(s[0], q1-1.5*iqr),\n    hi: Math.min(s[s.length-1], q3+1.5*iqr),\n    // Anything past the 1.5 IQR fence is plotted individually as an outlier.\n    outliers: s.filter(v=>v<q1-1.5*iqr||v>q3+1.5*iqr)\n  };\n};\n\nconst yTicks = y.ticks(6);\nconst grid = yTicks.map(t=>`<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`).join('');\nconst yLbls = yTicks.map(t=>`<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${t.toFixed(0)}</text>`).join('');\n\nconst boxes = groups.map(g=>{\n  const st = fiveNum(g.data);\n  const bx=x(g.name), bw=x.bandwidth(), mid=bx+bw/2;\n  // Remember the inverted y scale: q3 (the larger value) has the SMALLER pixel y,\n  // so it is the top of the box.\n  const [qTop,qBot] = [y(st.q3),y(st.q1)];\n  const [hiY,loY,medY] = [y(st.hi),y(st.lo),y(st.q2)];\n  // Hollow circles distinguish outliers from the solid box marks.\n  const outlierDots = st.outliers.map(v=>`<circle cx='${mid.toFixed(1)}' cy='${y(v).toFixed(1)}' r='3.5' fill='none' stroke='${g.color}' stroke-width='1.5'/>`).join('');\n  return [\n    // The box itself spans q1 to q3 - the middle half of the data.\n    `<rect x='${bx.toFixed(1)}' y='${qTop.toFixed(1)}' width='${bw.toFixed(1)}' height='${(qBot-qTop).toFixed(1)}' fill='${g.color}' fill-opacity='0.28' stroke='${g.color}' stroke-width='2' rx='3'/>`,\n    // The median line, drawn thicker because it is the headline number.\n    `<line x1='${bx.toFixed(1)}' y1='${medY.toFixed(1)}' x2='${(bx+bw).toFixed(1)}' y2='${medY.toFixed(1)}' stroke='${g.color}' stroke-width='2.8'/>`,\n    // Upper and lower whiskers, drawn from the box edges to the fences.\n    `<line x1='${mid.toFixed(1)}' y1='${qTop.toFixed(1)}' x2='${mid.toFixed(1)}' y2='${hiY.toFixed(1)}' stroke='${g.color}' stroke-width='1.5' stroke-dasharray='4,2'/>`,\n    `<line x1='${mid.toFixed(1)}' y1='${qBot.toFixed(1)}' x2='${mid.toFixed(1)}' y2='${loY.toFixed(1)}' stroke='${g.color}' stroke-width='1.5' stroke-dasharray='4,2'/>`,\n    // The short caps that terminate each whisker.\n    `<line x1='${(mid-9).toFixed(1)}' y1='${hiY.toFixed(1)}' x2='${(mid+9).toFixed(1)}' y2='${hiY.toFixed(1)}' stroke='${g.color}' stroke-width='2'/>`,\n    `<line x1='${(mid-9).toFixed(1)}' y1='${loY.toFixed(1)}' x2='${(mid+9).toFixed(1)}' y2='${loY.toFixed(1)}' stroke='${g.color}' stroke-width='2'/>`,\n    outlierDots,\n    // Group name and median printed under each box, so the axis needs no legend.\n    `<text x='${mid.toFixed(1)}' y='${ih+18}' text-anchor='middle' font-size='11' fill='${TXT}'>${g.name}</text>`,\n    `<text x='${mid.toFixed(1)}' y='${ih+33}' text-anchor='middle' font-size='10' fill='${g.color}'>med=${st.q2.toFixed(1)}</text>`\n  ].join('');\n}).join('');\n\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${W/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>A/B/C Test Results — Box Plot</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${boxes}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${yLbls}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-44,${(ih/2).toFixed(0)}) rotate(-90)'>Score</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "box-plot-a-b-c-test-comparison",
      "dependsOn": [],
      "pipelineSteps": [],
      "description": "── BOX PLOT — A/B/C Test Comparison ─────────────────────────────────────"
    },
    {
      "id": "jsc-area",
      "type": "CODE",
      "mode": "nodejs",
      "source": "//@ anchor: area-chart-multi-channel-website-tr\n//@ description: ── AREA CHART — Multi-channel Website Traffic ────────────────────────────\n// --- AREA CHART - Multi-channel Website Traffic ---\nconst d3 = require('d3');\n\nlet _s = 55;\nconst rng = () => { _s=(_s*1664525+1013904223)&0xffffffff; return (_s>>>0)/4294967296; };\n\n// Each series is a rising trend (i * slope) plus centred noise, so the charts\n// show a believable growth pattern instead of pure randomness.\nconst N=30;\nconst days=Array.from({length:N},(_,i)=>i);\nconst organic = days.map(i=>Math.round(1200+i*15+(rng()-0.5)*220));\nconst paid    = days.map(i=>Math.round(800 +i*10+(rng()-0.5)*160));\nconst direct  = days.map(i=>Math.round(500 +i*5 +(rng()-0.5)*110));\n\nconst W=680, H=340, ml=60, mt=42, mr=120, mb=45;\nconst iw=W-ml-mr, ih=H-mt-mb;\nconst BG='#13131f', GRID='#252540', TXT='#8888aa', TTL='#cdd6f4';\n\nconst allV=[...organic,...paid,...direct];\nconst x = d3.scaleLinear().domain([0,N-1]).range([0,iw]);\n// An area chart is read by the size of the filled region, so unlike the line\n// chart earlier the domain MUST start at 0 - a clipped baseline would distort\n// the very quantity the fill is encoding.\nconst y = d3.scaleLinear().domain([0, d3.max(allV)*1.1]).range([ih,0]).nice();\n\n// d3.area() needs two y accessors: y0 is the baseline and y1 the top edge. These\n// are overlaid (all starting from zero), not stacked, so the areas can overlap\n// and the fill opacity below is what keeps them all readable.\nconst areaFn = vals => d3.area().x((_,i)=>x(i)).y0(y(0)).y1(v=>y(v)).curve(d3.curveMonotoneX)(vals);\n// The matching line generator redraws the top edge as a crisp stroke, since a\n// translucent fill alone has a soft, hard-to-follow boundary.\nconst lineFn  = vals => d3.line().x((_,i)=>x(i)).y(v=>y(v)).curve(d3.curveMonotoneX)(vals);\n\nconst layers = [\n  { vals:organic, color:'#7c3aed', name:'Organic' },\n  { vals:paid,    color:'#06b6d4', name:'Paid'    },\n  { vals:direct,  color:'#10b981', name:'Direct'  }\n];\n\n// Largest series first so the smaller ones are painted on top of it.\nconst areas = layers.map(l=>\n  `<path d='${areaFn(l.vals)}' fill='${l.color}' fill-opacity='0.2'/>`\n+ `<path d='${lineFn(l.vals)}' fill='none' stroke='${l.color}' stroke-width='2.5'/>`\n).join('');\n\n// Hand-picked ticks rather than x.ticks(): 30 daily labels would collide, so\n// only every fifth day plus the final one is labelled.\nconst xTicks=[0,5,10,15,20,25,29];\nconst yTicks=y.ticks(5);\nconst grid = yTicks.map(t=>`<line x1='0' y1='${y(t).toFixed(1)}' x2='${iw}' y2='${y(t).toFixed(1)}' stroke='${GRID}' stroke-dasharray='3,3'/>`).join('');\n// Dividing by 1000 and appending 'k' keeps the axis narrow and easy to scan.\nconst yLbls = yTicks.map(t=>`<text x='-8' y='${(y(t)+4).toFixed(1)}' text-anchor='end' font-size='11' fill='${TXT}'>${(t/1000).toFixed(1)}k</text>`).join('');\n// t+1 because the data is indexed from 0 but humans count days from 1.\nconst xLbls = xTicks.map(t=>`<text x='${x(t).toFixed(1)}' y='${ih+15}' text-anchor='middle' font-size='11' fill='${TXT}'>Day ${t+1}</text>`).join('');\n\nconst legend = layers.map((l,i)=>\n  `<rect x='${iw+10}' y='${i*24}' width='14' height='14' fill='${l.color}' rx='3' fill-opacity='0.85'/>`\n+ `<text x='${iw+28}' y='${i*24+11}' font-size='12' fill='${TXT}'>${l.name}</text>`\n).join('');\n\n// End-of-period summary\n// Percentage change from first day to last, printed beneath each legend entry so\n// the trend is stated numerically as well as drawn.\nconst summary = layers.map((l,i)=>{\n  const last=l.vals[N-1], first=l.vals[0];\n  const pct=((last-first)/first*100).toFixed(0);\n  // pct is a STRING from toFixed, so `pct>0` relies on JavaScript coercing it\n  // back to a number for the comparison - which works, but is exactly the kind\n  // of implicit conversion worth being deliberate about.\n  const sign=pct>0?'+':'';\n  return `<text x='${iw+28}' y='${i*24+24}' font-size='10' fill='${pct>0?\"#10b981\":\"#ef4444\"}'>${sign}${pct}% </text>`;\n}).join('');\n\nbarista.html(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' style='background:${BG};border-radius:10px;font-family:system-ui,sans-serif'>\n  <text x='${(W-120)/2}' y='27' text-anchor='middle' font-size='14' font-weight='bold' fill='${TTL}'>Website Traffic by Channel — Area Chart</text>\n  <g transform='translate(${ml},${mt})'>\n    ${grid}${areas}\n    <line x1='0' y1='${ih}' x2='${iw}' y2='${ih}' stroke='#3a3a6a'/>\n    <line x1='0' y1='0' x2='0' y2='${ih}' stroke='#3a3a6a'/>\n    ${xLbls}${yLbls}${legend}${summary}\n    <text text-anchor='middle' fill='${TXT}' font-size='11' transform='translate(-46,${(ih/2).toFixed(0)}) rotate(-90)'>Sessions</text>\n  </g>\n</svg>`);",
      "output": "",
      "returnValue": null,
