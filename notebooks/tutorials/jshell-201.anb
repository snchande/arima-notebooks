    {
      "id": "jshell-201-arraylist",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: array-list\n//@ description: ArrayList\nimport java.util.ArrayList;\nimport java.util.Collections;\n\n// --- ArrayList ---\n// A list backed by an array that grows as needed. Reach for it whenever you would\n// want an array but do not know the size up front.\n// The type in <> must be a CLASS: ArrayList<Integer>, never ArrayList<int>.\n\n// The empty <> on the right is the \"diamond\": Java infers String from the left side.\nArrayList<String> fruits = new ArrayList<>();\n\n// add() appends to the end and grows the list automatically.\nfruits.add(\"Apple\");\nfruits.add(\"Banana\");\nfruits.add(\"Cherry\");\nfruits.add(\"Mango\");\n// The two-argument form INSERTS at that index, shifting everything after it right.\nfruits.add(1, \"Avocado\");\n\n// ArrayList has a real toString(), so printing one shows its contents directly.\nSystem.out.println(\"List       : \" + fruits);\nSystem.out.println(\"Size       : \" + fruits.size());     // size() here; length on arrays\nSystem.out.println(\"Get(2)     : \" + fruits.get(2));     // get(i), not [i] - it is a class\nSystem.out.println(\"Contains 'Mango': \" + fruits.contains(\"Mango\"));\nSystem.out.println(\"Index of 'Apple': \" + fruits.indexOf(\"Apple\"));  // -1 when absent\n\n// remove() is overloaded, and the difference matters:\nfruits.remove(\"Banana\");      // a String argument removes by VALUE\nfruits.remove(0);             // an int argument removes by INDEX\nSystem.out.println(\"After removes  : \" + fruits);\n\n// Sorts in place, alphabetically for Strings (their natural order).\nCollections.sort(fruits);\nSystem.out.println(\"Sorted         : \" + fruits);\n\n// The for-each loop reads as \"for each String fruit in fruits\".\nSystem.out.print(\"For-each       : \");\nfor (String fruit : fruits) System.out.print(fruit + \" \");  // print() adds no newline\nSystem.out.println();                                        // so this ends the line",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
