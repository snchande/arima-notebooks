      "id": "jshell-201-arrays",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: arrays\n//@ description: Arrays\n// Arrays.* are static helpers for arrays. Arrays themselves need no import - they\n// are part of the language - but the utility class does.\nimport java.util.Arrays;\n\n// --- Arrays ---\n// An array has a fixed length, chosen when it is created and never changed. Indexes\n// run from 0 to length-1; anything outside that throws ArrayIndexOutOfBoundsException.\n\n// The braces are an array initialiser: Java counts the values and sizes it to 7.\nint[] scores = {88, 42, 95, 67, 73, 55, 91};\n\nSystem.out.println(\"Length     : \" + scores.length);   // a FIELD, not a method - no ()\nSystem.out.println(\"First      : \" + scores[0]);       // indexes start at 0 ...\nSystem.out.println(\"Last       : \" + scores[scores.length - 1]);  // ... so the last is length-1\n\n// sort() rearranges the array IN PLACE and returns nothing - `scores` itself changes.\nArrays.sort(scores);\n// Printing an array directly gives something like \"[I@1b6d3586\" (type and hash),\n// so Arrays.toString() is what you want for a readable list.\nSystem.out.println(\"Sorted     : \" + Arrays.toString(scores));\n\n// copyOfRange(arr, from, to): from is included, to is excluded. Now that the array is\n// sorted, the last three elements are the three highest scores.\nint[] top3 = Arrays.copyOfRange(scores, scores.length - 3, scores.length);\nSystem.out.println(\"Top 3      : \" + Arrays.toString(top3));\n\n// A 2D array is really an array OF arrays, so each row could have a different length.\nint[][] matrix = {\n    {1, 2, 3},\n    {4, 5, 6},\n    {7, 8, 9}\n};\n// Read the indexes left to right: row first, then column within that row.\nSystem.out.println(\"matrix[1][2] = \" + matrix[1][2]);  // 6 (row 1, col 2)",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
