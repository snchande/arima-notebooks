    {
      "id": "jshell-201-hashset",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: hash-set-unique-elements-only\n//@ description: HashSet - unique elements only\nimport java.util.HashSet;\nimport java.util.ArrayList;\nimport java.util.Arrays;\n\n// --- HashSet - unique elements only ---\n// A set holds each value at most once. Adding a duplicate simply does nothing.\n// It is a HashMap under the covers, so contains/add/remove are all O(1) on average.\n\nHashSet<String> visited = new HashSet<>();\n\nString[] urls = {\n    \"https://example.com\",\n    \"https://java.dev\",\n    \"https://example.com\",   // duplicate!\n    \"https://barista.io\",\n    \"https://java.dev\",      // duplicate!\n    \"https://openai.com\"\n};\n\nfor (String url : urls) {\n    // add() returns true if the set CHANGED - i.e. this value was new. That return\n    // value is what makes a set the natural tool for \"have I seen this already?\".\n    boolean added = visited.add(url);\n    System.out.printf(\"  add %-30s -> %s%n\", url, added ? \"OK\" : \"already seen\");\n}\n\nSystem.out.println(\"\\nUnique URLs visited: \" + visited.size());   // 4, not 6\nSystem.out.println(\"Contains java.dev   : \" + visited.contains(\"https://java.dev\"));\n\n// Arrays.asList() wraps an array as a List, and the HashSet constructor copies any\n// collection - a compact way to build a set from literals.\nHashSet<Integer> setA = new HashSet<>(Arrays.asList(1, 2, 3, 4, 5));\nHashSet<Integer> setB = new HashSet<>(Arrays.asList(3, 4, 5, 6, 7));\n\n// Each of the three operations MUTATES the set it is called on, so each line copies\n// setA first and then modifies the copy - leaving setA itself untouched.\nHashSet<Integer> union = new HashSet<>(setA);        union.addAll(setB);     // A or B\nHashSet<Integer> intersection = new HashSet<>(setA); intersection.retainAll(setB); // A and B\nHashSet<Integer> difference = new HashSet<>(setA);   difference.removeAll(setB);   // A not B\n\nSystem.out.println(\"\\nSet A        : \" + setA);\nSystem.out.println(\"Set B        : \" + setB);\nSystem.out.println(\"Union        : \" + union);\nSystem.out.println(\"Intersection : \" + intersection);\nSystem.out.println(\"A - B        : \" + difference);",
      "output": "",
      "returnValue": null,
      "executed": false,
