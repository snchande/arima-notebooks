      "id": "jshell-201-wordfreq",
      "type": "CODE",
      "mode": "jshell",
      "source": "//@ anchor: practical-word-frequency-counter\n//@ description: Practical: Word Frequency Counter\nimport java.util.HashMap;\nimport java.util.Map;\nimport java.util.Arrays;\n\n// --- Practical: Word Frequency Counter ---\n// The classic use of a map: the key is the thing being counted, the value is the tally.\n\nString text = \"the quick brown fox jumps over the lazy dog the fox\";\nString[] words = text.split(\" \");    // split on a space, returning a String[]\n\nHashMap<String, Integer> freq = new HashMap<>();\nfor (String word : words) {\n    // getOrDefault(word, 0) gives the running count, or 0 the first time this word is\n    // seen; + 1 then counts this occurrence and put() stores it back.\n    freq.put(word, freq.getOrDefault(word, 0) + 1);\n}\n\nSystem.out.println(\"Word frequencies:\");\n// A stream pipeline: turn the entries into a stream, order them, then consume them.\nfreq.entrySet()\n    .stream()\n    // comparingByValue() orders lowest first, so .reversed() puts the commonest on top.\n    // The explicit <String, Integer> is needed here to help type inference along.\n    .sorted(Map.Entry.<String, Integer>comparingByValue().reversed())\n    // forEach takes a lambda: e is one entry, and the body runs once per entry.\n    .forEach(e -> System.out.printf(\"  %-10s : %d%n\", e.getKey(), e.getValue()));\n\n// size() counts the KEYS - i.e. the distinct words - while words.length counts every\n// occurrence, which is why the two numbers differ.\nSystem.out.println(\"\\nTotal unique words : \" + freq.size());\nSystem.out.println(\"Total words        : \" + words.length);",
      "output": "",
      "returnValue": null,
      "executed": false,
      "executionCount": null,
      "error": "",
      "anchor": "practical-word-frequency-counter",
